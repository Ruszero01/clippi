import { TagItem } from "types.slint";
import { TagPanelTheme } from "theme.slint";

export component SideTagBar inherits Rectangle {
    in property <[TagItem]> sidebar-tags: [];
    in property <bool> dark-mode: false;

    callback toggle-tag-filter(int);
    callback toggle-pin(int);

    property <color> text-1: TagPanelTheme.text-1;

    width: 56px;
    background: transparent;

    for tag[idx] in root.sidebar-tags: Rectangle {
        height: 22px;
        width: 56px;

        y: idx * 24px;

        x: tag.checked ? 0px : 22px;
        animate x { duration: 300ms; easing: ease-in-out; }

        // Fade out unpinned tags when unchecked
        opacity: tag.checked || tag.pinned ? 1 : 0;
        animate opacity { duration: 250ms; easing: ease-out; }

        // Only interactable tags get hover highlight
        property <bool> interactable: tag.checked || tag.pinned;

        row-bg := Rectangle {
            width: 100%;
            height: 100%;
            background: ta.has-hover && interactable ? (dark-mode ? #353638 : #eceef4) : (dark-mode ? #2a2b2e : #f5f6fa);
            border-radius: 4px;
        }

        HorizontalLayout {
            x: 0px;
            height: 22px;
            spacing: 5px;
            alignment: start;

            // Colored bar — short dot when unpinned, full bar when pinned
            Rectangle {
                width: 3px;
                height: tag.pinned ? 16px : 6px;
                y: (22px - self.height) / 2;
                border-radius: 2px;
                background: tag.color;
                animate height { duration: 150ms; easing: ease-in-out; }
            }

            // Tag name
            Text {
                text: tag.name;
                font-size: 11px;
                color: text-1;
                font-weight: 500;
                vertical-alignment: center;
                overflow: clip;
                opacity: tag.checked ? 1 : 0.3;
                animate opacity { duration: 250ms; easing: ease-out; }
            }
        }

        ta := TouchArea {
            width: 100%;
            height: 100%;
            clicked => {
                if interactable {
                    root.toggle-tag-filter(tag.id);
                }
            }
            pointer-event(event) => {
                if interactable && event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                    root.toggle-pin(tag.id);
                }
            }
            mouse-cursor: interactable ? pointer : default;
        }
    }
}
