import { ClipboardEntry } from "types.slint";
import { ClipboardList } from "ClipboardList.slint";
import { SettingsPanel } from "SettingsPanel.slint";
import { EditPanel } from "EditPanel.slint";
import { ContextMenu } from "ContextMenu.slint";
import { Palette } from "std-widgets.slint";

export component App inherits Window {
    icon: @image-url("../assets/LOGO.ico");
    title: "Clippi";
    preferred-width: 320px;
    preferred-height: 480px;
    no-frame: true;
    always-on-top: true;
    background: transparent;
    forward-focus: key-handler;

    // 窗口最小尺寸
    min-width: 320px;
    min-height: 480px;

    in property <[ClipboardEntry]> clipboard-items: [];
    in property <int> item-count: 0;
    in-out property <bool> dark-mode: false;
    in-out property <int> theme-mode: 0;  // 0=system, 1=dark, 2=light

    // 视图切换
    in-out property <string> current-view: "clipboard";
    in-out property <bool> auto-start: false;
    in-out property <bool> auto-hide: false;
    in-out property <bool> pinned: false;
    in-out property <bool> sort-by-created: false;
    in-out property <string> db-path: "";
    in-out property <string> settings-error: "";
    in-out property <int> active-tab: 0;
    in-out property <string> hotkey-display: "";
    in-out property <bool> recording-hotkey: false;
    in-out property <int> position-mode: 0;  // 0=center, 1=follow, 2=remember
    in-out property <string> card-height-mode: "medium";
    in-out property <bool> silent-start: true;
    in-out property <bool> show-source-app: false;
    in-out property <bool> auto-scroll-to-top: false;
    in-out property <bool> copy-as-plain-text: false;
    in-out property <bool> show-original-on-hover: false;
    in-out property <int> scroll-trigger: 0;

    // 右键菜单状态
    in-out property <bool> context-menu-visible: false;
    in-out property <length> context-menu-x: 0px;
    in-out property <length> context-menu-y: 0px;
    in-out property <int> context-menu-item-id: -1;
    in-out property <bool> context-menu-is-color: false;
    in-out property <bool> context-menu-is-hex: false;
    in-out property <bool> context-menu-is-image: false;
    in-out property <bool> context-menu-is-favorite: false;

    // 编辑视图状态
    in property <string> editing-content: "";
    in-out property <int> editing-item-id: -1;
    in-out property <string> editing-item-type: "";

    // 备注编辑状态（转发给 ClipboardList）
    in-out property <int> editing-note-id: -1;
    in-out property <string> editing-note-text: "";

    // 分类筛选
    in-out property <bool> filter-plain-text: false;
    in-out property <bool> filter-rich-text: false;
    in-out property <bool> filter-image: false;
    in-out property <bool> filter-link: false;
    in-out property <bool> filter-color: false;
    in-out property <bool> filter-favorites: false;

    // 双击检测
    in-out property <int> last-clicked-id: -1;
    in-out property <bool> click-pending: false;

    // 警告文字滚动
    property <length> error-scroll: 0;

    callback copy-item(int);
    callback paste-item(int);
    callback clear-all();
    callback move-window(float, float);
    callback close-window();
    callback toggle-auto-start();
    callback toggle-auto-hide();
    callback toggle-pinned();
    callback toggle-sort-by-created();
    callback pick-db-path();
    callback reset-db-path();
    callback resize-window(float, float);
    callback set-hotkey(string);
    callback start-recording-hotkey();
    callback set-theme(int);
    callback set-position-mode(int);
    callback set-card-height-mode(string);
    callback toggle-filter(string);
    callback clear-filters();
    callback search-keyword(string);
    callback toggle-favorites-filter();
    callback toggle-favorite(int);
    callback delete-item(int);
    callback toggle-silent-start();
    callback toggle-show-source-app();
    callback toggle-auto-scroll-to-top();
    callback toggle-copy-as-plain-text();
    callback toggle-show-original-on-hover();
    callback update-note(int, string);
    callback edit-item(int);
    callback save-content(int, string);
    callback show-context-menu(int);
    callback hide-context-menu();
    callback paste-as-rgb(int);
    callback paste-as-hex(int);

    // ========== 主题色板 ==========
    property <color> bg:            dark-mode ? #191a1b : #f2f3f8;
    property <color> surface:       dark-mode ? #232425 : #ffffff;
    property <color> surface-hover: dark-mode ? #303132 : #f4f5fb;
    property <color> surface-press: dark-mode ? #3a3b3c : #ebedf5;
    property <color> text-1:        dark-mode ? #eaebec : #1a1c2e;
    property <color> text-2:        dark-mode ? #919496 : #7c809a;
    property <color> text-3:        dark-mode ? #5f6264 : #b4b9ca;
    property <color> accent:        dark-mode ? #7ecba3 : #6ab890;
    property <color> accent-soft:   dark-mode ? #1a2e24 : #e8f5ee;
    property <color> divider:       dark-mode ? #2b2c2d : #e6e8f0;
    property <color> titlebar-bg:   dark-mode ? #191a1b : #ffffff;
    property <color> btn-hover:     dark-mode ? #2b2c2d : #f0f1f8;
    property <color> danger:        #ff5f57;

    // 同步 Slint 原生组件（滚动条等）的颜色方案
    init => {
        Palette.color-scheme = dark-mode ? ColorScheme.dark : ColorScheme.light;
    }
    changed dark-mode => {
        Palette.color-scheme = dark-mode ? ColorScheme.dark : ColorScheme.light;
    }

    // 双击检测定时器
    double-click-timer := Timer {
        interval: 300ms;
        running: root.click-pending;
        triggered => {
            root.click-pending = false;
            if (root.last-clicked-id >= 0) {
                root.copy-item(root.last-clicked-id);
                root.last-clicked-id = -1;
            }
        }
    }

    key-handler := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.close-window();
                return accept;
            }
            reject
        }

        Rectangle {
            border-radius: 12px;
            background: bg;
            border-width: 1px;
            border-color: dark-mode ? #3a3b3c : #d0d2de;
            clip: true;

        // ========== 缩放手柄 ==========
        // 右边缘
        resize-right := TouchArea {
            x: parent.width - 6px;
            y: 12px;
            width: 6px;
            height: parent.height - 24px;
            mouse-cursor: col-resize;

            moved => {
                if (self.pressed) {
                    root.resize-window((self.mouse-x - self.pressed-x) / 1px, 0);
                }
            }
        }

        // 底边缘
        resize-bottom := TouchArea {
            x: 12px;
            y: parent.height - 6px;
            width: parent.width - 24px;
            height: 6px;
            mouse-cursor: row-resize;

            moved => {
                if (self.pressed) {
                    root.resize-window(0, (self.mouse-y - self.pressed-y) / 1px);
                }
            }
        }

        // 右下角
        resize-corner := TouchArea {
            x: parent.width - 12px;
            y: parent.height - 12px;
            width: 12px;
            height: 12px;
            mouse-cursor: col-resize;

            moved => {
                if (self.pressed) {
                    root.resize-window((self.mouse-x - self.pressed-x) / 1px, (self.mouse-y - self.pressed-y) / 1px);
                }
            }
        }

        // 滚动 Timer
        error-scroll-timer := Timer {
            interval: 50ms;
            running: root.settings-error != "";
            triggered => {
                if (root.settings-error != "") {
                    error-scroll += 1px;
                    if (error-scroll > 500px) {
                        error-scroll = 0px;
                    }
                } else {
                    error-scroll = 0px;
                }
            }
        }

        VerticalLayout {
            spacing: 0px;

            // ========== 标题栏 ==========
            Rectangle {
                height: 38px;
                background: bg;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 4px;
                    spacing: 8px;

                    // 应用名称 + LOGO
                    HorizontalLayout {
                        spacing: 7px;
                        VerticalLayout {
                            alignment: center;

                            Rectangle {
                                width: 20px;
                                height: 20px;

                                Image {
                                    width: 20px;
                                    height: 20px;
                                    source: @image-url("../assets/LOGO_notext.ico");
                                }
                            }
                        }

                        Text {
                            text: "Clippi";
                            font-size: 12px;
                            font-weight: 700;
                            color: text-2;
                            vertical-alignment: center;
                        }
                    }

                    // 中间警告区域（始终占位，保持布局）
                    Rectangle {
                        clip: true;
                        width: 120px;

                        Rectangle {
                            width: 4px;
                        }

                        if (root.settings-error != "") : Text {
                            x: 120px - error-scroll;
                            text: root.settings-error;
                            color: danger;
                            font-size: 10px;
                            vertical-alignment: center;
                        }
                    }

                    // 右侧按钮组
                    HorizontalLayout {
                        spacing: 2px;
                        alignment: end;

                        // 收藏筛选按钮
                        Rectangle {
                            width: 28px;
                            height: 28px;

                            fav-filter-ta := TouchArea {
                                width: parent.width;
                                height: parent.height;
                                clicked => { root.toggle-favorites-filter(); }
                            }

                            Text {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                text: "\u{e630}";
                                font-family: "iconfont";
                                font-size: 15px;
                                color: filter-favorites ? accent : (fav-filter-ta.has-hover ? accent : text-2);
                            }
                        }

                        // 固定按钮（免打扰模式）
                        Rectangle {
                            width: 28px;
                            height: 28px;

                            pin-ta := TouchArea {
                                width: parent.width;
                                height: parent.height;
                                clicked => { root.toggle-pinned(); }
                            }

                            Text {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                text: "\u{e633}";
                                font-family: "iconfont";
                                font-size: 15px;
                                color: pinned ? accent : (pin-ta.has-hover ? accent : text-2);
                                transform-rotation: pinned ? 45deg : 0deg;
                                animate transform-rotation { duration: 200ms; easing: ease-out; }
                            }
                        }

                        // 设置按钮
                        Rectangle {
                            width: 28px;
                            height: 28px;

                            settings-ta := TouchArea {
                                width: parent.width;
                                height: parent.height;
                                clicked => {
                                    root.current-view = "settings";
                                }
                            }

                            Text {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                text: "\u{e6b6}";
                                font-family: "iconfont";
                                font-size: 16px;
                                color: settings-ta.has-hover ? accent : text-2;
                            }
                        }
                    }
                }

                // 拖动区域
                drag-ta := TouchArea {
                    x: 0px;
                    y: 0px;
                    width: parent.width - 92px;
                    height: parent.height;
                    mouse-cursor: grab;

                    moved => {
                        if (self.pressed) {
                            root.move-window((self.mouse-x - self.pressed-x) / 1px, (self.mouse-y - self.pressed-y) / 1px);
                        }
                    }
                }
            }

            // ========== 内容区域 ==========
            Rectangle {
                // 两个视图重叠放置，通过 opacity 切换
                ClipboardList {
                    visible: root.current-view == "clipboard";
                    opacity: root.current-view == "clipboard" ? 1 : 0;
                    x: root.current-view == "clipboard" ? 0 : -20px;
                    animate opacity { duration: 200ms; easing: ease-out; }
                    animate x { duration: 200ms; easing: ease-out; }

                    dark-mode: root.dark-mode;
                    items: root.clipboard-items;
                    item-count: root.item-count;
                    last-clicked-id: root.last-clicked-id;
                    click-pending: root.click-pending;
                    filter-plain-text: root.filter-plain-text;
                    filter-rich-text: root.filter-rich-text;
                    filter-image: root.filter-image;
                    filter-link: root.filter-link;
                    filter-color: root.filter-color;
                    card-height-mode: root.card-height-mode;
                    show-source-app: root.show-source-app;
                    auto-scroll-to-top: root.auto-scroll-to-top;
                    show-original-on-hover: root.show-original-on-hover;
                    scroll-trigger: root.scroll-trigger;
                    editing-note-id: root.editing-note-id;
                    editing-note-text: root.editing-note-text;
                    toggle-filter(type) => { root.toggle-filter(type); }
                    clear-filters => { root.clear-filters(); }
                    search-keyword(keyword) => { root.search-keyword(keyword); }
                    copy-item(id) => { root.copy-item(id); }
                    paste-item(id) => { root.paste-item(id); }
                    edit-item(id) => { root.edit-item(id); }
                    toggle-favorite(id) => { root.toggle-favorite(id); }
                    delete-item(id) => { root.delete-item(id); }
                    update-note(id, text) => { root.update-note(id, text); }
                    show-context-menu(id) => { root.show-context-menu(id); }
                    hide-context-menu => { root.hide-context-menu(); }
                }

                EditPanel {
                    visible: root.current-view == "edit";
                    opacity: root.current-view == "edit" ? 1 : 0;
                    x: root.current-view == "edit" ? 0 : 20px;
                    animate opacity { duration: 200ms; easing: ease-out; }
                    animate x { duration: 200ms; easing: ease-out; }

                    dark-mode: root.dark-mode;
                    editing-content: root.editing-content;
                    editing-item-id: root.editing-item-id;
                    content-type: root.editing-item-type;

                    cancel => { root.current-view = "clipboard"; }
                    save-content(id, text) => { root.save-content(id, text); }
                }

                SettingsPanel {
                    visible: root.current-view == "settings";
                    opacity: root.current-view == "settings" ? 1 : 0;
                    x: root.current-view == "settings" ? 0 : 20px;
                    animate opacity { duration: 200ms; easing: ease-out; }
                    animate x { duration: 200ms; easing: ease-out; }

                    dark-mode: root.dark-mode;
                    theme-mode: root.theme-mode;
                    auto-start: root.auto-start;
                    auto-hide: root.auto-hide;
                    sort-by-created: root.sort-by-created;
                    db-path: root.db-path;
                    settings-error: root.settings-error;
                    active-tab: root.active-tab;
                    hotkey-display: root.hotkey-display;
                    recording-hotkey: root.recording-hotkey;
                    position-mode: root.position-mode;
                    card-height-mode: root.card-height-mode;
                    silent-start: root.silent-start;
                    show-source-app: root.show-source-app;
                    auto-scroll-to-top: root.auto-scroll-to-top;
                    copy-as-plain-text: root.copy-as-plain-text;
                    show-original-on-hover: root.show-original-on-hover;

                    back => { root.current-view = "clipboard"; }
                    toggle-auto-start => { root.toggle-auto-start(); }
                    toggle-auto-hide => { root.toggle-auto-hide(); }
                    toggle-sort-by-created => { root.toggle-sort-by-created(); }
                    pick-db-path => { root.pick-db-path(); }
                    reset-db-path => { root.reset-db-path(); }
                    set-hotkey(s) => { root.set-hotkey(s); }
                    start-recording-hotkey => { root.start-recording-hotkey(); }
                    set-theme(mode) => { root.set-theme(mode); }
                    set-position-mode(mode) => { root.set-position-mode(mode); }
                    set-card-height-mode(mode) => { root.set-card-height-mode(mode); }
                    toggle-silent-start => { root.toggle-silent-start(); }
                    toggle-show-source-app => { root.toggle-show-source-app(); }
                    toggle-auto-scroll-to-top => { root.toggle-auto-scroll-to-top(); }
                    toggle-copy-as-plain-text => { root.toggle-copy-as-plain-text(); }
                    toggle-show-original-on-hover => { root.toggle-show-original-on-hover(); }
                }
            }
        }

        // ========== 右键菜单浮层 ==========
        if root.context-menu-visible: ContextMenu {
            menu-x: root.context-menu-x;
            menu-y: root.context-menu-y;
            container-width: parent.width;
            container-height: parent.height;
            dark-mode: root.dark-mode;
            item-id: root.context-menu-item-id;
            is-color: root.context-menu-is-color;
            is-hex: root.context-menu-is-hex;
            is-image: root.context-menu-is-image;
            is-favorite: root.context-menu-is-favorite;

            copy-item(id) => { root.copy-item(id); }
            paste-item(id) => { root.paste-item(id); }
            edit-item(id) => { root.edit-item(id); }
            toggle-favorite(id) => { root.toggle-favorite(id); }
            delete-item(id) => { root.delete-item(id); }
            hide-menu => { root.hide-context-menu(); }
            paste-as-rgb(id) => { root.paste-as-rgb(id); }
            paste-as-hex(id) => { root.paste-as-hex(id); }
            start-note-edit(id) => {
                root.editing-note-id = id;
                root.editing-note-text = "";
            }
        }
    }
    }
}
