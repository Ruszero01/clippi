import { ClipboardEntry, TagItem, SyncBackendInfo, BlacklistEntry } from "types.slint";
import { ClipboardList } from "ClipboardList.slint";
import { SettingsPanel } from "SettingsPanel.slint";
import { EditPanel } from "EditPanel.slint";
import { ContextMenu } from "ContextMenu.slint";
import { TagFilterPanel } from "TagFilterPanel.slint";
import { TagPickerPanel } from "TagPickerPanel.slint";
import { AddBackendPanel } from "AddBackendPanel.slint";

import { Palette } from "std-widgets.slint";
import { TagPanelTheme } from "theme.slint";

export component App inherits Window {
    icon: @image-url("../assets/LOGO.ico");
    title: "Clippi";
    preferred-width: 320px;
    preferred-height: 480px;
    no-frame: true;
    always-on-top: true;
    background: transparent;
    forward-focus: key-handler;

    // 窗口最小尺寸
    min-width: 320px;
    min-height: 480px;

    in property <[ClipboardEntry]> clipboard-items: [];
    in property <int> item-count: 0;
    in-out property <bool> dark-mode: false;
    in-out property <int> theme-mode: 0;  // 0=system, 1=dark, 2=light

    // 视图切换
    in-out property <string> current-view: "clipboard";
    in-out property <bool> auto-start: false;
    in-out property <bool> auto-hide: false;
    in-out property <bool> pinned: false;
    in-out property <bool> sort-by-created: false;
    in-out property <string> db-path: "";
    in-out property <string> settings-error: "";
    in-out property <int> active-tab: 0;
    in-out property <string> hotkey-display: "";
    in-out property <bool> recording-hotkey: false;
    // 快捷键黑名单
    in-out property <bool> hotkey-blacklist-panel-visible: false;
    in-out property <string> blacklist-pending-app: "";
    in property <[BlacklistEntry]> hotkey-blacklist: [];
    in-out property <string> foreground-app-name: "";
    in-out property <string> foreground-window-title: "";
    in-out property <image> foreground-app-icon: @image-url("../assets/blank.png");
    in-out property <int> position-mode: 0;  // 0=center, 1=follow, 2=remember
    in-out property <string> card-height-mode: "medium";
    in-out property <bool> silent-start: true;
    in-out property <bool> show-source-app: false;
    in-out property <bool> auto-scroll-to-top: false;
    in-out property <bool> copy-as-plain-text: false;
    in-out property <bool> show-original-on-hover: false;
    in-out property <int> max-items: 0;
    in-out property <int> scroll-trigger: 0;
    // 云同步
    in property <[SyncBackendInfo]> sync-backends: [];
    in-out property <bool> sync-auto-enabled: true;
    in-out property <int> sync-interval-secs: 60;
    in-out property <string> sync-status: "";
    in-out property <int> sync-items-added: 0;
    in-out property <int> sync-items-updated: 0;
    in-out property <int> sync-tags-added: 0;
    // 添加服务浮层
    in-out property <bool> add-backend-panel-visible: false;
    in-out property <length> add-backend-panel-x: 0px;
    in-out property <length> add-backend-panel-y: 0px;
    in property <string> preset-onedrive-path: "";
    in property <string> preset-icloud-path: "";
    in-out property <bool> add-backend-edit-mode: false;
    in-out property <string> add-backend-edit-id: "";
    in-out property <string> add-backend-edit-name: "";
    in-out property <string> add-backend-edit-folder: "";

    // 右键菜单状态
    in-out property <bool> context-menu-visible: false;
    in-out property <length> context-menu-x: 0px;
    in-out property <length> context-menu-y: 0px;
    in-out property <int> context-menu-item-id: -1;
    in-out property <bool> context-menu-is-color: false;
    in-out property <bool> context-menu-is-hex: false;
    in-out property <bool> context-menu-is-image: false;
    in-out property <bool> context-menu-is-favorite: false;
    in-out property <bool> context-menu-is-file: false;
    in-out property <bool> context-menu-is-batch: false;

    // 选中状态
    in-out property <int> selected-count: 0;

    // 编辑视图状态
    in property <string> editing-content: "";
    in-out property <int> editing-item-id: -1;
    in-out property <string> editing-item-type: "";

    // 备注编辑状态（转发给 ClipboardList）
    in-out property <int> editing-note-id: -1;
    in-out property <string> editing-note-text: "";

    // 分类筛选
    in-out property <bool> filter-plain-text: false;
    in-out property <bool> filter-rich-text: false;
    in-out property <bool> filter-image: false;
    in-out property <bool> filter-link: false;
    in-out property <bool> filter-color: false;
    in-out property <bool> filter-file: false;
    in-out property <bool> filter-favorites: false;
    in-out property <bool> has-tag-filter: false;

    // 标签浮层状态
    in-out property <bool> tag-filter-visible: false;
    in-out property <length> tag-filter-x: 0px;
    in-out property <length> tag-filter-y: 0px;
    in-out property <bool> tag-picker-visible: false;
    in-out property <length> tag-picker-x: 0px;
    in-out property <length> tag-picker-y: 0px;
    in-out property <int> tag-picker-item-id: -1;
    in-out property <bool> tag-picker-is-batch: false;
    in-out property <[TagItem]> all-tags: [];

    // 双击检测
    in-out property <int> last-clicked-id: -1;
    in-out property <bool> click-pending: false;

    // 警告文字滚动
    property <length> error-scroll: 0;

    callback copy-item(int);
    callback paste-item(int);

    callback move-window(float, float);
    callback close-window();
    callback toggle-auto-start();
    callback toggle-auto-hide();
    callback toggle-pinned();
    callback toggle-sort-by-created();
    callback pick-db-path();
    callback reset-db-path();
    callback resize-window(float, float);
    callback set-hotkey(string);
    callback start-recording-hotkey();
    callback remove-hotkey-blacklist(string);
    callback show-hotkey-blacklist-panel();
    callback hide-hotkey-blacklist-panel();
    callback confirm-add-blacklist();
    callback set-theme(int);
    callback set-position-mode(int);
    callback set-card-height-mode(string);
    callback toggle-filter(string);
    callback clear-filters();
    callback search-keyword(string);
    callback toggle-favorites-filter();
    callback toggle-favorite(int);
    callback delete-item(int);
    callback toggle-silent-start();
    callback toggle-show-source-app();
    callback toggle-auto-scroll-to-top();
    callback toggle-copy-as-plain-text();
    callback toggle-show-original-on-hover();
    callback set-max-items(int);
    callback toggle-sync-auto-enabled();
    callback set-sync-interval(int);
    callback sync-now();
    callback show-add-backend-panel();
    callback hide-add-backend-panel();
    callback add-sync-backend(string, string);
    callback save-sync-backend(string, string, string);  // (id, name, folder_path)
    callback pick-backend-folder();
    callback remove-sync-backend(string);
    callback toggle-sync-backend(string);
    callback edit-sync-backend(string);
    callback update-note(int, string);
    callback edit-item(int);
    callback save-content(int, string);
    callback show-context-menu(int);
    callback hide-context-menu();
    callback paste-as-rgb(int);
    callback paste-as-hex(int);
    callback select-single(int);
    callback toggle-selection(int);
    callback range-select(int);
    callback clear-selection();
    callback batch-paste();
    callback batch-favorite();
    callback batch-delete();
    // 标签回调
    callback show-tag-filter-panel();
    callback hide-tag-filter-panel();
    callback toggle-tag-filter(int);
    callback create-tag(string);
    callback delete-tag(int);
    callback update-tag(int, string, color);
    callback show-tag-picker(int);
    callback hide-tag-picker();
    callback create-and-add-tag(int, string);
    callback toggle-item-tag(int, int);
    callback batch-add-tag(int);
    callback batch-remove-tag(int);
    callback clear-all-tags();

    // ========== 主题色板 ==========
    property <color> bg:            dark-mode ? #191a1b : #f2f3f8;
    property <color> surface:       dark-mode ? #232425 : #ffffff;
    property <color> surface-hover: dark-mode ? #303132 : #f4f5fb;
    property <color> surface-press: dark-mode ? #3a3b3c : #ebedf5;
    property <color> text-1:        dark-mode ? #eaebec : #1a1c2e;
    property <color> text-2:        dark-mode ? #919496 : #7c809a;
    property <color> text-3:        dark-mode ? #5f6264 : #b4b9ca;
    property <color> accent:        dark-mode ? #7ecba3 : #6ab890;
    property <color> accent-soft:   dark-mode ? #1a2e24 : #e8f5ee;
    property <color> divider:       dark-mode ? #2b2c2d : #e6e8f0;
    property <color> titlebar-bg:   dark-mode ? #191a1b : #ffffff;
    property <color> btn-hover:     dark-mode ? #2b2c2d : #f0f1f8;
    property <color> danger:        #ff5f57;

    // 同步 Slint 原生组件（滚动条等）的颜色方案
    init => {
        Palette.color-scheme = dark-mode ? ColorScheme.dark : ColorScheme.light;
        TagPanelTheme.dark-mode = root.dark-mode;
    }
    changed dark-mode => {
        Palette.color-scheme = dark-mode ? ColorScheme.dark : ColorScheme.light;
        TagPanelTheme.dark-mode = root.dark-mode;
    }

    // 双击检测定时器（200ms 窗口，每次点击强制重启）
    double-click-timer := Timer {
        interval: 200ms;
        running: root.click-pending;
        triggered => {
            root.click-pending = false;
            root.last-clicked-id = -1;
        }
    }

    key-handler := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.close-window();
                return accept;
            }
            reject
        }

        Rectangle {
            border-radius: 12px;
            background: bg;
            border-width: 1px;
            border-color: dark-mode ? #3a3b3c : #d0d2de;
            clip: true;

        // 滚动 Timer
        error-scroll-timer := Timer {
            interval: 50ms;
            running: root.settings-error != "";
            triggered => {
                if (root.settings-error != "") {
                    error-scroll += 1px;
                    if (error-scroll > 500px) {
                        error-scroll = 0px;
                    }
                } else {
                    error-scroll = 0px;
                }
            }
        }

        VerticalLayout {
            spacing: 0px;

            // ========== 标题栏 ==========
            Rectangle {
                height: 38px;
                background: bg;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 4px;
                    spacing: 8px;

                    // 应用名称 + LOGO
                    HorizontalLayout {
                        spacing: 7px;
                        VerticalLayout {
                            alignment: center;

                            Rectangle {
                                width: 20px;
                                height: 20px;

                                Image {
                                    width: 20px;
                                    height: 20px;
                                    source: @image-url("../assets/LOGO_notext.ico");
                                }
                            }
                        }

                        Text {
                            text: "Clippi";
                            font-size: 12px;
                            font-weight: 700;
                            color: text-2;
                            vertical-alignment: center;
                        }
                    }

                    // 中间警告区域（始终占位，保持布局）
                    Rectangle {
                        clip: true;
                        width: 120px;

                        Rectangle {
                            width: 4px;
                        }

                        if (root.settings-error != "") : Text {
                            x: 120px - error-scroll;
                            text: root.settings-error;
                            color: danger;
                            font-size: 10px;
                            vertical-alignment: center;
                        }
                    }

                    // 右侧按钮组
                    HorizontalLayout {
                        spacing: 2px;
                        alignment: end;

                        // 收藏筛选按钮
                        Rectangle {
                            width: 28px;
                            height: 28px;

                            fav-filter-ta := TouchArea {
                                width: parent.width;
                                height: parent.height;
                                clicked => { root.toggle-favorites-filter(); }
                            }

                            Text {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                text: "\u{e630}";
                                font-family: "iconfont";
                                font-size: 15px;
                                color: filter-favorites ? accent : (fav-filter-ta.has-hover ? accent : text-2);
                            }
                        }

                        // 固定按钮（免打扰模式）
                        Rectangle {
                            width: 28px;
                            height: 28px;

                            pin-ta := TouchArea {
                                width: parent.width;
                                height: parent.height;
                                clicked => { root.toggle-pinned(); }
                            }

                            Text {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                text: "\u{e633}";
                                font-family: "iconfont";
                                font-size: 15px;
                                color: pinned ? accent : (pin-ta.has-hover ? accent : text-2);
                                transform-rotation: pinned ? 45deg : 0deg;
                                animate transform-rotation { duration: 200ms; easing: ease-out; }
                            }
                        }

                        // 设置按钮
                        Rectangle {
                            width: 28px;
                            height: 28px;

                            settings-ta := TouchArea {
                                width: parent.width;
                                height: parent.height;
                                clicked => {
                                    root.current-view = "settings";
                                }
                            }

                            Text {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                text: "\u{e6b6}";
                                font-family: "iconfont";
                                font-size: 16px;
                                color: settings-ta.has-hover ? accent : text-2;
                            }
                        }
                    }
                }

                // 拖动区域
                drag-ta := TouchArea {
                    x: 0px;
                    y: 0px;
                    width: parent.width - 92px;
                    height: parent.height;
                    mouse-cursor: grab;

                    moved => {
                        if (self.pressed) {
                            root.move-window((self.mouse-x - self.pressed-x) / 1px, (self.mouse-y - self.pressed-y) / 1px);
                        }
                    }
                }
            }

            // ========== 内容区域 ==========
            Rectangle {
                // 两个视图重叠放置，通过 opacity 切换
                ClipboardList {
                    width: parent.width;
                    height: parent.height;
                    visible: root.current-view == "clipboard";
                    opacity: root.current-view == "clipboard" ? 1 : 0;
                    x: root.current-view == "clipboard" ? 0 : -20px;
                    animate opacity { duration: 200ms; easing: ease-out; }
                    animate x { duration: 200ms; easing: ease-out; }

                    dark-mode: root.dark-mode;
                    items: root.clipboard-items;
                    item-count: root.item-count;
                    last-clicked-id <=> root.last-clicked-id;
                    click-pending <=> root.click-pending;
                    filter-plain-text: root.filter-plain-text;
                    filter-rich-text: root.filter-rich-text;
                    filter-image: root.filter-image;
                    filter-link: root.filter-link;
                    filter-color: root.filter-color;
                    filter-file: root.filter-file;
                    card-height-mode: root.card-height-mode;
                    show-source-app: root.show-source-app;
                    auto-scroll-to-top: root.auto-scroll-to-top;
                    show-original-on-hover: root.show-original-on-hover;
                    scroll-trigger: root.scroll-trigger;
                    editing-note-id: root.editing-note-id;
                    editing-note-text: root.editing-note-text;
                    toggle-filter(type) => { root.toggle-filter(type); }
                    clear-filters => { root.clear-filters(); }
                    search-keyword(keyword) => { root.search-keyword(keyword); }
                    copy-item(id) => { root.copy-item(id); }
                    paste-item(id) => { root.paste-item(id); }
                    edit-item(id) => { root.edit-item(id); }
                    toggle-favorite(id) => { root.toggle-favorite(id); }
                    delete-item(id) => { root.delete-item(id); }
                    update-note(id, text) => { root.update-note(id, text); }
                    show-context-menu(id) => { root.show-context-menu(id); }
                    hide-context-menu => { root.hide-context-menu(); }
                    selected-count: root.selected-count;
                    context-menu-is-batch <=> root.context-menu-is-batch;
                    select-single(id) => { root.select-single(id); }
                    toggle-selection(id) => { root.toggle-selection(id); }
                    range-select(id) => { root.range-select(id); }
                    clear-selection => { root.clear-selection(); }
                    batch-paste => { root.batch-paste(); }
                    batch-favorite => { root.batch-favorite(); }
                    batch-delete => { root.batch-delete(); }
                    has-tag-filter: root.has-tag-filter;
                    show-tag-filter-panel => { root.show-tag-filter-panel(); }
                    show-tag-picker(id) => { root.show-tag-picker(id); }
                    hide-tag-picker => { root.hide-tag-picker(); }
                    hide-tag-filter-panel => { root.hide-tag-filter-panel(); }
                }

                EditPanel {
                    visible: root.current-view == "edit";
                    opacity: root.current-view == "edit" ? 1 : 0;
                    x: root.current-view == "edit" ? 0 : 20px;
                    animate opacity { duration: 200ms; easing: ease-out; }
                    animate x { duration: 200ms; easing: ease-out; }

                    dark-mode: root.dark-mode;
                    editing-content: root.editing-content;
                    editing-item-id: root.editing-item-id;
                    content-type: root.editing-item-type;

                    cancel => { root.current-view = "clipboard"; }
                    save-content(id, text) => { root.save-content(id, text); }
                }

                SettingsPanel {
                    visible: root.current-view == "settings";
                    opacity: root.current-view == "settings" ? 1 : 0;
                    x: root.current-view == "settings" ? 0 : 20px;
                    animate opacity { duration: 200ms; easing: ease-out; }
                    animate x { duration: 200ms; easing: ease-out; }

                    dark-mode: root.dark-mode;
                    theme-mode: root.theme-mode;
                    auto-start: root.auto-start;
                    auto-hide: root.auto-hide;
                    sort-by-created: root.sort-by-created;
                    db-path: root.db-path;
                    settings-error: root.settings-error;
                    active-tab: root.active-tab;
                    hotkey-display: root.hotkey-display;
                    recording-hotkey: root.recording-hotkey;
                    foreground-app-name: root.foreground-app-name;
                    foreground-window-title: root.foreground-window-title;
                    foreground-app-icon: root.foreground-app-icon;
                    hotkey-blacklist: root.hotkey-blacklist;
                    position-mode: root.position-mode;
                    card-height-mode: root.card-height-mode;
                    silent-start: root.silent-start;
                    show-source-app: root.show-source-app;
                    auto-scroll-to-top: root.auto-scroll-to-top;
                    copy-as-plain-text: root.copy-as-plain-text;
                    show-original-on-hover: root.show-original-on-hover;
                    max-items: root.max-items;
                    sync-auto-enabled: root.sync-auto-enabled;
                    sync-interval-secs: root.sync-interval-secs;
                    sync-status: root.sync-status;
                    sync-items-added: root.sync-items-added;
                    sync-items-updated: root.sync-items-updated;
                    sync-tags-added: root.sync-tags-added;
                    sync-backends: root.sync-backends;

                    back => { root.current-view = "clipboard"; }
                    toggle-auto-start => { root.toggle-auto-start(); }
                    toggle-auto-hide => { root.toggle-auto-hide(); }
                    toggle-sort-by-created => { root.toggle-sort-by-created(); }
                    pick-db-path => { root.pick-db-path(); }
                    reset-db-path => { root.reset-db-path(); }
                    set-hotkey(s) => { root.set-hotkey(s); }
                    start-recording-hotkey => { root.start-recording-hotkey(); }
                    remove-hotkey-blacklist(app) => { root.remove-hotkey-blacklist(app); }
                    show-hotkey-blacklist-panel => { root.show-hotkey-blacklist-panel(); }
                    set-theme(mode) => { root.set-theme(mode); }
                    set-position-mode(mode) => { root.set-position-mode(mode); }
                    set-card-height-mode(mode) => { root.set-card-height-mode(mode); }
                    toggle-silent-start => { root.toggle-silent-start(); }
                    toggle-show-source-app => { root.toggle-show-source-app(); }
                    toggle-auto-scroll-to-top => { root.toggle-auto-scroll-to-top(); }
                    toggle-copy-as-plain-text => { root.toggle-copy-as-plain-text(); }
                    toggle-show-original-on-hover => { root.toggle-show-original-on-hover(); }
                    set-max-items(v) => { root.set-max-items(v); }
                    toggle-sync-auto-enabled => { root.toggle-sync-auto-enabled(); }
                    set-sync-interval(i) => { root.set-sync-interval(i); }
                    sync-now => { root.sync-now(); }
                    show-add-backend-panel => { root.show-add-backend-panel(); }
                    remove-sync-backend(id) => { root.remove-sync-backend(id); }
                    toggle-sync-backend(id) => { root.toggle-sync-backend(id); }
                    edit-sync-backend(id) => { root.edit-sync-backend(id); }
                }
            }
        }

        // ========== 右键菜单浮层 ==========
        if root.context-menu-visible: ContextMenu {
            menu-x: root.context-menu-x;
            menu-y: root.context-menu-y;
            container-width: parent.width;
            container-height: parent.height;
            dark-mode: root.dark-mode;
            item-id: root.context-menu-item-id;
            is-color: root.context-menu-is-color;
            is-hex: root.context-menu-is-hex;
            is-image: root.context-menu-is-image;
            is-file: root.context-menu-is-file;
            is-favorite: root.context-menu-is-favorite;
            is-batch: root.context-menu-is-batch;
            selected-count: root.selected-count;

            copy-item(id) => { root.copy-item(id); }
            paste-item(id) => { root.paste-item(id); }
            edit-item(id) => { root.edit-item(id); }
            toggle-favorite(id) => { root.toggle-favorite(id); }
            delete-item(id) => { root.delete-item(id); }
            hide-menu => { root.hide-context-menu(); }
            paste-as-rgb(id) => { root.paste-as-rgb(id); }
            paste-as-hex(id) => { root.paste-as-hex(id); }
            start-note-edit(id) => {
                root.editing-note-id = id;
                root.editing-note-text = "";
            }
            batch-paste => { root.batch-paste(); }
            batch-favorite => { root.batch-favorite(); }
            batch-delete => { root.batch-delete(); }
            show-tag-picker(id) => { root.show-tag-picker(id); }
        }

        // ========== 标签筛选浮层面板 ==========
        if root.tag-filter-visible: TagFilterPanel {
            panel-x: root.tag-filter-x;
            panel-y: root.tag-filter-y;
            container-w: parent.width;
            container-h: parent.height;
            dark-mode: root.dark-mode;
            all-tags <=> root.all-tags;
            has-tag-filter: root.has-tag-filter;

            hide-panel => { root.hide-tag-filter-panel(); }
            create-tag(name) => { root.create-tag(name); }
            delete-tag(id) => { root.delete-tag(id); }
            update-tag(id, name, color) => { root.update-tag(id, name, color); }
            toggle-tag-filter(id) => { root.toggle-tag-filter(id); }
        }

        // ========== 标签选择器浮层面板 ==========
        if root.tag-picker-visible: TagPickerPanel {
            panel-x: root.tag-picker-x;
            panel-y: root.tag-picker-y;
            container-w: parent.width;
            container-h: parent.height;
            dark-mode: root.dark-mode;
            all-tags <=> root.all-tags;
            is-batch: root.tag-picker-is-batch;

            hide-picker => { root.hide-tag-picker(); }
            create-and-add-tag(name) => {
                root.create-and-add-tag(root.tag-picker-item-id, name);
            }
            toggle-item-tag(tag-id) => {
                root.toggle-item-tag(root.tag-picker-item-id, tag-id);
            }
            batch-add-tag(tag-id) => { root.batch-add-tag(tag-id); }
            batch-remove-tag(tag-id) => { root.batch-remove-tag(tag-id); }
            clear-all-tags => { root.clear-all-tags(); }
        }

        // ========== 添加黑名单确认浮层 ==========
        if root.hotkey-blacklist-panel-visible: Rectangle {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;

            // event blocker
            blocker := TouchArea {
                width: 100%;
                height: 100%;
                clicked => { }
            }

            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 280px;
                height: 120px;
                border-radius: 12px;
                background: panel-bg;
                drop-shadow-blur: 16px;
                drop-shadow-color: #00000060;
                drop-shadow-offset-y: 4px;

                property <color> panel-bg: root.dark-mode ? #2c2d2f : #ffffff;
                property <color> panel-text-1: root.dark-mode ? #eaebec : #1a1c2e;
                property <color> panel-text-2: root.dark-mode ? #919496 : #7c809a;
                property <color> panel-btn-hover: root.dark-mode ? #363738 : #f0f1f5;
                property <color> panel-danger: root.dark-mode ? #e06c75 : #c0392b;
                property <color> panel-accent: root.dark-mode ? #7ecba3 : #6ab890;
                property <color> panel-divider: root.dark-mode ? #3a3b3d : #e6e8f0;

                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;

                    Text {
                        text: "将 " + root.blacklist-pending-app + " 加入快捷键黑名单？";
                        font-size: 13px;
                        font-weight: 600;
                        color: panel-text-1;
                        overflow: elide;
                    }

                    Text {
                        text: "加入后在该应用中不会触发 Clippi 快捷键";
                        font-size: 11px;
                        color: panel-text-2;
                    }

                    Rectangle {
                        height: 1px;
                        background: panel-divider;
                    }

                    HorizontalLayout {
                        alignment: end;
                        spacing: 8px;

                        Rectangle {
                            height: 28px;
                            border-radius: 6px;
                            background: cancel-ta.has-hover ? panel-btn-hover : transparent;

                            cancel-ta := TouchArea {
                                width: 100%;
                                height: 100%;
                                clicked => { root.hide-hotkey-blacklist-panel(); }
                            }

                            Text {
                                text: "取消";
                                font-size: 11px;
                                color: panel-text-2;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        Rectangle {
                            height: 28px;
                            min-width: 80px;
                            border-radius: 6px;
                            background: confirm-ta.has-hover ? panel-danger : panel-accent;

                            confirm-ta := TouchArea {
                                width: 100%;
                                height: 100%;
                                clicked => { root.confirm-add-blacklist(); }
                            }

                            Text {
                                text: "确认加入";
                                font-size: 11px;
                                font-weight: 600;
                                color: #ffffff;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // ========== 添加同步服务浮层 ==========
        if root.add-backend-panel-visible: AddBackendPanel {
            panel-x: root.add-backend-panel-x;
            panel-y: root.add-backend-panel-y;
            container-w: parent.width;
            container-h: parent.height;
            dark-mode: root.dark-mode;
            preset-onedrive-path: root.preset-onedrive-path;
            preset-icloud-path: root.preset-icloud-path;
            edit-mode: root.add-backend-edit-mode;
            edit-id: root.add-backend-edit-id;
            edit-name <=> root.add-backend-edit-name;
            edit-folder <=> root.add-backend-edit-folder;

            hide-panel => { root.hide-add-backend-panel(); }
            add-backend(name, path) => { root.add-sync-backend(name, path); }
            save-backend(id, name, path) => { root.save-sync-backend(id, name, path); }
            pick-folder => { root.pick-backend-folder(); }
        }

        // ========== 缩放手柄（置于最顶层，优先接收鼠标事件） ==========
        // 右边缘
        resize-right := TouchArea {
            x: parent.width - 6px;
            y: 12px;
            width: 6px;
            height: parent.height - 24px;
            mouse-cursor: col-resize;

            moved => {
                if (self.pressed) {
                    root.resize-window((self.mouse-x - self.pressed-x) / 1px, 0);
                }
            }
        }

        // 底边缘
        resize-bottom := TouchArea {
            x: 12px;
            y: parent.height - 6px;
            width: parent.width - 24px;
            height: 6px;
            mouse-cursor: row-resize;

            moved => {
                if (self.pressed) {
                    root.resize-window(0, (self.mouse-y - self.pressed-y) / 1px);
                }
            }
        }

        // 右下角
        resize-corner := TouchArea {
            x: parent.width - 12px;
            y: parent.height - 12px;
            width: 12px;
            height: 12px;
            mouse-cursor: se-resize;

            moved => {
                if (self.pressed) {
                    root.resize-window((self.mouse-x - self.pressed-x) / 1px, (self.mouse-y - self.pressed-y) / 1px);
                }
            }
        }
        }
    }
}
