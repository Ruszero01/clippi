import { ScrollView } from "std-widgets.slint";
import { SettingsTabGeneral } from "SettingsTabGeneral.slint";
import { SettingsTabClipboard } from "SettingsTabClipboard.slint";
import { SettingsTabHotkey } from "SettingsTabHotkey.slint";
import { SettingsTabData } from "SettingsTabData.slint";

export component SettingsPanel inherits Rectangle {
    // ========== 输入属性 ==========
    in property <bool> dark-mode: false;
    in property <int> theme-mode: 0;
    in property <bool> auto-start: false;
    in property <bool> auto-hide: false;
    in property <bool> sort-by-created: false;
    in property <string> db-path: "";
    in property <string> settings-error: "";
    in property <string> hotkey-display: "";
    in property <bool> recording-hotkey: false;
    in property <int> position-mode: 0;
    in property <string> card-height-mode: "medium";
    in property <bool> silent-start: true;
    in property <bool> show-source-app: false;
    in property <bool> auto-scroll-to-top: false;

    // ========== 内部状态 ==========
    in-out property <int> active-tab: 0;

    // ========== 回调 ==========
    callback back();
    callback toggle-auto-start();
    callback toggle-auto-hide();
    callback toggle-sort-by-created();
    callback pick-db-path();
    callback reset-db-path();
    callback set-hotkey(string);
    callback start-recording-hotkey();
    callback set-theme(int);
    callback set-position-mode(int);
    callback set-card-height-mode(string);
    callback toggle-silent-start();
    callback toggle-show-source-app();
    callback toggle-auto-scroll-to-top();

    // ========== 主题色板 ==========
    property <color> text-2:        dark-mode ? #919496 : #7c809a;
    property <color> accent:        dark-mode ? #7ecba3 : #6ab890;

    background: transparent;

    // ========== 顶部导航栏 ==========
    HorizontalLayout {
        y: 8px;
        height: 36px;
        x: 8px;
        width: parent.width - 16px;
        spacing: 8px;
        alignment: start;

        Rectangle {
            width: 28px;
            height: 28px;
            y: (parent.height - self.height) / 2;

            back-ta := TouchArea {
                width: parent.width;
                height: parent.height;
                clicked => { root.back(); }
            }

            Text {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                text: "\u{e62b}";
                font-family: "iconfont";
                font-size: 16px;
                color: back-ta.has-hover ? accent : text-2;
            }
        }

        Text {
            text: "设置";
            font-size: 14px;
            font-weight: 700;
            color: dark-mode ? #eaebec : #1a1c2e;
            vertical-alignment: center;
        }
    }

    // ========== 选项卡栏（4个） ==========
    HorizontalLayout {
        y: 52px;
        height: 36px;
        x: 8px;
        width: parent.width - 16px;
        spacing: 0px;

        Rectangle {
            width: 25%;
            height: 100%;

            HorizontalLayout {
                alignment: center;

                Text {
                    text: "通用";
                    font-size: 12px;
                    font-weight: root.active-tab == 0 ? 700 : 400;
                    color: root.active-tab == 0 ? accent : text-2;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }

            TouchArea {
                width: parent.width;
                height: parent.height;
                clicked => { root.active-tab = 0; }
            }

            Rectangle {
                height: 2px;
                background: root.active-tab == 0 ? accent : transparent;
                y: parent.height - self.height;
                width: parent.width;
                animate background { duration: 200ms; easing: ease-out; }
            }
        }

        Rectangle {
            width: 25%;
            height: 100%;

            HorizontalLayout {
                alignment: center;

                Text {
                    text: "剪贴板";
                    font-size: 12px;
                    font-weight: root.active-tab == 1 ? 700 : 400;
                    color: root.active-tab == 1 ? accent : text-2;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }

            TouchArea {
                width: parent.width;
                height: parent.height;
                clicked => { root.active-tab = 1; }
            }

            Rectangle {
                height: 2px;
                background: root.active-tab == 1 ? accent : transparent;
                y: parent.height - self.height;
                width: parent.width;
                animate background { duration: 200ms; easing: ease-out; }
            }
        }

        Rectangle {
            width: 25%;
            height: 100%;

            HorizontalLayout {
                alignment: center;

                Text {
                    text: "快捷键";
                    font-size: 12px;
                    font-weight: root.active-tab == 2 ? 700 : 400;
                    color: root.active-tab == 2 ? accent : text-2;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }

            TouchArea {
                width: parent.width;
                height: parent.height;
                clicked => { root.active-tab = 2; }
            }

            Rectangle {
                height: 2px;
                background: root.active-tab == 2 ? accent : transparent;
                y: parent.height - self.height;
                width: parent.width;
                animate background { duration: 200ms; easing: ease-out; }
            }
        }

        Rectangle {
            width: 25%;
            height: 100%;

            HorizontalLayout {
                alignment: center;

                Text {
                    text: "数据";
                    font-size: 12px;
                    font-weight: root.active-tab == 3 ? 700 : 400;
                    color: root.active-tab == 3 ? accent : text-2;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }

            TouchArea {
                width: parent.width;
                height: parent.height;
                clicked => { root.active-tab = 3; }
            }

            Rectangle {
                height: 2px;
                background: root.active-tab == 3 ? accent : transparent;
                y: parent.height - self.height;
                width: parent.width;
                animate background { duration: 200ms; easing: ease-out; }
            }
        }
    }

    // ========== 选项卡内容 ==========
    ScrollView {
        y: 96px;
        height: parent.height - 104px;
        x: 8px;
        width: parent.width - 16px;

        VerticalLayout {
        if (root.active-tab == 0) : SettingsTabGeneral {
            dark-mode: root.dark-mode;
            theme-mode: root.theme-mode;
            auto-start: root.auto-start;
            auto-hide: root.auto-hide;
            position-mode: root.position-mode;
            silent-start: root.silent-start;
            toggle-auto-start => { root.toggle-auto-start(); }
            toggle-auto-hide => { root.toggle-auto-hide(); }
            set-theme(int) => { root.set-theme(int); }
            set-position-mode(int) => { root.set-position-mode(int); }
            toggle-silent-start => { root.toggle-silent-start(); }
        }

        if (root.active-tab == 1) : SettingsTabClipboard {
            dark-mode: root.dark-mode;
            sort-by-created: root.sort-by-created;
            card-height-mode: root.card-height-mode;
            show-source-app: root.show-source-app;
            auto-scroll-to-top: root.auto-scroll-to-top;
            toggle-sort-by-created => { root.toggle-sort-by-created(); }
            set-card-height-mode(mode) => { root.set-card-height-mode(mode); }
            toggle-show-source-app => { root.toggle-show-source-app(); }
            toggle-auto-scroll-to-top => { root.toggle-auto-scroll-to-top(); }
        }

        if (root.active-tab == 2) : SettingsTabHotkey {
            dark-mode: root.dark-mode;
            hotkey-display: root.hotkey-display;
            recording-hotkey: root.recording-hotkey;
            start-recording-hotkey => { root.start-recording-hotkey(); }
        }

        if (root.active-tab == 3) : SettingsTabData {
            dark-mode: root.dark-mode;
            db-path: root.db-path;
            settings-error: root.settings-error;
            pick-db-path => { root.pick-db-path(); }
            reset-db-path => { root.reset-db-path(); }
        }
        }
    }
}
