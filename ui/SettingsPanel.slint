import { ScrollView } from "std-widgets.slint";
import { SyncBackendInfo, BlacklistEntry } from "types.slint";
import { SettingsTabGeneral } from "SettingsTabGeneral.slint";
import { SettingsTabClipboard } from "SettingsTabClipboard.slint";
import { SettingsTabHotkey } from "SettingsTabHotkey.slint";
import { SettingsTabData } from "SettingsTabData.slint";
import { SettingsTabSync } from "SettingsTabSync.slint";

export component SettingsPanel inherits Rectangle {
    // ========== 输入属性 ==========
    in property <bool> dark-mode: false;
    in property <int> theme-mode: 0;
    in property <bool> auto-start: false;
    in property <bool> auto-hide: false;
    in property <bool> sort-by-created: false;
    in property <string> db-path: "";
    in property <string> settings-error: "";
    in property <string> hotkey-display: "";
    in property <bool> recording-hotkey: false;
    in property <int> position-mode: 0;
    in property <string> card-height-mode: "medium";
    in property <bool> silent-start: true;
    in property <bool> show-source-app: false;
    in property <bool> auto-scroll-to-top: false;
    in property <bool> copy-as-plain-text: false;
    in property <bool> show-original-on-hover: false;
    in property <int> max-items: 0;
    // sync
    in property <bool> sync-auto-enabled: true;
    in property <int> sync-interval-secs: 60;
    in property <string> sync-status: "";
    in property <int> sync-items-added: 0;
    in property <int> sync-items-updated: 0;
    in property <int> sync-tags-added: 0;
    in property <bool> sync-favorites-only: false;
    in property <[SyncBackendInfo]> sync-backends: [];
    in property <string> foreground-app-name: "";
    in property <string> foreground-window-title: "";
    in property <image> foreground-app-icon: @image-url("../assets/blank.png");
    in property <[BlacklistEntry]> hotkey-blacklist: [];

    // ========== 内部状态 ==========
    in-out property <int> active-tab: 0;

    // ========== 回调 ==========
    callback back();
    callback toggle-auto-start();
    callback toggle-auto-hide();
    callback toggle-sort-by-created();
    callback pick-db-path();
    callback reset-db-path();
    callback set-hotkey(string);
    callback start-recording-hotkey();
    callback set-theme(int);
    callback set-position-mode(int);
    callback set-card-height-mode(string);
    callback toggle-silent-start();
    callback toggle-show-source-app();
    callback toggle-auto-scroll-to-top();
    callback toggle-copy-as-plain-text();
    callback toggle-show-original-on-hover();
    callback set-max-items(int);
    callback toggle-sync-auto-enabled();
    callback toggle-sync-favorites-only();
    callback set-sync-interval(int);
    callback sync-now();
    callback show-add-backend-panel();
    callback remove-sync-backend(string);
    callback toggle-sync-backend(string);
    callback edit-sync-backend(string);
    callback remove-hotkey-blacklist(string);
    callback show-hotkey-blacklist-panel();

    // ========== 主题色板 ==========
    property <color> text-2:        dark-mode ? #919496 : #7c809a;
    property <color> accent:        dark-mode ? #7ecba3 : #6ab890;

    background: transparent;

    // ========== 顶部导航栏 ==========
    HorizontalLayout {
        y: 8px;
        height: 36px;
        x: 8px;
        width: parent.width - 16px;
        spacing: 8px;
        alignment: start;

        Rectangle {
            width: 28px;
            height: 28px;
            y: (parent.height - self.height) / 2;

            back-ta := TouchArea {
                width: parent.width;
                height: parent.height;
                clicked => { root.back(); }
            }

            Text {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                text: "\u{e62b}";
                font-family: "iconfont";
                font-size: 16px;
                color: back-ta.has-hover ? accent : text-2;
            }
        }

        Text {
            text: "设置";
            font-size: 14px;
            font-weight: 700;
            color: dark-mode ? #eaebec : #1a1c2e;
            vertical-alignment: center;
        }
    }

    // ========== 选项卡栏（4个） ==========
    HorizontalLayout {
        y: 52px;
        height: 36px;
        x: 8px;
        width: parent.width - 16px;
        spacing: 0px;

        Rectangle {
            width: 20%;
            height: 100%;

            HorizontalLayout {
                alignment: center;

                Text {
                    text: "通用";
                    font-size: 12px;
                    font-weight: root.active-tab == 0 ? 700 : 400;
                    color: root.active-tab == 0 ? accent : text-2;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }

            TouchArea {
                width: parent.width;
                height: parent.height;
                clicked => { root.active-tab = 0; }
            }

            Rectangle {
                height: 2px;
                background: root.active-tab == 0 ? accent : transparent;
                y: parent.height - self.height;
                width: parent.width;
                animate background { duration: 200ms; easing: ease-out; }
            }
        }

        Rectangle {
            width: 20%;
            height: 100%;

            HorizontalLayout {
                alignment: center;

                Text {
                    text: "剪贴板";
                    font-size: 12px;
                    font-weight: root.active-tab == 1 ? 700 : 400;
                    color: root.active-tab == 1 ? accent : text-2;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }

            TouchArea {
                width: parent.width;
                height: parent.height;
                clicked => { root.active-tab = 1; }
            }

            Rectangle {
                height: 2px;
                background: root.active-tab == 1 ? accent : transparent;
                y: parent.height - self.height;
                width: parent.width;
                animate background { duration: 200ms; easing: ease-out; }
            }
        }

        Rectangle {
            width: 20%;
            height: 100%;

            HorizontalLayout {
                alignment: center;

                Text {
                    text: "快捷键";
                    font-size: 12px;
                    font-weight: root.active-tab == 2 ? 700 : 400;
                    color: root.active-tab == 2 ? accent : text-2;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }

            TouchArea {
                width: parent.width;
                height: parent.height;
                clicked => { root.active-tab = 2; }
            }

            Rectangle {
                height: 2px;
                background: root.active-tab == 2 ? accent : transparent;
                y: parent.height - self.height;
                width: parent.width;
                animate background { duration: 200ms; easing: ease-out; }
            }
        }

        Rectangle {
            width: 20%;
            height: 100%;

            HorizontalLayout {
                alignment: center;

                Text {
                    text: "数据";
                    font-size: 12px;
                    font-weight: root.active-tab == 3 ? 700 : 400;
                    color: root.active-tab == 3 ? accent : text-2;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }

            TouchArea {
                width: parent.width;
                height: parent.height;
                clicked => { root.active-tab = 3; }
            }

            Rectangle {
                height: 2px;
                background: root.active-tab == 3 ? accent : transparent;
                y: parent.height - self.height;
                width: parent.width;
                animate background { duration: 200ms; easing: ease-out; }
            }
        }

        Rectangle {
            width: 20%;
            height: 100%;

            HorizontalLayout {
                alignment: center;

                Text {
                    text: "同步";
                    font-size: 12px;
                    font-weight: root.active-tab == 4 ? 700 : 400;
                    color: root.active-tab == 4 ? accent : text-2;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }

            TouchArea {
                width: parent.width;
                height: parent.height;
                clicked => { root.active-tab = 4; }
            }

            Rectangle {
                height: 2px;
                background: root.active-tab == 4 ? accent : transparent;
                y: parent.height - self.height;
                width: parent.width;
                animate background { duration: 200ms; easing: ease-out; }
            }
        }
    }

    // ========== 选项卡内容 ==========
    ScrollView {
        y: 96px;
        height: parent.height - 104px;
        x: 8px;
        width: parent.width - 16px;

        VerticalLayout {
            width: parent.width;
        if (root.active-tab == 0) : SettingsTabGeneral {
            dark-mode: root.dark-mode;
            theme-mode: root.theme-mode;
            auto-start: root.auto-start;
            auto-hide: root.auto-hide;
            position-mode: root.position-mode;
            silent-start: root.silent-start;
            toggle-auto-start => { root.toggle-auto-start(); }
            toggle-auto-hide => { root.toggle-auto-hide(); }
            set-theme(int) => { root.set-theme(int); }
            set-position-mode(int) => { root.set-position-mode(int); }
            toggle-silent-start => { root.toggle-silent-start(); }
        }

        if (root.active-tab == 1) : SettingsTabClipboard {
            dark-mode: root.dark-mode;
            sort-by-created: root.sort-by-created;
            card-height-mode: root.card-height-mode;
            show-source-app: root.show-source-app;
            auto-scroll-to-top: root.auto-scroll-to-top;
            copy-as-plain-text: root.copy-as-plain-text;
            show-original-on-hover: root.show-original-on-hover;
            toggle-sort-by-created => { root.toggle-sort-by-created(); }
            set-card-height-mode(mode) => { root.set-card-height-mode(mode); }
            toggle-show-source-app => { root.toggle-show-source-app(); }
            toggle-auto-scroll-to-top => { root.toggle-auto-scroll-to-top(); }
            toggle-copy-as-plain-text => { root.toggle-copy-as-plain-text(); }
            toggle-show-original-on-hover => { root.toggle-show-original-on-hover(); }
        }

        if (root.active-tab == 2) : SettingsTabHotkey {
            dark-mode: root.dark-mode;
            hotkey-display: root.hotkey-display;
            recording-hotkey: root.recording-hotkey;
            foreground-app-name: root.foreground-app-name;
            foreground-window-title: root.foreground-window-title;
            foreground-app-icon: root.foreground-app-icon;
            hotkey-blacklist: root.hotkey-blacklist;
            start-recording-hotkey => { root.start-recording-hotkey(); }
            remove-hotkey-blacklist(app) => { root.remove-hotkey-blacklist(app); }
            show-hotkey-blacklist-panel => { root.show-hotkey-blacklist-panel(); }
        }

        if (root.active-tab == 3) : SettingsTabData {
            dark-mode: root.dark-mode;
            db-path: root.db-path;
            settings-error: root.settings-error;
            max-items: root.max-items;
            pick-db-path => { root.pick-db-path(); }
            reset-db-path => { root.reset-db-path(); }
            set-max-items(v) => { root.set-max-items(v); }
        }

        if (root.active-tab == 4) : SettingsTabSync {
            dark-mode: root.dark-mode;
            sync-auto-enabled: root.sync-auto-enabled;
            sync-interval-secs: root.sync-interval-secs;
            sync-status: root.sync-status;
            sync-items-added: root.sync-items-added;
            sync-items-updated: root.sync-items-updated;
            sync-tags-added: root.sync-tags-added;
            sync-favorites-only: root.sync-favorites-only;
            sync-backends: root.sync-backends;
            toggle-sync-auto-enabled => { root.toggle-sync-auto-enabled(); }
            toggle-sync-favorites-only => { root.toggle-sync-favorites-only(); }
            set-sync-interval(i) => { root.set-sync-interval(i); }
            sync-now => { root.sync-now(); }
            show-add-backend-panel => { root.show-add-backend-panel(); }
            remove-sync-backend(id) => { root.remove-sync-backend(id); }
            toggle-sync-backend(id) => { root.toggle-sync-backend(id); }
            edit-sync-backend(id) => { root.edit-sync-backend(id); }
        }
        }
    }
}
