export component ContextMenu inherits Rectangle {
    // 定位
    in property <length> menu-x: 0px;
    in property <length> menu-y: 0px;
    in property <length> container-width: 0px;
    in property <length> container-height: 0px;
    // 主题
    in property <bool> dark-mode: false;
    // 条目属性
    in property <int> item-id: -1;
    in property <bool> is-color: false;
    in property <bool> is-hex: false;
    in property <bool> is-image: false;
    in property <bool> is-file: false;
    in property <bool> is-favorite: false;
    // 批量模式
    in property <bool> is-batch: false;
    in property <int> selected-count: 0;

    // 回调
    callback copy-item(int);
    callback paste-item(int);
    callback edit-item(int);
    callback toggle-favorite(int);
    callback delete-item(int);
    callback hide-menu();
    callback paste-as-rgb(int);
    callback paste-as-hex(int);
    callback start-note-edit(int);
    callback batch-paste();
    callback batch-favorite();
    callback batch-delete();

    // 主题色板
    property <color> accent:     dark-mode ? #7ecba3 : #6ab890;
    property <color> text-1:     dark-mode ? #eaebec : #1a1c2e;
    property <color> text-2:     dark-mode ? #919496 : #7c809a;
    property <color> danger:     #ff5f57;
    property <color> btn-hover:  dark-mode ? #2b2c2d : #f0f1f8;
    property <color> divider:    dark-mode ? #3d3e40 : #e0e2ea;
    property <color> sep-line:   dark-mode ? #ffffff0d : #00000010;
    property <color> surface:    dark-mode ? #2c2d2e : #ffffff;
    property <color> border:     dark-mode ? #3a3b3c : #d0d2de;

    width: 164px;
    height: menu-content.preferred-height;
    x: clamp(menu-x, 4px, container-width - 168px);
    y: clamp(menu-y, 4px, container-height - self.height - 4px);
    border-radius: 8px;
    background: surface;
    opacity: 0.95;
    border-width: 1px;
    border-color: dark-mode ? #ffffff14 : #00000012;
    drop-shadow-blur: 12px;
    drop-shadow-color: #00000040;
    drop-shadow-offset-y: 2px;

    menu-content := VerticalLayout {
        padding: 4px;
        spacing: 0px;

        // ── 复制 ──
        if !root.is-batch: row-copy := Rectangle {
            width: 156px;
            height: 30px;
            border-radius: 5px;
            background: row-copy-ta.has-hover ? btn-hover : transparent;

            row-copy-ta := TouchArea {
                width: 100%;
                height: 100%;
                clicked => {
                    copy-item(item-id);
                    hide-menu();
                }
            }

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 8px;
                height: 30px;
                alignment: start;

                Text {
                    text: "\u{e600}";
                    font-family: "iconfont";
                    font-size: 13px;
                    color: row-copy-ta.has-hover ? accent : text-2;
                    vertical-alignment: center;
                }

                Text {
                    text: "复制";
                    font-size: 13px;
                    color: row-copy-ta.has-hover ? accent : text-1;
                    vertical-alignment: center;
                }
            }
        }

        // ── 粘贴 ──
        if !root.is-batch: row-paste := Rectangle {
            width: 156px;
            height: 30px;
            border-radius: 5px;
            background: row-paste-ta.has-hover ? btn-hover : transparent;

            row-paste-ta := TouchArea {
                width: 100%;
                height: 100%;
                clicked => {
                    paste-item(item-id);
                    hide-menu();
                }
            }

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 8px;
                height: 30px;
                alignment: start;

                Text {
                    text: "\u{e600}";
                    font-family: "iconfont";
                    font-size: 13px;
                    color: row-paste-ta.has-hover ? accent : text-2;
                    vertical-alignment: center;
                }

                Text {
                    text: "粘贴";
                    font-size: 13px;
                    color: row-paste-ta.has-hover ? accent : text-1;
                    vertical-alignment: center;
                }
            }
        }

        // ── 颜色转换（仅颜色类型显示） ──
        if !root.is-batch && is-color: row-convert := Rectangle {
            width: 156px;
            height: 30px;
            border-radius: 5px;
            background: row-convert-ta.has-hover ? btn-hover : transparent;

            row-convert-ta := TouchArea {
                width: 100%;
                height: 100%;
                clicked => {
                    if is-hex {
                        paste-as-rgb(item-id);
                    } else {
                        paste-as-hex(item-id);
                    }
                    hide-menu();
                }
            }

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 8px;
                height: 30px;
                alignment: start;

                Text {
                    text: "\u{e610}";
                    font-family: "iconfont";
                    font-size: 13px;
                    color: row-convert-ta.has-hover ? accent : text-2;
                    vertical-alignment: center;
                }

                Text {
                    text: is-hex ? "粘贴为 RGB" : "粘贴为 HEX";
                    font-size: 13px;
                    color: row-convert-ta.has-hover ? accent : text-1;
                    vertical-alignment: center;
                }
            }
        }

        // ── 分隔线 ──
        if !root.is-batch: Rectangle { width: 156px; height: 3px; }
        if !root.is-batch: Rectangle {
            width: 156px;
            height: 1px;
            background: sep-line;
        }
        if !root.is-batch: Rectangle { width: 156px; height: 3px; }

        // ── 编辑 ──
        if !root.is-batch && !is-image && !is-file: row-edit := Rectangle {
            width: 156px;
            height: 30px;
            border-radius: 5px;
            background: row-edit-ta.has-hover ? btn-hover : transparent;

            row-edit-ta := TouchArea {
                width: 100%;
                height: 100%;
                clicked => {
                    edit-item(item-id);
                    hide-menu();
                }
            }

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 8px;
                height: 30px;
                alignment: start;

                Text {
                    text: "\u{e648}";
                    font-family: "iconfont";
                    font-size: 13px;
                    color: row-edit-ta.has-hover ? accent : text-2;
                    vertical-alignment: center;
                }

                Text {
                    text: "编辑";
                    font-size: 13px;
                    color: row-edit-ta.has-hover ? accent : text-1;
                    vertical-alignment: center;
                }
            }
        }

        // ── 备注 ──
        if !root.is-batch: row-note := Rectangle {
            width: 156px;
            height: 30px;
            border-radius: 5px;
            background: row-note-ta.has-hover ? btn-hover : transparent;

            row-note-ta := TouchArea {
                width: 100%;
                height: 100%;
                clicked => {
                    start-note-edit(item-id);
                    hide-menu();
                }
            }

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 8px;
                height: 30px;
                alignment: start;

                Text {
                    text: "\u{e606}";
                    font-family: "iconfont";
                    font-size: 13px;
                    color: row-note-ta.has-hover ? accent : text-2;
                    vertical-alignment: center;
                }

                Text {
                    text: "备注";
                    font-size: 13px;
                    color: row-note-ta.has-hover ? accent : text-1;
                    vertical-alignment: center;
                }
            }
        }

        // ── 分隔线 ──
        if !root.is-batch: Rectangle { width: 156px; height: 3px; }
        if !root.is-batch: Rectangle {
            width: 156px;
            height: 1px;
            background: sep-line;
        }
        if !root.is-batch: Rectangle { width: 156px; height: 3px; }

        // ── 收藏 ──
        if !root.is-batch: row-fav := Rectangle {
            width: 156px;
            height: 30px;
            border-radius: 5px;
            background: row-fav-ta.has-hover ? btn-hover : transparent;

            row-fav-ta := TouchArea {
                width: 100%;
                height: 100%;
                clicked => {
                    toggle-favorite(item-id);
                    hide-menu();
                }
            }

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 8px;
                height: 30px;
                alignment: start;

                Text {
                    text: is-favorite ? "\u{e630}" : "\u{e68d}";
                    font-family: "iconfont";
                    font-size: 13px;
                    color: is-favorite ? accent : (row-fav-ta.has-hover ? accent : text-2);
                    vertical-alignment: center;
                }

                Text {
                    text: is-favorite ? "取消收藏" : "收藏";
                    font-size: 13px;
                    color: row-fav-ta.has-hover ? accent : text-1;
                    vertical-alignment: center;
                }
            }
        }

        // ── 删除 ──
        if !root.is-batch: row-del := Rectangle {
            width: 156px;
            height: 30px;
            border-radius: 5px;
            background: row-del-ta.has-hover ? btn-hover : transparent;

            row-del-ta := TouchArea {
                width: 100%;
                height: 100%;
                clicked => {
                    delete-item(item-id);
                    hide-menu();
                }
            }

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 8px;
                height: 30px;
                alignment: start;

                Text {
                    text: "\u{e8b6}";
                    font-family: "iconfont";
                    font-size: 13px;
                    color: row-del-ta.has-hover ? danger : text-2;
                    vertical-alignment: center;
                }

                Text {
                    text: "删除";
                    font-size: 13px;
                    color: row-del-ta.has-hover ? danger : text-1;
                    vertical-alignment: center;
                }
            }
        }

        // ══════════════════════════════════════════
        // ── 批量操作菜单（仅在多选时显示） ──

        // ── 批量粘贴 ──
        if root.is-batch: row-batch-paste := Rectangle {
            width: 156px;
            height: 30px;
            border-radius: 5px;
            background: row-bp-ta.has-hover ? btn-hover : transparent;

            row-bp-ta := TouchArea {
                width: 100%;
                height: 100%;
                clicked => {
                    batch-paste();
                    hide-menu();
                }
            }

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 8px;
                height: 30px;
                alignment: start;

                Text {
                    text: "\u{e600}";
                    font-family: "iconfont";
                    font-size: 13px;
                    color: row-bp-ta.has-hover ? accent : text-2;
                    vertical-alignment: center;
                }

                Text {
                    text: "粘贴 " + selected-count + " 条";
                    font-size: 13px;
                    color: row-bp-ta.has-hover ? accent : text-1;
                    vertical-alignment: center;
                }
            }
        }

        // ── 分隔线 ──
        if root.is-batch: Rectangle { width: 156px; height: 3px; }
        if root.is-batch: Rectangle {
            width: 156px;
            height: 1px;
            background: sep-line;
        }
        if root.is-batch: Rectangle { width: 156px; height: 3px; }

        // ── 批量收藏 ──
        if root.is-batch: row-batch-fav := Rectangle {
            width: 156px;
            height: 30px;
            border-radius: 5px;
            background: row-bf-ta.has-hover ? btn-hover : transparent;

            row-bf-ta := TouchArea {
                width: 100%;
                height: 100%;
                clicked => {
                    batch-favorite();
                    hide-menu();
                }
            }

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 8px;
                height: 30px;
                alignment: start;

                Text {
                    text: "\u{e630}";
                    font-family: "iconfont";
                    font-size: 13px;
                    color: row-bf-ta.has-hover ? accent : text-2;
                    vertical-alignment: center;
                }

                Text {
                    text: "批量收藏";
                    font-size: 13px;
                    color: row-bf-ta.has-hover ? accent : text-1;
                    vertical-alignment: center;
                }
            }
        }

        // ── 批量删除 ──
        if root.is-batch: row-batch-del := Rectangle {
            width: 156px;
            height: 30px;
            border-radius: 5px;
            background: row-bd-ta.has-hover ? btn-hover : transparent;

            row-bd-ta := TouchArea {
                width: 100%;
                height: 100%;
                clicked => {
                    batch-delete();
                    hide-menu();
                }
            }

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 8px;
                height: 30px;
                alignment: start;

                Text {
                    text: "\u{e8b6}";
                    font-family: "iconfont";
                    font-size: 13px;
                    color: row-bd-ta.has-hover ? danger : text-2;
                    vertical-alignment: center;
                }

                Text {
                    text: "批量删除";
                    font-size: 13px;
                    color: row-bd-ta.has-hover ? danger : text-1;
                    vertical-alignment: center;
                }
            }
        }
    }
}
