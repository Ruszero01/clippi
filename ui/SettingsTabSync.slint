import { SyncBackendInfo } from "types.slint";
import { ScrollView } from "std-widgets.slint";

export component SettingsTabSync inherits Rectangle {
    in property <bool> dark-mode: false;
    in property <bool> sync-auto-enabled: true;
    in property <int> sync-interval-secs: 60;
    in property <string> sync-status: "";
    in property <int> sync-items-added: 0;
    in property <int> sync-items-updated: 0;
    in property <int> sync-tags-added: 0;
    in property <bool> sync-favorites-only: false;
    in property <[SyncBackendInfo]> sync-backends: [];

    callback toggle-sync-auto-enabled();
    callback toggle-sync-favorites-only();
    callback set-sync-interval(int);
    callback sync-now();
    callback show-add-backend-panel();
    callback remove-sync-backend(string);
    callback toggle-sync-backend(string);
    callback edit-sync-backend(string);

    property <color> surface:       dark-mode ? #232425 : #ffffff;
    property <color> text-1:       dark-mode ? #eaebec : #1a1c2e;
    property <color> text-2:       dark-mode ? #919496 : #7c809a;
    property <color> text-3:       dark-mode ? #5f6264 : #b4b9ca;
    property <color> accent:       dark-mode ? #7ecba3 : #6ab890;
    property <color> accent-soft:  dark-mode ? #1a2e24 : #e8f5ee;
    property <color> divider:      dark-mode ? #2b2c2d : #e6e8f0;
    property <color> green: #4CAF50;
    property <color> red: #FF5252;
    property <color> gray: #9E9E9E;

    background: transparent;

    VerticalLayout {
        spacing: 12px;
        padding-top: 8px;

        // ════════════════════════════════════════
        // 上半部分：同步设置
        // ════════════════════════════════════════

        // ── 同步设置容器 ──
        Rectangle {
            border-radius: 10px;
            background: surface;
            border-width: 1px;
            border-color: divider;

            VerticalLayout {
                spacing: 0;

                // 云同步开关行
                HorizontalLayout {
                    height: 38px;
                    padding-left: 14px;
                    padding-right: 12px;
                    alignment: space-between;

                    Text {
                        text: "云同步";
                        font-size: 12px;
                        font-weight: 600;
                        color: text-1;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        width: 40px;
                        height: 22px;
                        border-radius: 11px;
                        y: (parent.height - self.height) / 2;
                        background: root.sync-auto-enabled ? accent : divider;
                        animate background { duration: 200ms; }

                        Rectangle {
                            width: 18px;
                            height: 18px;
                            border-radius: 9px;
                            background: #ffffff;
                            x: root.sync-auto-enabled ? parent.width - self.width - 2px : 2px;
                            animate x { duration: 200ms; }
                        }

                        toggle-ta := TouchArea {
                            width: parent.width;
                            height: parent.height;
                            clicked => { root.toggle-sync-auto-enabled(); }
                        }
                    }
                }

                // 仅收藏开关行
                if root.sync-auto-enabled : Rectangle {
                    width: parent.width;
                    height: 1px;
                    background: divider;
                }

                if root.sync-auto-enabled : HorizontalLayout {
                    height: 38px;
                    padding-left: 14px;
                    padding-right: 12px;
                    alignment: space-between;

                    Text {
                        text: "仅收藏";
                        font-size: 12px;
                        font-weight: 600;
                        color: text-1;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        width: 40px;
                        height: 22px;
                        border-radius: 11px;
                        y: (parent.height - self.height) / 2;
                        background: root.sync-favorites-only ? accent : divider;
                        animate background { duration: 200ms; }

                        Rectangle {
                            width: 18px;
                            height: 18px;
                            border-radius: 9px;
                            background: #ffffff;
                            x: root.sync-favorites-only ? parent.width - self.width - 2px : 2px;
                            animate x { duration: 200ms; }
                        }

                        fav-ta := TouchArea {
                            width: parent.width;
                            height: parent.height;
                            clicked => { root.toggle-sync-favorites-only(); }
                        }
                    }
                }

                // 开启后显示：间隔 + 立即同步
                if root.sync-auto-enabled : Rectangle {
                    width: parent.width;
                    height: 1px;
                    background: divider;
                }

                if root.sync-auto-enabled : HorizontalLayout {
                    spacing: 6px;
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 8px;
                    padding-bottom: 8px;

                    Rectangle {
                        height: 26px;
                        horizontal-stretch: 1;
                        border-radius: 6px;
                        background: i30-selected ? accent : (i30-ta.has-hover ? accent-soft : transparent);
                        animate background { duration: 200ms; }
                        property <bool> i30-selected: root.sync-interval-secs == 30;
                        i30-ta := TouchArea {
                            width: parent.width;
                            height: parent.height;
                            clicked => { root.set-sync-interval(30); }
                        }
                        Text {
                            text: "30秒"; font-size: 10px; font-weight: 600;
                            color: i30-selected ? #ffffff : (i30-ta.has-hover ? accent : text-2);
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        height: 26px;
                        horizontal-stretch: 1;
                        border-radius: 6px;
                        background: i60-selected ? accent : (i60-ta.has-hover ? accent-soft : transparent);
                        animate background { duration: 200ms; }
                        property <bool> i60-selected: root.sync-interval-secs == 60;
                        i60-ta := TouchArea {
                            width: parent.width;
                            height: parent.height;
                            clicked => { root.set-sync-interval(60); }
                        }
                        Text {
                            text: "1分"; font-size: 10px; font-weight: 600;
                            color: i60-selected ? #ffffff : (i60-ta.has-hover ? accent : text-2);
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        height: 26px;
                        horizontal-stretch: 1;
                        border-radius: 6px;
                        background: i600-selected ? accent : (i600-ta.has-hover ? accent-soft : transparent);
                        animate background { duration: 200ms; }
                        property <bool> i600-selected: root.sync-interval-secs == 600;
                        i600-ta := TouchArea {
                            width: parent.width;
                            height: parent.height;
                            clicked => { root.set-sync-interval(600); }
                        }
                        Text {
                            text: "10分"; font-size: 10px; font-weight: 600;
                            color: i600-selected ? #ffffff : (i600-ta.has-hover ? accent : text-2);
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        height: 26px;
                        horizontal-stretch: 1;
                        border-radius: 6px;
                        background: i1800-selected ? accent : (i1800-ta.has-hover ? accent-soft : transparent);
                        animate background { duration: 200ms; }
                        property <bool> i1800-selected: root.sync-interval-secs == 1800;
                        i1800-ta := TouchArea {
                            width: parent.width;
                            height: parent.height;
                            clicked => { root.set-sync-interval(1800); }
                        }
                        Text {
                            text: "30分"; font-size: 10px; font-weight: 600;
                            color: i1800-selected ? #ffffff : (i1800-ta.has-hover ? accent : text-2);
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                    }

                    // 立即同步
                    Rectangle {
                        height: 26px;
                        horizontal-stretch: 1;
                        border-radius: 6px;
                        background: sync-now-ta.has-hover ? accent-soft : accent;
                        sync-now-ta := TouchArea {
                            width: parent.width;
                            height: parent.height;
                            clicked => { root.sync-now(); }
                        }
                        Text {
                            text: "立即同步";
                            font-size: 10px; font-weight: 600;
                            color: sync-now-ta.has-hover ? accent : #ffffff;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // ════════════════════════════════════════
        // 下半部分：服务管理容器
        // ════════════════════════════════════════

        Rectangle {
            border-radius: 10px;
            background: surface;
            border-width: 1px;
            border-color: divider;

            VerticalLayout {
                spacing: 0;

                // 添加服务按钮
                Rectangle {
                    height: 40px;
                    border-radius: 10px;
                    background: add-btn-ta.has-hover ? accent-soft : transparent;

                    add-btn-ta := TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => { root.show-add-backend-panel(); }
                    }

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        padding-top: 10px;
                        padding-bottom: 10px;
                        spacing: 6px;

                        Text {
                            text: "+";
                            font-size: 16px;
                            font-weight: 600;
                            color: add-btn-ta.has-hover ? accent : text-2;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "添加服务";
                            font-size: 12px;
                            color: add-btn-ta.has-hover ? accent : text-2;
                            vertical-alignment: center;
                        }
                    }
                }

                // 分割线（有服务时显示）
                if root.sync-backends.length > 0 : Rectangle {
                    width: parent.width;
                    height: 1px;
                    background: divider;
                }

                // 服务卡片滚动列表
                if root.sync-backends.length > 0 : ScrollView {
                    height: 190px;
                    viewport-width: parent.width;

                    svc-list := VerticalLayout {
                        spacing: 6px;
                        padding: 8px;

                        for backend in root.sync-backends: Rectangle {
                            height: 56px;
                            border-radius: 8px;
                            background: dark-mode ? #1e1f20 : #f8f9fc;
                            border-width: 1px;
                            border-color: divider;

                            VerticalLayout {
                                height: 100%;
                                padding-left: 10px;
                                padding-right: 6px;

                                Rectangle {
                                    vertical-stretch: 1;
                                }

                                HorizontalLayout {
                                    alignment: space-between;

                                    VerticalLayout {
                                        spacing: 3px;

                                        HorizontalLayout {
                                            spacing: 6px;

                                            Rectangle {
                                                width: 12px;
                                                height: 12px;
                                                border-radius: 6px;
                                                y: (parent.height - self.height) / 2;
                                                border-width: 1px;
                                                border-color: backend.status == "online" ? green :
                                                             backend.status == "syncing" ? accent :
                                                             backend.status == "error" ? red : gray;
                                                background: transparent;

                                                Rectangle {
                                                    width: 5px;
                                                    height: 5px;
                                                    border-radius: 3px;
                                                    x: (parent.width - self.width) / 2;
                                                    y: (parent.height - self.height) / 2;
                                                    background: backend.status == "online" ? green :
                                                               backend.status == "syncing" ? accent :
                                                               backend.status == "error" ? red : gray;
                                                }
                                            }

                                            Text {
                                                text: backend.name;
                                                font-size: 12px;
                                                font-weight: 600;
                                                color: text-1;
                                                vertical-alignment: center;
                                            }

                                            Rectangle {
                                                height: 16px;
                                                width: svc-label-text.width + 10px;
                                                border-radius: 3px;
                                                background: accent-soft;

                                                svc-label-text := Text {
                                                    text: backend.service-label;
                                                    font-size: 10px;
                                                    color: accent;
                                                    x: 5px;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        Text {
                                            text: backend.last-sync-at + " · " + backend.item-count + "条记录 · " + backend.tag-count + "个标签";
                                            font-size: 10px;
                                            color: text-3;
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 2px;

                                        Rectangle {
                                            width: 24px;
                                            height: 24px;
                                            border-radius: 5px;
                                            y: (parent.height - self.height) / 2;
                                            background: edit-ta.has-hover ? (dark-mode ? #2b2c2d : #e6e8f0) : transparent;

                                            edit-ta := TouchArea {
                                                width: 100%;
                                                height: 100%;
                                                clicked => { root.edit-sync-backend(backend.id); }
                                            }

                                            Text {
                                                text: "\u{e648}";
                                                font-family: "iconfont";
                                                font-size: 12px;
                                                color: edit-ta.has-hover ? accent : text-3;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }

                                        Rectangle {
                                            width: 24px;
                                            height: 24px;
                                            border-radius: 5px;
                                            y: (parent.height - self.height) / 2;
                                            background: rm-ta.has-hover ? (dark-mode ? #3e0005 : #ffeaea) : transparent;

                                            rm-ta := TouchArea {
                                                width: 100%;
                                                height: 100%;
                                                clicked => { root.remove-sync-backend(backend.id); }
                                            }

                                            Text {
                                                text: "\u{e8b6}";
                                                font-family: "iconfont";
                                                font-size: 12px;
                                                color: rm-ta.has-hover ? red : text-3;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }

                                Rectangle {
                                    vertical-stretch: 1;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
