import { SyncBackendInfo } from "types.slint";
import { ScrollView } from "std-widgets.slint";

export component SettingsTabSync inherits Rectangle {
    in property <bool> dark-mode: false;
    in property <bool> sync-auto-enabled: true;
    in property <string> sync-status: "";
    in property <int> sync-items-added: 0;
    in property <int> sync-items-updated: 0;
    in property <int> sync-tags-added: 0;
    in property <bool> sync-favorites-only: false;
    in property <[SyncBackendInfo]> sync-backends: [];

    callback toggle-sync-auto-enabled();
    callback toggle-sync-favorites-only();
    callback show-add-backend-panel();
    callback remove-sync-backend(string);
    callback toggle-sync-backend(string);
    callback edit-sync-backend(string);
    callback sync-backend-now(string);
    callback set-backend-sync-interval(string, int);

    property <color> surface:       dark-mode ? #232425 : #ffffff;
    property <color> text-1:       dark-mode ? #eaebec : #1a1c2e;
    property <color> text-2:       dark-mode ? #919496 : #7c809a;
    property <color> text-3:       dark-mode ? #5f6264 : #b4b9ca;
    property <color> accent:       dark-mode ? #7ecba3 : #6ab890;
    property <color> accent-soft:  dark-mode ? #1a2e24 : #e8f5ee;
    property <color> divider:      dark-mode ? #2b2c2d : #e6e8f0;
    property <color> green: #4CAF50;
    property <color> red: #FF5252;
    property <color> gray: #9E9E9E;

    background: transparent;

    VerticalLayout {
        spacing: 12px;
        padding-top: 8px;

        // ════════════════════════════════════════
        // 上半部分：全局同步开关
        // ════════════════════════════════════════

        Rectangle {
            border-radius: 10px;
            background: surface;
            border-width: 1px;
            border-color: divider;

            VerticalLayout {
                spacing: 0;

                // 云同步总开关行
                HorizontalLayout {
                    height: 38px;
                    padding-left: 14px;
                    padding-right: 12px;
                    alignment: space-between;

                    Text {
                        text: @tr("Sync");
                        font-size: 12px;
                        font-weight: 600;
                        color: text-1;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        width: 40px;
                        height: 22px;
                        border-radius: 11px;
                        y: (parent.height - self.height) / 2;
                        background: root.sync-auto-enabled ? accent : divider;
                        animate background { duration: 200ms; }

                        Rectangle {
                            width: 18px;
                            height: 18px;
                            border-radius: 9px;
                            background: #ffffff;
                            x: root.sync-auto-enabled ? parent.width - self.width - 2px : 2px;
                            animate x { duration: 200ms; }
                        }

                        toggle-ta := TouchArea {
                            width: parent.width;
                            height: parent.height;
                            clicked => { root.toggle-sync-auto-enabled(); }
                        }
                    }
                }

                // 仅收藏开关行
                if root.sync-auto-enabled : Rectangle {
                    width: parent.width;
                    height: 1px;
                    background: divider;
                }

                if root.sync-auto-enabled : HorizontalLayout {
                    height: 38px;
                    padding-left: 14px;
                    padding-right: 12px;
                    alignment: space-between;

                    Text {
                        text: @tr("Fav only");
                        font-size: 12px;
                        font-weight: 600;
                        color: text-1;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        width: 40px;
                        height: 22px;
                        border-radius: 11px;
                        y: (parent.height - self.height) / 2;
                        background: root.sync-favorites-only ? accent : divider;
                        animate background { duration: 200ms; }

                        Rectangle {
                            width: 18px;
                            height: 18px;
                            border-radius: 9px;
                            background: #ffffff;
                            x: root.sync-favorites-only ? parent.width - self.width - 2px : 2px;
                            animate x { duration: 200ms; }
                        }

                        fav-ta := TouchArea {
                            width: parent.width;
                            height: parent.height;
                            clicked => { root.toggle-sync-favorites-only(); }
                        }
                    }
                }
            }
        }

        // ════════════════════════════════════════
        // 下半部分：后端管理
        // ════════════════════════════════════════

        Rectangle {
            border-radius: 10px;
            background: surface;
            border-width: 1px;
            border-color: divider;

            VerticalLayout {
                spacing: 0;

                // 添加后端按钮
                Rectangle {
                    height: 40px;
                    border-radius: 10px;
                    background: add-btn-ta.has-hover ? accent-soft : transparent;

                    add-btn-ta := TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => { root.show-add-backend-panel(); }
                    }

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        padding-top: 10px;
                        padding-bottom: 10px;
                        spacing: 6px;

                        Text {
                            text: "+";
                            font-size: 16px;
                            font-weight: 600;
                            color: add-btn-ta.has-hover ? accent : text-2;
                            vertical-alignment: center;
                        }
                        Text {
                            text: @tr("Add backend");
                            font-size: 12px;
                            color: add-btn-ta.has-hover ? accent : text-2;
                            vertical-alignment: center;
                        }
                    }
                }

                // 分割线（有服务时显示）
                if root.sync-backends.length > 0 : Rectangle {
                    width: parent.width;
                    height: 1px;
                    background: divider;
                }

                // 后端卡片滚动列表
                if root.sync-backends.length > 0 : ScrollView {
                    height: 200px;
                    viewport-width: parent.width;

                    VerticalLayout {
                        spacing: 6px;
                        padding: 8px;

                        for backend in root.sync-backends: Rectangle {
                            height: backend.enabled ? 83px : 52px;
                            animate height { duration: 300ms; easing: ease-out; }

                            // ── 底部操作栏（滑到卡片后方被盖住）──
                            Rectangle {
                                y: backend.enabled ? 52px : 21px;
                                animate y { duration: 300ms; easing: ease-out; }
                                x: 0;
                                width: 100%;
                                height: 31px;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: divider;
                                background: dark-mode ? #1e1f20 : #f8f9fc;
                                opacity: backend.enabled ? 1.0 : 0.0;
                                animate opacity { duration: 300ms; easing: ease-out; }

                                HorizontalLayout {
                                    spacing: 4px;
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    padding-top: 5px;
                                    padding-bottom: 5px;

                                    // 30s
                                    Rectangle {
                                        height: 20px;
                                        horizontal-stretch: 1;
                                        border-radius: 6px;
                                        background: backend.sync-interval-secs == 30 ? accent : (i30-ta.has-hover ? accent-soft : transparent);
                                        animate background { duration: 200ms; }
                                        i30-ta := TouchArea {
                                            width: parent.width;
                                            height: parent.height;
                                            clicked => { root.set-backend-sync-interval(backend.id, 30); }
                                        }
                                        Text {
                                            text: @tr("30s");
                                            font-size: 10px;
                                            font-weight: 600;
                                            color: backend.sync-interval-secs == 30 ? #ffffff : (i30-ta.has-hover ? accent : text-2);
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    // 1min
                                    Rectangle {
                                        height: 20px;
                                        horizontal-stretch: 1;
                                        border-radius: 6px;
                                        background: backend.sync-interval-secs == 60 ? accent : (i60-ta.has-hover ? accent-soft : transparent);
                                        animate background { duration: 200ms; }
                                        i60-ta := TouchArea {
                                            width: parent.width;
                                            height: parent.height;
                                            clicked => { root.set-backend-sync-interval(backend.id, 60); }
                                        }
                                        Text {
                                            text: @tr("1min");
                                            font-size: 10px;
                                            font-weight: 600;
                                            color: backend.sync-interval-secs == 60 ? #ffffff : (i60-ta.has-hover ? accent : text-2);
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    // 10min
                                    Rectangle {
                                        height: 20px;
                                        horizontal-stretch: 1;
                                        border-radius: 6px;
                                        background: backend.sync-interval-secs == 600 ? accent : (i600-ta.has-hover ? accent-soft : transparent);
                                        animate background { duration: 200ms; }
                                        i600-ta := TouchArea {
                                            width: parent.width;
                                            height: parent.height;
                                            clicked => { root.set-backend-sync-interval(backend.id, 600); }
                                        }
                                        Text {
                                            text: @tr("10min");
                                            font-size: 10px;
                                            font-weight: 600;
                                            color: backend.sync-interval-secs == 600 ? #ffffff : (i600-ta.has-hover ? accent : text-2);
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    // 30min
                                    Rectangle {
                                        height: 20px;
                                        horizontal-stretch: 1;
                                        border-radius: 6px;
                                        background: backend.sync-interval-secs == 1800 ? accent : (i1800-ta.has-hover ? accent-soft : transparent);
                                        animate background { duration: 200ms; }
                                        i1800-ta := TouchArea {
                                            width: parent.width;
                                            height: parent.height;
                                            clicked => { root.set-backend-sync-interval(backend.id, 1800); }
                                        }
                                        Text {
                                            text: @tr("30min");
                                            font-size: 10px;
                                            font-weight: 600;
                                            color: backend.sync-interval-secs == 1800 ? #ffffff : (i1800-ta.has-hover ? accent : text-2);
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    // 立即同步
                                    Rectangle {
                                        height: 20px;
                                        width: 60px;
                                        border-radius: 6px;
                                        background: sync-now-ta.has-hover ? accent-soft : accent;
                                        sync-now-ta := TouchArea {
                                            width: 100%;
                                            height: 100%;
                                            clicked => { root.sync-backend-now(backend.id); }
                                        }
                                        Text {
                                            text: @tr("Sync now");
                                            font-size: 10px;
                                            font-weight: 600;
                                            color: sync-now-ta.has-hover ? accent : #ffffff;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            // ── 卡片：主体区域（覆盖在底部栏上方）──
                            Rectangle {
                                y: 0;
                                x: 0;
                                width: 100%;
                                height: 52px;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: divider;
                                background: dark-mode ? #1e1f20 : #f8f9fc;

                                HorizontalLayout {
                                    opacity: backend.enabled ? 1.0 : 0.45;
                                    animate opacity { duration: 300ms; easing: ease-out; }
                                    alignment: space-between;
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    padding-top: 5px;
                                    padding-bottom: 3px;

                                    // ── 左侧：信息区 ──
                                    VerticalLayout {
                                        spacing: 3px;

                                        Rectangle {
                                            vertical-stretch: 1;
                                        }

                                        // 状态灯 + 名称 + 标签
                                        HorizontalLayout {
                                            spacing: 6px;

                                            Rectangle {
                                                width: 12px;
                                                height: 12px;
                                                border-radius: 6px;
                                                y: (parent.height - self.height) / 2;
                                                border-width: 1px;
                                                border-color: backend.status == "online" ? green :
                                                             backend.status == "syncing" ? accent :
                                                             backend.status == "error" ? red : gray;
                                                background: transparent;

                                                Rectangle {
                                                    width: 5px;
                                                    height: 5px;
                                                    border-radius: 3px;
                                                    x: (parent.width - self.width) / 2;
                                                    y: (parent.height - self.height) / 2;
                                                    background: backend.status == "online" ? green :
                                                               backend.status == "syncing" ? accent :
                                                               backend.status == "error" ? red : gray;
                                                }
                                            }

                                            Text {
                                                text: backend.name;
                                                font-size: 12px;
                                                font-weight: 600;
                                                color: text-1;
                                                vertical-alignment: center;
                                            }

                                            Rectangle {
                                                height: 16px;
                                                width: svc-label-text.width + 10px;
                                                border-radius: 3px;
                                                background: accent-soft;

                                                svc-label-text := Text {
                                                    text: backend.service-label;
                                                    font-size: 10px;
                                                    color: accent;
                                                    x: 5px;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        // 统计信息
                                        Text {
                                            text: @tr("{} · {} items · {} tags", backend.last-sync-at, backend.item-count, backend.tag-count);
                                            font-size: 10px;
                                            color: text-3;
                                        }

                                        Rectangle {
                                            vertical-stretch: 1;
                                        }
                                    }

                                    // ── 右侧：控制区（垂直居中，单行） ──
                                    VerticalLayout {
                                        Rectangle {
                                            vertical-stretch: 1;
                                        }

                                        HorizontalLayout {
                                            spacing: 4px;
                                            alignment: center;

                                            Rectangle {
                                                width: 24px;
                                                height: 24px;
                                                border-radius: 5px;
                                                background: edit-ta.has-hover ? (dark-mode ? #2b2c2d : #e6e8f0) : transparent;

                                                edit-ta := TouchArea {
                                                    width: 100%;
                                                    height: 100%;
                                                    clicked => { root.edit-sync-backend(backend.id); }
                                                }

                                                Text {
                                                    text: "\u{e648}";
                                                    font-family: "iconfont";
                                                    font-size: 12px;
                                                    color: edit-ta.has-hover ? accent : text-3;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }

                                            Rectangle {
                                                width: 24px;
                                                height: 24px;
                                                border-radius: 5px;
                                                background: rm-ta.has-hover ? (dark-mode ? #3e0005 : #ffeaea) : transparent;

                                                rm-ta := TouchArea {
                                                    width: 100%;
                                                    height: 100%;
                                                    clicked => { root.remove-sync-backend(backend.id); }
                                                }

                                                Text {
                                                    text: "\u{e8b6}";
                                                    font-family: "iconfont";
                                                    font-size: 12px;
                                                    color: rm-ta.has-hover ? red : text-3;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }

                                            // 开关
                                            Rectangle {
                                                width: 40px;
                                                height: 18px;
                                                border-radius: 9px;
                                                y: (parent.height - self.height) / 2;
                                                background: backend.enabled ? accent : dark-mode ? #3a3b3c : #d0d3db;
                                                animate background { duration: 200ms; }

                                                Rectangle {
                                                    width: 14px;
                                                    height: 14px;
                                                    border-radius: 7px;
                                                    background: #ffffff;
                                                    x: backend.enabled ? parent.width - self.width - 2px : 2px;
                                                    y: 2px;
                                                    animate x { duration: 200ms; }
                                                }

                                                be-enable-ta := TouchArea {
                                                    width: 100%;
                                                    height: 100%;
                                                    clicked => { root.toggle-sync-backend(backend.id); }
                                                }
                                            }
                                        }

                                        Rectangle {
                                            vertical-stretch: 1;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
