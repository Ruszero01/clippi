import { ListView } from "std-widgets.slint";
import { ClipboardEntry } from "types.slint";

export component ClipboardList inherits Rectangle {
    // ========== 输入属性 ==========
    in property <bool> dark-mode: false;
    in property <[ClipboardEntry]> items: [];
    in property <int> item-count: 0;

    // ========== 搜索 ==========
    in-out property <string> search-text: "";

    // ========== 筛选 ==========
    in-out property <bool> filter-plain-text: false;
    in-out property <bool> filter-rich-text: false;
    in-out property <bool> filter-image: false;
    in-out property <bool> filter-link: false;
    in-out property <bool> filter-color: false;
    in property <string> card-height-mode: "medium";
    in property <bool> show-source-app: false;
    in property <bool> auto-scroll-to-top: false;
    in property <bool> show-original-on-hover: false;
    in-out property <int> scroll-trigger: 0;
    in-out property <int> editing-note-id: -1;
    in-out property <string> editing-note-text: "";

    // ========== 双击检测 ==========
    in-out property <int> last-clicked-id: -1;
    in-out property <bool> click-pending: false;

    // ========== 回调 ==========
    callback copy-item(int);
    callback paste-item(int);
    callback edit-item(int);
    callback toggle-filter(string);
    callback clear-filters();
    callback search-keyword(string);
    callback toggle-favorite(int);
    callback delete-item(int);
    callback update-note(int, string);
    callback show-context-menu(int);

    // ========== 主题色板 ==========
    property <color> surface:       dark-mode ? #232425 : #ffffff;
    property <color> surface-hover: dark-mode ? #303132 : #f4f5fb;
    property <color> surface-press: dark-mode ? #3a3b3c : #ebedf5;
    property <color> text-1:        dark-mode ? #eaebec : #1a1c2e;
    property <color> text-2:        dark-mode ? #919496 : #7c809a;
    property <color> text-3:        dark-mode ? #5f6264 : #b4b9ca;
    property <color> accent:        dark-mode ? #7ecba3 : #6ab890;
    property <color> accent-soft:   dark-mode ? #1a2e24 : #e8f5ee;
    property <color> tag-bg:        dark-mode ? #232b26 : #b3bda7;
    property <color> tag-text:      dark-mode ? #b3c4b0 : #ffffff;
    property <color> divider:       dark-mode ? #2b2c2d : #e6e8f0;
    property <color> btn-hover:     dark-mode ? #2b2c2d : #f0f1f8;
    property <color> danger:        #ff5f57;

    changed scroll-trigger => {
        if root.auto-scroll-to-top {
            clip-list.viewport-y = 0px;
        }
    }

    background: transparent;

    VerticalLayout {
        padding-top: 4px;
        padding-left: 8px;
        padding-right: 8px;
        padding-bottom: 8px;
        spacing: 8px;

        // ========== 搜索框 ==========
        Rectangle {
            height: 28px;
            border-radius: 10px;
            background: surface;
            border-width: 1px;
            border-color: divider;

            search-icon := Text {
                x: 10px;
                y: (parent.height - self.height) / 2;
                text: "\u{e688}";
                font-family: "iconfont";
                font-size: 14px;
                color: text-3;
            }

            search-input := TextInput {
                x: 32px;
                width: parent.width - 44px;
                y: (parent.height - self.preferred-height) / 2;
                font-size: 12px;
                color: text-1;
                single-line: true;
                text <=> root.search-text;
                edited => {
                    root.search-keyword(root.search-text);
                }
            }

            if root.search-text == "" : Text {
                x: 32px;
                y: (parent.height - self.height) / 2;
                text: "搜索剪贴板内容...";
                font-size: 12px;
                color: text-3;
            }
        }

        // ========== 筛选按钮栏 + 列表 ==========
        VerticalLayout {
            spacing: 6px;
                // ========== 筛选按钮栏 ==========
                HorizontalLayout {
                    spacing: 6px;
                    height: 22px;

                    // 文本
                    ft-bg := Rectangle {
                        width: ft-layout.preferred-width;
                        height: 22px;
                        border-radius: 5px;
                        background: root.filter-plain-text ? (dark-mode ? #7ecba322 : #6ab89022) : (ft-ta.has-hover ? btn-hover : transparent);

                        ft-ta := TouchArea {
                            width: parent.width;
                            height: parent.height;
                            clicked => { search-input.clear-focus(); root.toggle-filter("plain_text"); }
                        }

                        ft-layout := HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            spacing: 3px;
                            alignment: center;

                            Text {
                                text: "\u{e60e}";
                                font-family: "iconfont";
                                font-size: 11px;
                                color: root.filter-plain-text ? accent : text-2;
                                vertical-alignment: center;
                            }

                            Text {
                                text: "文本";
                                font-size: 11px;
                                font-weight: root.filter-plain-text ? 600 : 400;
                                color: root.filter-plain-text ? accent : text-2;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // 格式
                    fr-bg := Rectangle {
                        width: fr-layout.preferred-width;
                        height: 22px;
                        border-radius: 5px;
                        background: root.filter-rich-text ? (dark-mode ? #7ecba322 : #6ab89022) : (fr-ta.has-hover ? btn-hover : transparent);

                        fr-ta := TouchArea {
                            width: parent.width;
                            height: parent.height;
                            clicked => { search-input.clear-focus(); root.toggle-filter("rich_text"); }
                        }

                        fr-layout := HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            spacing: 3px;
                            alignment: center;

                            Text {
                                text: "\u{e6ae}";
                                font-family: "iconfont";
                                font-size: 12px;
                                color: root.filter-rich-text ? accent : text-2;
                                vertical-alignment: center;
                            }

                            Text {
                                text: "格式";
                                font-size: 11px;
                                font-weight: root.filter-rich-text ? 600 : 400;
                                color: root.filter-rich-text ? accent : text-2;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // 图片
                    fi-bg := Rectangle {
                        width: fi-layout.preferred-width;
                        height: 22px;
                        border-radius: 5px;
                        background: root.filter-image ? (dark-mode ? #7ecba322 : #6ab89022) : (fi-ta.has-hover ? btn-hover : transparent);

                        fi-ta := TouchArea {
                            width: parent.width;
                            height: parent.height;
                            clicked => { search-input.clear-focus(); root.toggle-filter("image"); }
                        }

                        fi-layout := HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            spacing: 3px;
                            alignment: center;

                            Text {
                                text: "\u{e626}";
                                font-family: "iconfont";
                                font-size: 11px;
                                color: root.filter-image ? accent : text-2;
                                vertical-alignment: center;
                            }

                            Text {
                                text: "图片";
                                font-size: 11px;
                                font-weight: root.filter-image ? 600 : 400;
                                color: root.filter-image ? accent : text-2;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // 链接
                    fl-bg := Rectangle {
                        width: fl-layout.preferred-width;
                        height: 22px;
                        border-radius: 5px;
                        background: root.filter-link ? (dark-mode ? #7ecba322 : #6ab89022) : (fl-ta.has-hover ? btn-hover : transparent);

                        fl-ta := TouchArea {
                            width: parent.width;
                            height: parent.height;
                            clicked => { search-input.clear-focus(); root.toggle-filter("link"); }
                        }

                        fl-layout := HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            spacing: 3px;
                            alignment: center;

                            Text {
                                text: "\u{e6d7}";
                                font-family: "iconfont";
                                font-size: 11px;
                                color: root.filter-link ? accent : text-2;
                                vertical-alignment: center;
                            }

                            Text {
                                text: "链接";
                                font-size: 11px;
                                font-weight: root.filter-link ? 600 : 400;
                                color: root.filter-link ? accent : text-2;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // 颜色
                    fc-bg := Rectangle {
                        width: fc-layout.preferred-width;
                        height: 22px;
                        border-radius: 5px;
                        background: root.filter-color ? (dark-mode ? #7ecba322 : #6ab89022) : (fc-ta.has-hover ? btn-hover : transparent);

                        fc-ta := TouchArea {
                            width: parent.width;
                            height: parent.height;
                            clicked => { search-input.clear-focus(); root.toggle-filter("color"); }
                        }

                        fc-layout := HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            spacing: 3px;
                            alignment: center;

                            Text {
                                text: "\u{e610}";
                                font-family: "iconfont";
                                font-size: 11px;
                                color: root.filter-color ? accent : text-2;
                                vertical-alignment: center;
                            }

                            Text {
                                text: "颜色";
                                font-size: 11px;
                                font-weight: root.filter-color ? 600 : 400;
                                color: root.filter-color ? accent : text-2;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // 空状态
                if root.item-count == 0: VerticalLayout {
                    alignment: center;
                    height: 200px;
                    spacing: 6px;

                    Text {
                        text: "暂无剪贴板内容";
                        font-size: 13px;
                        color: text-2;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: "复制文本后将自动显示在这里";
                        font-size: 11px;
                        color: text-3;
                        horizontal-alignment: center;
                    }
                }

                // 剪贴板列表
                clip-list := ListView {
                    for entry in root.items: VerticalLayout {
                        padding: 5px;

                        card-rect := Rectangle {
                            height: entry.note != "" ? 68px :
                                root.card-height-mode == "auto" ?
                                (entry.content-type == "image" ?
                                    (entry.image-width > 0 && entry.image-height > 0 ?
                                        (parent.width * entry.image-height / entry.image-width <= 82px ? 68px :
                                         parent.width * entry.image-height / entry.image-width <= 112px ? 96px : 128px) :
                                        96px) :
                                    (entry.preview-length <= 50 ? 60px :
                                     entry.preview-length <= 150 ? 80px :
                                     entry.preview-length <= 300 ? 104px :
                                     entry.preview-length <= 500 ? 130px :
                                     200px)) :
                                root.card-height-mode == "low" ? 68px :
                                root.card-height-mode == "high" ? 128px :
                                96px;
                            border-radius: 10px;
                            background: item-ta.pressed ? surface-press : item-ta.has-hover ? surface-hover : surface;
                            border-width: 1px;
                            border-color: divider;
                            clip: true;

                            drop-shadow-blur: 4px;
                            drop-shadow-color: dark-mode ? #00000040 : #00000012;
                            drop-shadow-offset-y: 1px;

                        item-ta := TouchArea {
                            width: parent.width;
                            height: parent.height;
                            clicked => {
                                if (root.editing-note-id == entry.id) {
                                    root.update-note(entry.id, root.editing-note-text);
                                    root.editing-note-id = -1;
                                    return;
                                }
                                search-input.clear-focus();
                                if (root.click-pending && root.last-clicked-id == entry.id) {
                                    root.click-pending = false;
                                    root.last-clicked-id = -1;
                                    root.paste-item(entry.id);
                                } else {
                                    root.last-clicked-id = entry.id;
                                    root.click-pending = true;
                                }
                            }
                            pointer-event(event) => {
                                if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                                    search-input.clear-focus();
                                    root.click-pending = false;
                                    root.last-clicked-id = -1;
                                    root.show-context-menu(entry.id);
                                }
                            }

                            // ── 卡片内容区 ──
                            HorizontalLayout {
                                padding: 10px;
                                spacing: 10px;

                                // ── 来源应用模式（开启且有来源） ──
                                if root.show-source-app && entry.source-app-name != "" : VerticalLayout {
                                    width: 34px;
                                    spacing: 3px;

                                    Rectangle {
                                        width: 34px;
                                        height: 24px;
                                        border-radius: 6px;
                                        background: divider;
                                        clip: true;

                                        Image {
                                            width: 20px;
                                            height: 20px;
                                            x: 7px;
                                            y: 2px;
                                            source: entry.source-app-icon-image;
                                            image-fit: cover;
                                        }
                                    }

                                    // 颜色类型：显示色块；其他类型：显示图标+标签
                                    if entry.content-type == "color" : Rectangle {
                                        height: 14px;
                                        width: 34px;
                                        border-radius: 3px;
                                        background: entry.color-swatch;
                                        border-width: 1px;
                                        border-color: dark-mode ? #ffffff20 : #00000018;
                                    }

                                    if entry.content-type != "color" : st-bg := Rectangle {
                                        height: 14px;
                                        width: 34px;
                                        border-radius: 3px;
                                        background: tag-bg;

                                        st-layout := HorizontalLayout {
                                            padding-left: 3px;
                                            padding-right: 3px;
                                            spacing: 2px;
                                            alignment: center;

                                            st-icon := Text {
                                                text: entry.content-type == "plain_text" ? "\u{e60e}" :
                                                      entry.content-type == "rich_text" ? "\u{e6ae}" :
                                                      entry.content-type == "image" ? "\u{e626}" : "\u{e6d7}";
                                                font-family: "iconfont";
                                                font-size: 8px;
                                                color: tag-text;
                                                vertical-alignment: center;
                                            }

                                            st-label := Text {
                                                text: entry.content-type == "plain_text" ? "文本" :
                                                      entry.content-type == "rich_text" ? "格式" :
                                                      entry.content-type == "image" ? "图片" : "链接";
                                                font-size: 8px;
                                                font-weight: 500;
                                                color: tag-text;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }

                                // ── 类型图标模式（关闭或没有来源） ──
                                if !root.show-source-app || entry.source-app-name == "" : VerticalLayout {
                                    width: 34px;

                                    if entry.content-type == "image": Rectangle {
                                        width: 34px;
                                        height: 34px;
                                        border-radius: 6px;
                                        background: tag-bg;

                                        Text {
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            text: "\u{e626}";
                                            font-family: "iconfont";
                                            font-size: 18px;
                                            color: tag-text;
                                        }
                                    }

                                    if entry.content-type == "plain_text": Rectangle {
                                        width: 34px;
                                        height: 34px;
                                        border-radius: 6px;
                                        background: tag-bg;

                                        Text {
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            text: "\u{e60e}";
                                            font-family: "iconfont";
                                            font-size: 18px;
                                            color: tag-text;
                                        }
                                    }

                                    if entry.content-type == "rich_text": Rectangle {
                                        width: 34px;
                                        height: 34px;
                                        border-radius: 6px;
                                        background: tag-bg;

                                        Text {
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            text: "\u{e6ae}";
                                            font-family: "iconfont";
                                            font-size: 18px;
                                            color: tag-text;
                                        }
                                    }

                                    if entry.content-type == "link": Rectangle {
                                        width: 34px;
                                        height: 34px;
                                        border-radius: 6px;
                                        background: tag-bg;

                                        Text {
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            text: "\u{e6d7}";
                                            font-family: "iconfont";
                                            font-size: 18px;
                                            color: tag-text;
                                        }
                                    }

                                    if entry.content-type == "color": VerticalLayout {
                                        Rectangle {
                                            vertical-stretch: 1;
                                        }

                                        Rectangle {
                                            width: 34px;
                                            height: 34px;
                                            border-radius: 6px;
                                            background: tag-bg;

                                            Rectangle {
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                                width: 24px;
                                                height: 24px;
                                                border-radius: 4px;
                                                background: entry.color-swatch;
                                                border-width: 1px;
                                                border-color: dark-mode ? #ffffff20 : #00000018;
                                            }
                                        }

                                        Rectangle {
                                            vertical-stretch: 1;
                                        }
                                    }
                                }

                                // ── 右侧内容区：预览 / 图片 / 备注（两种模式共享） ──
                                if root.editing-note-id == entry.id : VerticalLayout {
                                    spacing: 2px;

                                    note-input := TextInput {
                                        text <=> root.editing-note-text;
                                        font-size: 12px;
                                        color: text-1;
                                        single-line: true;
                                        accepted => {
                                            root.update-note(entry.id, root.editing-note-text);
                                            root.editing-note-id = -1;
                                        }
                                    }

                                    HorizontalLayout {
                                        alignment: end;

                                        Rectangle {
                                            width: 16px;
                                            height: 16px;
                                            background: transparent;

                                            confirm-ta := TouchArea {
                                                width: parent.width;
                                                height: parent.height;
                                                clicked => {
                                                    root.update-note(entry.id, root.editing-note-text);
                                                    root.editing-note-id = -1;
                                                }
                                            }

                                            Text {
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                                text: "\u{e611}";
                                                font-family: "iconfont";
                                                font-size: 12px;
                                                color: confirm-ta.has-hover ? accent : text-2;
                                            }
                                        }
                                    }
                                }

                                if root.editing-note-id != entry.id && entry.note != "" && !(root.show-original-on-hover && item-ta.has-hover) : Text {
                                    text: entry.note;
                                    font-size: 12px;
                                    color: text-2;
                                    overflow: elide;
                                    wrap: word-wrap;
                                    vertical-alignment: center;
                                }

                                if root.editing-note-id != entry.id && (entry.note == "" || (root.show-original-on-hover && item-ta.has-hover)) && entry.content-type == "color" : Text {
                                    text: entry.preview;
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: text-1;
                                    overflow: elide;
                                    wrap: word-wrap;
                                    vertical-alignment: center;
                                }

                                if root.editing-note-id != entry.id && (entry.note == "" || (root.show-original-on-hover && item-ta.has-hover)) && entry.content-type != "color" && entry.content-type != "image" : Text {
                                    text: entry.preview;
                                    font-size: 12px;
                                    color: text-1;
                                    overflow: elide;
                                    wrap: word-wrap;
                                    vertical-alignment: top;
                                }

                                if root.editing-note-id != entry.id && (entry.note == "" || (root.show-original-on-hover && item-ta.has-hover)) && entry.content-type == "image" : Rectangle {
                                    border-radius: 6px;
                                    clip: true;
                                    background: accent-soft;

                                    if entry.image-path != "" : Image {
                                        width: parent.width;
                                        height: parent.height;
                                        source: entry.thumbnail;
                                        image-fit: cover;
                                    }

                                    if entry.image-path == "" : Text {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        text: "\u{e626}";
                                        font-family: "iconfont";
                                        font-size: 20px;
                                        color: accent;
                                    }
                                }
                            }

                            // ── 悬浮工具栏 ──
                            if item-ta.has-hover && root.editing-note-id != entry.id : Rectangle {
                                x: parent.width - self.width - 4px;
                                y: 3px;
                                height: 22px;
                                width: tb-inner.preferred-width + 10px;
                                border-radius: 6px;
                                background: dark-mode ? #232425e8 : #ffffffe8;
                                border-width: 1px;
                                border-color: dark-mode ? #ffffff20 : #0000000c;

                                tb-inner := HorizontalLayout {
                                    x: 5px;
                                    y: (parent.height - self.height) / 2;
                                    spacing: 2px;

                                    // 复制按钮
                                    Rectangle {
                                        width: 18px;
                                        height: 18px;

                                        tb-copy-ta := TouchArea {
                                            width: parent.width;
                                            height: parent.height;
                                            clicked => {
                                                search-input.clear-focus();
                                                root.click-pending = false;
                                                root.last-clicked-id = -1;
                                                root.copy-item(entry.id);
                                            }
                                        }

                                        Text {
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            text: "\u{e600}";
                                            font-family: "iconfont";
                                            font-size: 12px;
                                            color: tb-copy-ta.has-hover ? accent : text-2;
                                        }
                                    }

                                    // 编辑按钮（非图片类型显示）
                                    if entry.content-type != "image" : Rectangle {
                                        width: 18px;
                                        height: 18px;

                                        edit-ta := TouchArea {
                                            width: parent.width;
                                            height: parent.height;
                                            clicked => {
                                                search-input.clear-focus();
                                                root.click-pending = false;
                                                root.last-clicked-id = -1;
                                                root.edit-item(entry.id);
                                            }
                                        }

                                        Text {
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            text: "\u{e648}";
                                            font-family: "iconfont";
                                            font-size: 12px;
                                            color: edit-ta.has-hover ? accent : text-2;
                                        }
                                    }

                                    // 备注按钮
                                    Rectangle {
                                        width: 18px;
                                        height: 18px;

                                        note-ta := TouchArea {
                                            width: parent.width;
                                            height: parent.height;
                                            clicked => {
                                                search-input.clear-focus();
                                                root.click-pending = false;
                                                root.last-clicked-id = -1;
                                                root.editing-note-text = entry.note;
                                                root.editing-note-id = entry.id;
                                            }
                                        }

                                        Text {
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            text: "\u{e606}";
                                            font-family: "iconfont";
                                            font-size: 12px;
                                            color: note-ta.has-hover ? accent : text-2;
                                        }
                                    }

                                    // 收藏按钮
                                    Rectangle {
                                        width: 18px;
                                        height: 18px;

                                        fav-ta := TouchArea {
                                            width: parent.width;
                                            height: parent.height;
                                            clicked => {
                                                search-input.clear-focus();
                                                root.click-pending = false;
                                                root.last-clicked-id = -1;
                                                root.toggle-favorite(entry.id);
                                            }
                                        }

                                        Text {
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            text: entry.is-favorite ? "\u{e630}" : "\u{e68d}";
                                            font-family: "iconfont";
                                            font-size: 11px;
                                            color: entry.is-favorite ? accent : (fav-ta.has-hover ? accent : (dark-mode ? text-2 : text-2));
                                        }
                                    }

                                    // 删除按钮
                                    Rectangle {
                                        width: 18px;
                                        height: 18px;

                                        del-ta := TouchArea {
                                            width: parent.width;
                                            height: parent.height;
                                            clicked => {
                                                search-input.clear-focus();
                                                root.click-pending = false;
                                                root.last-clicked-id = -1;
                                                root.delete-item(entry.id);
                                            }
                                        }

                                        Text {
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            text: "\u{e8b6}";
                                            font-family: "iconfont";
                                            font-size: 12px;
                                            color: del-ta.has-hover ? danger : text-2;
                                        }
                                    }
                                }
                            }

                            // 悬浮时间标签
                            if root.editing-note-id != entry.id : Rectangle {
                                x: parent.width - self.width - 10px;
                                y: parent.height - self.height - 6px;
                                height: 18px;
                                width: time-text.preferred-width + 14px;
                                border-radius: 9px;
                                background: dark-mode ? #232425e8 : #ffffffe8;
                                border-width: 1px;
                                border-color: dark-mode ? #ffffff20 : #0000000c;

                                time-text := Text {
                                    text: entry.time-label;
                                    font-size: 9px;
                                    color: text-2;
                                    x: 7px;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        }
                    }
                }
        }
    }
}

