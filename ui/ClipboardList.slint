import { ListView } from "std-widgets.slint";
import { ClipboardEntry } from "types.slint";

export component ClipboardList inherits Rectangle {
    // ========== 输入属性 ==========
    in property <bool> dark-mode: false;
    in property <color> fav-color: #d8a155;
    in property <[ClipboardEntry]> items: [];
    in property <int> item-count: 0;

    // ========== 搜索 ==========
    in-out property <string> search-text: "";

    // ========== 筛选 ==========
    in-out property <bool> filter-plain-text: false;
    in-out property <bool> filter-rich-text: false;
    in-out property <bool> filter-image: false;
    in-out property <bool> filter-link: false;
    in-out property <bool> filter-color: false;
    in-out property <bool> filter-file: false;
    in property <string> card-height-mode: "medium";
    in property <bool> show-source-app: false;
    in property <bool> auto-scroll-to-top: false;
    in property <bool> show-original-on-hover: false;
    in-out property <int> scroll-trigger: 0;
    in-out property <int> editing-note-id: -1;
    in-out property <string> editing-note-text: "";

    // ========== 双击检测 ==========
    in-out property <int> last-clicked-id: -1;
    in-out property <bool> click-pending: false;

    // 工具栏点击标记 — 由工具栏 pointer-event(down) 设置，卡片 pointer-event(up) 消费。
    // 用独立布尔值避免与双击检测的 last-clicked-id 互相干扰。
    in-out property <bool> toolbar-action: false;
    in property <bool> has-tag-filter: false;

    // ========== 选中状态 ==========
    in property <int> selected-count: 0;
    in-out property <bool> context-menu-is-batch: false;

    // ========== 回调 ==========
    callback copy-item(int);
    callback paste-item(int);
    callback edit-item(int);
    callback toggle-filter(string);
    callback clear-filters();
    callback search-keyword(string);
    callback toggle-favorite(int);
    callback delete-item(int);
    callback update-note(int, string);
    callback show-context-menu(int);
    callback hide-context-menu();
    callback open-original-image(int);
    callback open-item-location(int);
    callback select-single(int);
    callback toggle-selection(int);
    callback range-select(int);
    callback clear-selection();
    callback batch-paste();
    callback batch-favorite();
    callback batch-delete();
    callback show-tag-filter-panel();
    callback show-tag-picker(int);
    callback hide-tag-picker();
    callback hide-tag-filter-panel();

    // ========== 主题色板 ==========
    property <color> surface:       dark-mode ? #232425 : #ffffff;
    property <color> surface-hover: dark-mode ? #303132 : #f4f5fb;
    property <color> surface-press: dark-mode ? #3a3b3c : #ebedf5;
    property <color> text-1:        dark-mode ? #eaebec : #1a1c2e;
    property <color> text-2:        dark-mode ? #919496 : #7c809a;
    property <color> text-3:        dark-mode ? #5f6264 : #b4b9ca;
    property <color> accent:        dark-mode ? #7ecba3 : #6ab890;
    property <color> accent-soft:   dark-mode ? #1a2e24 : #e8f5ee;
    property <color> tag-bg:        dark-mode ? #232b26 : #b3bda7;
    property <color> tag-text:      dark-mode ? #b3c4b0 : #ffffff;
    property <color> divider:       dark-mode ? #2b2c2d : #e6e8f0;
    property <color> btn-hover:     dark-mode ? #2b2c2d : #f0f1f8;
    property <color> danger:        #ff5f57;

    changed scroll-trigger => {
        if root.auto-scroll-to-top {
            clip-list.viewport-y = 0px;
        }
    }

    background: transparent;

    // 点击空白区域取消所有选中
    bg-ta := TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => {
            root.clear-selection();
        }
    }

    VerticalLayout {
        padding-top: 4px;
        padding-left: 8px;
        padding-right: 8px;
        padding-bottom: 8px;
        spacing: 8px;

        // ========== 搜索框 ==========
        Rectangle {
            height: 28px;
            border-radius: 10px;
            background: surface;
            border-width: 1px;
            border-color: divider;

            search-icon := Text {
                x: 10px;
                y: (parent.height - self.height) / 2;
                text: "\u{e688}";
                font-family: "iconfont";
                font-size: 14px;
                color: text-3;
            }

            search-input := TextInput {
                x: 32px;
                width: parent.width - 44px;
                y: (parent.height - self.preferred-height) / 2;
                font-size: 12px;
                color: text-1;
                single-line: true;
                text <=> root.search-text;
                changed has-focus => {
                    if self.has-focus { root.hide-context-menu(); root.hide-tag-filter-panel(); root.hide-tag-picker(); }
                }
                edited => {
                    root.search-keyword(root.search-text);
                }
            }

            if root.search-text == "" : Text {
                x: 32px;
                y: (parent.height - self.height) / 2;
                text: "搜索剪贴板内容...";
                font-size: 12px;
                color: text-3;
            }
        }

        // ========== 筛选按钮栏 + 列表 ==========
        VerticalLayout {
            spacing: 6px;
                // ========== 筛选按钮栏 ==========
                HorizontalLayout {
                    alignment: space-between;
                    height: 22px;

                    // 类型筛选按钮组
                    HorizontalLayout {
                        spacing: 6px;

                    // 文本
                    ft-bg := Rectangle {
                        width: ft-layout.preferred-width;
                        height: 22px;
                        border-radius: 5px;
                        background: root.filter-plain-text ? (dark-mode ? #7ecba322 : #6ab89022) : (ft-ta.has-hover ? (dark-mode ? btn-hover : #e0e1ea) : transparent);

                        ft-ta := TouchArea {
                            width: parent.width;
                            height: parent.height;
                            clicked => { search-input.clear-focus(); root.hide-context-menu(); root.hide-tag-filter-panel(); root.hide-tag-picker(); root.toggle-filter("plain_text"); }
                        }

                        ft-layout := HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            spacing: 3px;
                            alignment: center;

                            Text {
                                text: "\u{e60e}";
                                font-family: "iconfont";
                                font-size: 11px;
                                color: root.filter-plain-text ? accent : text-2;
                                vertical-alignment: center;
                            }

                            Text {
                                text: "文本";
                                font-size: 11px;
                                font-weight: root.filter-plain-text ? 600 : 400;
                                color: root.filter-plain-text ? accent : text-2;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // 格式
                    fr-bg := Rectangle {
                        width: fr-layout.preferred-width;
                        height: 22px;
                        border-radius: 5px;
                        background: root.filter-rich-text ? (dark-mode ? #7ecba322 : #6ab89022) : (fr-ta.has-hover ? (dark-mode ? btn-hover : #e0e1ea) : transparent);

                        fr-ta := TouchArea {
                            width: parent.width;
                            height: parent.height;
                            clicked => { search-input.clear-focus(); root.hide-context-menu(); root.hide-tag-filter-panel(); root.hide-tag-picker(); root.toggle-filter("rich_text"); }
                        }

                        fr-layout := HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            spacing: 3px;
                            alignment: center;

                            Text {
                                text: "\u{e6ae}";
                                font-family: "iconfont";
                                font-size: 12px;
                                color: root.filter-rich-text ? accent : text-2;
                                vertical-alignment: center;
                            }

                            Text {
                                text: "格式";
                                font-size: 11px;
                                font-weight: root.filter-rich-text ? 600 : 400;
                                color: root.filter-rich-text ? accent : text-2;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // 文件
                    fi-bg := Rectangle {
                        width: fi-layout.preferred-width;
                        height: 22px;
                        border-radius: 5px;
                        background: root.filter-file ? (dark-mode ? #7ecba322 : #6ab89022) : (fi-ta.has-hover ? (dark-mode ? btn-hover : #e0e1ea) : transparent);

                        fi-ta := TouchArea {
                            width: parent.width;
                            height: parent.height;
                            clicked => { search-input.clear-focus(); root.hide-context-menu(); root.hide-tag-filter-panel(); root.hide-tag-picker(); root.toggle-filter("file"); }
                        }

                        fi-layout := HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            spacing: 3px;
                            alignment: center;

                            Text {
                                text: "\u{e646}";
                                font-family: "iconfont";
                                font-size: 11px;
                                color: root.filter-file ? accent : text-2;
                                vertical-alignment: center;
                            }

                            Text {
                                text: "文件";
                                font-size: 11px;
                                font-weight: root.filter-file ? 600 : 400;
                                color: root.filter-file ? accent : text-2;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // 链接
                    fl-bg := Rectangle {
                        width: fl-layout.preferred-width;
                        height: 22px;
                        border-radius: 5px;
                        background: root.filter-link ? (dark-mode ? #7ecba322 : #6ab89022) : (fl-ta.has-hover ? (dark-mode ? btn-hover : #e0e1ea) : transparent);

                        fl-ta := TouchArea {
                            width: parent.width;
                            height: parent.height;
                            clicked => { search-input.clear-focus(); root.hide-context-menu(); root.hide-tag-filter-panel(); root.hide-tag-picker(); root.toggle-filter("link"); }
                        }

                        fl-layout := HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            spacing: 3px;
                            alignment: center;

                            Text {
                                text: "\u{e6d7}";
                                font-family: "iconfont";
                                font-size: 11px;
                                color: root.filter-link ? accent : text-2;
                                vertical-alignment: center;
                            }

                            Text {
                                text: "链接";
                                font-size: 11px;
                                font-weight: root.filter-link ? 600 : 400;
                                color: root.filter-link ? accent : text-2;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // 颜色
                    fc-bg := Rectangle {
                        width: fc-layout.preferred-width;
                        height: 22px;
                        border-radius: 5px;
                        background: root.filter-color ? (dark-mode ? #7ecba322 : #6ab89022) : (fc-ta.has-hover ? (dark-mode ? btn-hover : #e0e1ea) : transparent);

                        fc-ta := TouchArea {
                            width: parent.width;
                            height: parent.height;
                            clicked => { search-input.clear-focus(); root.hide-context-menu(); root.hide-tag-filter-panel(); root.hide-tag-picker(); root.toggle-filter("color"); }
                        }

                        fc-layout := HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            spacing: 3px;
                            alignment: center;

                            Text {
                                text: "\u{e610}";
                                font-family: "iconfont";
                                font-size: 11px;
                                color: root.filter-color ? accent : text-2;
                                vertical-alignment: center;
                            }

                            Text {
                                text: "颜色";
                                font-size: 11px;
                                font-weight: root.filter-color ? 600 : 400;
                                color: root.filter-color ? accent : text-2;
                                vertical-alignment: center;
                            }
                        }
                    }

                    } // end type filter group

                    // 分割线
                    Rectangle {
                        width: 1px;
                        height: 14px;
                        y: 4px;
                        background: dark-mode ? #ffffff18 : #00000014;
                    }

                    // 标签筛选按钮（仅图标，右对齐）
                    ft-tag-btn := Rectangle {
                        width: 24px;
                        height: 22px;
                        border-radius: 5px;
                        background: tag-plus-ta.has-hover ? (dark-mode ? btn-hover : #e0e1ea) : (root.has-tag-filter ? (dark-mode ? #7ecba322 : #6ab89022) : transparent);

                        Text {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            text: "\u{ec07}";
                            font-family: "iconfont";
                            font-size: 13px;
                            color: root.has-tag-filter ? accent : text-2;
                            vertical-alignment: center;
                        }

                        tag-plus-ta := TouchArea {
                            width: parent.width;
                            height: parent.height;
                            clicked => { search-input.clear-focus(); root.hide-context-menu(); root.hide-tag-picker(); root.show-tag-filter-panel(); }
                        }
                    }
                }

                // 空状态
                if root.item-count == 0: VerticalLayout {
                    alignment: center;
                    height: 200px;
                    spacing: 6px;

                    Text {
                        text: "暂无剪贴板内容";
                        font-size: 13px;
                        color: text-2;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: "复制文本后将自动显示在这里";
                        font-size: 11px;
                        color: text-3;
                        horizontal-alignment: center;
                    }
                }

                // 剪贴板列表
                clip-list := ListView {
                    for entry in root.items: VerticalLayout {
                        padding: 5px;

                        card-rect := Rectangle {
                            height: entry.note != "" ? 68px :
                                root.card-height-mode == "auto" ?
                                (entry.content-type == "link" || entry.content-type == "path" ? 68px :
                                 entry.content-type == "image" ?
                                    (entry.image-width > 0 && entry.image-height > 0 ?
                                        (entry.image-height * 100 / entry.image-width <= 25 ? 68px :
                                         entry.image-height * 100 / entry.image-width <= 50 ? 80px :
                                         entry.image-height * 100 / entry.image-width <= 80 ? 104px :
                                         entry.image-height * 100 / entry.image-width <= 130 ? 130px :
                                         200px) :
                                        96px) :
                                 entry.content-type == "file" ?
                                    (entry.file-count <= 2 ? 68px :
                                     entry.file-count <= 3 ? 96px :
                                     108px) :
                                    (entry.preview-length <= 50 ? 68px :
                                     entry.preview-length <= 150 ? 80px :
                                     entry.preview-length <= 300 ? 104px :
                                     entry.preview-length <= 500 ? 130px :
                                     200px)) :
                                root.card-height-mode == "low" ? 68px :
                                root.card-height-mode == "high" ? 128px :
                                96px;
                            border-radius: 10px;
                            background: item-ta.pressed ? surface-press : item-ta.has-hover ? surface-hover : surface;
                            border-width: 1px;
                            border-color: entry.selected ? accent : divider;
                            clip: true;

                            drop-shadow-blur: 4px;
                            drop-shadow-color: dark-mode ? #00000040 : #00000012;
                            drop-shadow-offset-y: 1px;

                        item-ta := TouchArea {
                            width: parent.width;
                            height: parent.height;
                            pointer-event(event) => {
                                if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                                    search-input.clear-focus();
                                    root.click-pending = false;
                                    root.last-clicked-id = -1;
                                    root.hide-tag-filter-panel();
                                    root.hide-tag-picker();
                                    if (entry.selected && root.selected-count > 1) {
                                        // 多选条目上右键 → 批量操作菜单
                                        root.context-menu-is-batch = true;
                                        root.show-context-menu(entry.id);
                                    } else {
                                        // 非选中条目右键 → 取消选中，单选此条目，普通菜单
                                        root.select-single(entry.id);
                                        root.context-menu-is-batch = false;
                                        root.show-context-menu(entry.id);
                                    }
                                    return;
                                }
                                if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) {
                                    // 工具栏按钮点击：标记已在 pointer-event(down) 设置，此处消费
                                    if root.toolbar-action {
                                        root.toolbar-action = false;
                                        return;
                                    }

                                    if (root.editing-note-id == entry.id) {
                                        root.update-note(entry.id, root.editing-note-text);
                                        root.editing-note-id = -1;
                                        return;
                                    }
                                    search-input.clear-focus();
                                    root.hide-context-menu();
                                    root.hide-tag-filter-panel();
                                    root.hide-tag-picker();

                                    if (root.click-pending && root.last-clicked-id == entry.id) {
                                        root.click-pending = false;
                                        root.last-clicked-id = -1;
                                        if (root.selected-count > 1) {
                                            root.batch-paste();
                                        } else {
                                            root.paste-item(entry.id);
                                        }
                                        return;
                                    }

                                    if (event.modifiers.control) {
                                        root.toggle-selection(entry.id);
                                    } else if (event.modifiers.shift) {
                                        root.range-select(entry.id);
                                    } else if (!entry.selected) {
                                        // 仅点击未选中条目时触发单选；已选中条目保持选中以便双击批量粘贴
                                        root.select-single(entry.id);
                                    }

                                    // 强制重启双击计时器
                                    root.click-pending = false;
                                    root.last-clicked-id = entry.id;
                                    root.click-pending = true;
                                }
                            }

                            // ── 卡片内容区 ──
                            HorizontalLayout {
                                padding: 10px;
                                spacing: 10px;

                                // ── 来源应用模式（开启且有来源，文件类型除外） ──
                                if root.show-source-app && entry.source-app-name != "" && entry.source-app-icon-path != "" && entry.content-type != "file" && entry.content-type != "path" && entry.content-type != "link" : VerticalLayout {
                                    width: 34px;
                                    spacing: 3px;

                                    Rectangle {
                                        width: 34px;
                                        height: 28px;
                                        border-radius: 6px;
                                        background: divider;
                                        clip: true;

                                        Image {
                                            width: 22px;
                                            height: 22px;
                                            x: 6px;
                                            y: 3px;
                                            source: entry.source-app-icon-image;
                                            image-fit: cover;
                                        }
                                    }

                                    // 颜色类型：显示色块；其他类型：显示图标+标签
                                    if entry.content-type == "color" : Rectangle {
                                        height: 14px;
                                        width: 34px;
                                        border-radius: 3px;
                                        background: entry.color-swatch;
                                        border-width: 1px;
                                        border-color: dark-mode ? #ffffff20 : #00000018;
                                    }

                                    if entry.content-type != "color" : st-bg := Rectangle {
                                        height: 14px;
                                        width: 34px;
                                        border-radius: 3px;
                                        background: tag-bg;

                                        st-layout := HorizontalLayout {
                                            padding-left: 4px;
                                            padding-right: 4px;
                                            alignment: center;

                                            st-label := Text {
                                                text: entry.content-type == "plain_text" ? "文本" :
                                                      entry.content-type == "rich_text" ? "格式" :
                                                      entry.content-type == "image" ? "图片" :
                                                      entry.content-type == "file" ? entry.file-icon-text :
                                                      entry.content-type == "link" ? "URL" :
                                                      entry.content-type == "path" ? "路径" : "";
                                                font-size: 10px;
                                                font-weight: 500;
                                                color: tag-text;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }

                                // ── 类型图标模式（关闭、没有来源、或文件类型） ──
                                if !root.show-source-app || entry.source-app-name == "" || entry.source-app-icon-path == "" || entry.content-type == "file" || entry.content-type == "path" || entry.content-type == "link" : VerticalLayout {
                                    width: 34px;

                                    if entry.content-type == "image": VerticalLayout {
                                        spacing: 3px;

                                        Rectangle {
                                            width: 34px;
                                            height: 28px;
                                            border-radius: 6px;
                                            background: tag-bg;

                                            Text {
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                                text: "\u{e626}";
                                                font-family: "iconfont";
                                                font-size: 18px;
                                                color: tag-text;
                                            }
                                        }

                                        Rectangle {
                                            height: 14px;
                                            width: 34px;
                                            border-radius: 3px;
                                            background: tag-bg;

                                            HorizontalLayout {
                                                padding-left: 4px;
                                                padding-right: 4px;
                                                alignment: center;

                                                Text {
                                                    text: "图片";
                                                    font-size: 10px;
                                                    font-weight: 500;
                                                    color: tag-text;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }

                                    if entry.content-type == "file": VerticalLayout {
                                        spacing: 3px;

                                        Rectangle {
                                            width: 34px;
                                            height: 28px;
                                            border-radius: 6px;
                                            background: tag-bg;
                                            clip: true;

                                            // Multi-file: generic icon; single file: OS file icon (or fallback glyph)
                                            if entry.file-count > 1 : Text {
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                                text: "\u{e68a}";
                                                font-family: "iconfont";
                                                font-size: 18px;
                                                color: tag-text;
                                            }

                                            if entry.file-count <= 1 && entry.file-icon-path != "" : Image {
                                                width: 22px;
                                                height: 22px;
                                                x: 6px;
                                                y: 3px;
                                                source: entry.file-icon-image;
                                                image-fit: contain;
                                            }

                                            if entry.file-count <= 1 && entry.file-icon-path == "" : Text {
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                                text: "\u{e646}";
                                                font-family: "iconfont";
                                                font-size: 16px;
                                                color: tag-text;
                                            }
                                        }

                                        Rectangle {
                                            height: 14px;
                                            width: 34px;
                                            border-radius: 3px;
                                            background: tag-bg;
                                            clip: true;

                                            HorizontalLayout {
                                                padding-left: 4px;
                                                padding-right: 4px;
                                                alignment: center;
                                                spacing: 1px;

                                                if entry.file-count > 1 : Text {
                                                    text: "\u{e646}";
                                                    font-family: "iconfont";
                                                    font-size: 8px;
                                                    color: tag-text;
                                                    vertical-alignment: center;
                                                }

                                                Text {
                                                    text: entry.file-icon-text;
                                                    font-size: 10px;
                                                    font-weight: 500;
                                                    color: tag-text;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                }
                                            }
                                        }
                                    }

                                    if entry.content-type == "plain_text": VerticalLayout {
                                        spacing: 3px;

                                        Rectangle {
                                            width: 34px;
                                            height: 28px;
                                            border-radius: 6px;
                                            background: tag-bg;

                                            Text {
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                                text: "\u{e60e}";
                                                font-family: "iconfont";
                                                font-size: 18px;
                                                color: tag-text;
                                            }
                                        }

                                        Rectangle {
                                            height: 14px;
                                            width: 34px;
                                            border-radius: 3px;
                                            background: tag-bg;

                                            HorizontalLayout {
                                                padding-left: 4px;
                                                padding-right: 4px;
                                                alignment: center;

                                                Text {
                                                    text: "文本";
                                                    font-size: 10px;
                                                    font-weight: 500;
                                                    color: tag-text;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }

                                    if entry.content-type == "rich_text": VerticalLayout {
                                        spacing: 3px;

                                        Rectangle {
                                            width: 34px;
                                            height: 28px;
                                            border-radius: 6px;
                                            background: tag-bg;

                                            Text {
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                                text: "\u{e6ae}";
                                                font-family: "iconfont";
                                                font-size: 18px;
                                                color: tag-text;
                                            }
                                        }

                                        Rectangle {
                                            height: 14px;
                                            width: 34px;
                                            border-radius: 3px;
                                            background: tag-bg;

                                            HorizontalLayout {
                                                padding-left: 4px;
                                                padding-right: 4px;
                                                alignment: center;

                                                Text {
                                                    text: "格式";
                                                    font-size: 10px;
                                                    font-weight: 500;
                                                    color: tag-text;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }

                                    if entry.content-type == "link": VerticalLayout {
                                        spacing: 3px;

                                        Rectangle {
                                            width: 34px;
                                            height: 28px;
                                            border-radius: 6px;
                                            background: tag-bg;
                                            clip: true;

                                            if entry.favicon-path != "" : Rectangle {
                                                width: 22px;
                                                height: 22px;
                                                x: 6px;
                                                y: 3px;
                                                clip: true;
                                                border-radius: 11px;

                                                Image {
                                                    width: 22px;
                                                    height: 22px;
                                                    source: entry.favicon-image;
                                                    image-fit: cover;
                                                }
                                            }

                                            if entry.favicon-path == "" && root.show-source-app && entry.source-app-icon-path != "" : Image {
                                                width: 22px;
                                                height: 22px;
                                                x: 6px;
                                                y: 3px;
                                                source: entry.source-app-icon-image;
                                                image-fit: contain;
                                            }

                                            if entry.favicon-path == "" && !(root.show-source-app && entry.source-app-icon-path != "") : Text {
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                                text: "\u{e6d7}";
                                                font-family: "iconfont";
                                                font-size: 16px;
                                                color: tag-text;
                                            }
                                        }

                                        Rectangle {
                                            height: 14px;
                                            width: 34px;
                                            border-radius: 3px;
                                            background: tag-bg;
                                            clip: true;

                                            HorizontalLayout {
                                                padding-left: 4px;
                                                padding-right: 4px;
                                                alignment: center;

                                                Text {
                                                    text: "URL";
                                                    font-size: 10px;
                                                    font-weight: 500;
                                                    color: tag-text;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                }
                                            }
                                        }
                                    }

                                    if entry.content-type == "path": VerticalLayout {
                                        spacing: 3px;

                                        Rectangle {
                                            width: 34px;
                                            height: 28px;
                                            border-radius: 6px;
                                            background: tag-bg;
                                            clip: true;

                                            if entry.folder-icon-path != "" : Image {
                                                width: 22px;
                                                height: 22px;
                                                x: 6px;
                                                y: 3px;
                                                source: entry.folder-icon-image;
                                                image-fit: contain;
                                            }

                                            if entry.folder-icon-path == "" : Text {
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                                text: "\u{e646}";
                                                font-family: "iconfont";
                                                font-size: 16px;
                                                color: tag-text;
                                            }
                                        }

                                        Rectangle {
                                            height: 14px;
                                            width: 34px;
                                            border-radius: 3px;
                                            background: tag-bg;
                                            clip: true;

                                            HorizontalLayout {
                                                padding-left: 4px;
                                                padding-right: 4px;
                                                alignment: center;

                                                Text {
                                                    text: "路径";
                                                    font-size: 10px;
                                                    font-weight: 500;
                                                    color: tag-text;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                }
                                            }
                                        }
                                    }

                                    if entry.content-type == "color": VerticalLayout {
                                        Rectangle {
                                            vertical-stretch: 1;
                                        }

                                        Rectangle {
                                            width: 34px;
                                            height: 34px;
                                            border-radius: 6px;
                                            background: tag-bg;

                                            Rectangle {
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                                width: 24px;
                                                height: 24px;
                                                border-radius: 4px;
                                                background: entry.color-swatch;
                                                border-width: 1px;
                                                border-color: dark-mode ? #ffffff20 : #00000018;
                                            }
                                        }

                                        Rectangle {
                                            vertical-stretch: 1;
                                        }
                                    }
                                }

                                // ── 右侧内容区：预览 / 图片 / 备注（两种模式共享） ──
                                if root.editing-note-id == entry.id : VerticalLayout {
                                    spacing: 2px;

                                    note-input := TextInput {
                                        text <=> root.editing-note-text;
                                        font-size: 12px;
                                        color: text-1;
                                        single-line: true;
                                        accepted => {
                                            root.update-note(entry.id, root.editing-note-text);
                                            root.editing-note-id = -1;
                                        }
                                    }

                                    HorizontalLayout {
                                        alignment: end;

                                        Rectangle {
                                            width: 16px;
                                            height: 16px;
                                            background: transparent;

                                            confirm-ta := TouchArea {
                                                width: parent.width;
                                                height: parent.height;
                                                clicked => {
                                                    root.update-note(entry.id, root.editing-note-text);
                                                    root.editing-note-id = -1;
                                                }
                                            }

                                            Text {
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                                text: "\u{e611}";
                                                font-family: "iconfont";
                                                font-size: 12px;
                                                color: confirm-ta.has-hover ? accent : text-2;
                                            }
                                        }
                                    }
                                }

                                if root.editing-note-id != entry.id && entry.note != "" && !(root.show-original-on-hover && item-ta.has-hover) : Text {
                                    text: entry.note;
                                    font-size: 12px;
                                    color: text-2;
                                    overflow: elide;
                                    wrap: word-wrap;
                                    vertical-alignment: center;
                                }

                                if root.editing-note-id != entry.id && (entry.note == "" || (root.show-original-on-hover && item-ta.has-hover)) && entry.content-type == "color" : Text {
                                    text: entry.preview;
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: text-1;
                                    overflow: elide;
                                    wrap: word-wrap;
                                    vertical-alignment: center;
                                }

                                // Link URL: domain (bold) + path (faded), single line, vertically centered
                                if root.editing-note-id != entry.id && (entry.note == "" || (root.show-original-on-hover && item-ta.has-hover)) && entry.content-type == "link" : HorizontalLayout {
                                    spacing: 0px;
                                    alignment: start;

                                    Text {
                                        text: entry.link-domain;
                                        font-size: 12px;
                                        font-weight: 700;
                                        color: text-1;
                                        vertical-alignment: center;
                                    }

                                    if entry.link-path != "" : Text {
                                        text: entry.link-path;
                                        font-size: 12px;
                                        color: text-3;
                                        overflow: elide;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                }

                                // Path: single line, vertically centered
                                if root.editing-note-id != entry.id && (entry.note == "" || (root.show-original-on-hover && item-ta.has-hover)) && entry.content-type == "path" : Text {
                                    text: entry.preview;
                                    font-size: 12px;
                                    color: text-1;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }

                                // File list: each file in its own pill; multi-file shows per-file OS icon
                                if root.editing-note-id != entry.id && (entry.note == "" || (root.show-original-on-hover && item-ta.has-hover)) && entry.content-type == "file" : VerticalLayout {
                                    spacing: 3px;
                                    alignment: start;

                                    if entry.file-name-1 != "" : Rectangle {
                                        border-radius: 4px;
                                        background: divider;

                                        HorizontalLayout {
                                            padding: 4px;
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            spacing: 4px;

                                            if entry.file-count > 1 : Rectangle {
                                                width: 14px;
                                                height: 14px;
                                                clip: true;
                                                background: transparent;

                                                if entry.file-icon-path != "" : Image {
                                                    width: 14px;
                                                    height: 14px;
                                                    source: entry.file-icon-image;
                                                    image-fit: contain;
                                                }

                                                if entry.file-icon-path == "" : Text {
                                                    x: (parent.width - self.width) / 2;
                                                    y: (parent.height - self.height) / 2;
                                                    text: "\u{e646}";
                                                    font-family: "iconfont";
                                                    font-size: 12px;
                                                    color: text-3;
                                                }
                                            }

                                            Text {
                                                text: entry.file-name-1;
                                                font-size: 10px;
                                                font-weight: 600;
                                                color: text-1;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    if entry.file-name-2 != "" : Rectangle {
                                        border-radius: 4px;
                                        background: divider;

                                        HorizontalLayout {
                                            padding: 4px;
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            spacing: 4px;

                                            if entry.file-count > 1 : Rectangle {
                                                width: 14px;
                                                height: 14px;
                                                clip: true;
                                                background: transparent;

                                                if entry.file-icon-path-2 != "" : Image {
                                                    width: 14px;
                                                    height: 14px;
                                                    source: entry.file-icon-image-2;
                                                    image-fit: contain;
                                                }

                                                if entry.file-icon-path-2 == "" : Text {
                                                    x: (parent.width - self.width) / 2;
                                                    y: (parent.height - self.height) / 2;
                                                    text: "\u{e646}";
                                                    font-family: "iconfont";
                                                    font-size: 12px;
                                                    color: text-3;
                                                }
                                            }

                                            Text {
                                                text: entry.file-name-2;
                                                font-size: 10px;
                                                font-weight: 600;
                                                color: text-1;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    if entry.file-name-3 != "" : Rectangle {
                                        border-radius: 4px;
                                        background: divider;

                                        HorizontalLayout {
                                            padding: 4px;
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            spacing: 4px;

                                            if entry.file-count > 1 : Rectangle {
                                                width: 14px;
                                                height: 14px;
                                                clip: true;
                                                background: transparent;

                                                if entry.file-icon-path-3 != "" : Image {
                                                    width: 14px;
                                                    height: 14px;
                                                    source: entry.file-icon-image-3;
                                                    image-fit: contain;
                                                }

                                                if entry.file-icon-path-3 == "" : Text {
                                                    x: (parent.width - self.width) / 2;
                                                    y: (parent.height - self.height) / 2;
                                                    text: "\u{e646}";
                                                    font-family: "iconfont";
                                                    font-size: 12px;
                                                    color: text-3;
                                                }
                                            }

                                            Text {
                                                text: entry.file-name-3;
                                                font-size: 10px;
                                                font-weight: 600;
                                                color: text-1;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    if entry.file-overflow > 0 : Text {
                                        text: "… 等" + entry.file-overflow + "个文件";
                                        font-size: 10px;
                                        color: text-3;
                                        vertical-alignment: center;
                                    }
                                }

                                // Other text types (plain, rich, color)
                                if root.editing-note-id != entry.id && (entry.note == "" || (root.show-original-on-hover && item-ta.has-hover)) && entry.content-type != "color" && entry.content-type != "image" && entry.content-type != "link" && entry.content-type != "path" && entry.content-type != "file" : Text {
                                    text: entry.preview;
                                    font-size: 12px;
                                    color: text-1;
                                    overflow: elide;
                                    wrap: word-wrap;
                                    vertical-alignment: top;
                                }

                                if root.editing-note-id != entry.id && (entry.note == "" || (root.show-original-on-hover && item-ta.has-hover)) && entry.content-type == "image" : Rectangle {
                                    border-radius: 6px;
                                    clip: true;
                                    background: accent-soft;

                                    if entry.image-path != "" : Image {
                                        width: parent.width;
                                        height: parent.height;
                                        source: entry.thumbnail;
                                        image-fit: cover;
                                    }

                                    if entry.image-path == "" : Text {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        text: "\u{e626}";
                                        font-family: "iconfont";
                                        font-size: 20px;
                                        color: accent;
                                    }
                                }

                            }

                            // ── 单选悬浮工具栏（选中数 <= 1 时显示） ──
                            if item-ta.has-hover && root.editing-note-id != entry.id && root.selected-count <= 1 : Rectangle {
                                x: parent.width - self.width - 4px;
                                y: 3px;
                                height: 22px;
                                width: tb-inner.preferred-width + 10px;
                                border-radius: 6px;
                                background: dark-mode ? #232425e8 : #ffffffe8;
                                border-width: 1px;
                                border-color: dark-mode ? #ffffff20 : #0000000c;

                                tb-inner := HorizontalLayout {
                                    x: 5px;
                                    y: (parent.height - self.height) / 2;
                                    spacing: 2px;

                                    // 复制按钮
                                    Rectangle {
                                        width: 18px;
                                        height: 18px;

                                        tb-copy-ta := TouchArea {
                                            width: parent.width;
                                            height: parent.height;
                                            pointer-event(event) => {
                                                if event.kind == PointerEventKind.down {
                                                    root.toolbar-action = true;
                                                }
                                            }
                                            clicked => {
                                                search-input.clear-focus();
                                                root.click-pending = false;
                                                root.toolbar-action = false;
                                                root.copy-item(entry.id);
                                            }
                                        }

                                        Text {
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            text: "\u{e600}";
                                            font-family: "iconfont";
                                            font-size: 12px;
                                            color: tb-copy-ta.has-hover ? accent : text-2;
                                        }
                                    }

                                    // 打开原图按钮（仅图片类型显示）
                                    if entry.content-type == "image" : Rectangle {
                                        width: 18px;
                                        height: 18px;

                                        open-img-ta := TouchArea {
                                            width: parent.width;
                                            height: parent.height;
                                            pointer-event(event) => {
                                                if event.kind == PointerEventKind.down {
                                                    root.toolbar-action = true;
                                                }
                                            }
                                            clicked => {
                                                search-input.clear-focus();
                                                root.click-pending = false;
                                                root.toolbar-action = false;
                                                root.open-original-image(entry.id);
                                            }
                                        }

                                        Text {
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            text: "\u{e626}";
                                            font-family: "iconfont";
                                            font-size: 12px;
                                            color: open-img-ta.has-hover ? accent : text-2;
                                        }
                                    }

                                    // 跳转按钮（链接、路径、文件类型显示）
                                    if entry.content-type == "link" || entry.content-type == "path" || entry.content-type == "file" : Rectangle {
                                        width: 18px;
                                        height: 18px;

                                        open-loc-ta := TouchArea {
                                            width: parent.width;
                                            height: parent.height;
                                            pointer-event(event) => {
                                                if event.kind == PointerEventKind.down {
                                                    root.toolbar-action = true;
                                                }
                                            }
                                            clicked => {
                                                search-input.clear-focus();
                                                root.click-pending = false;
                                                root.toolbar-action = false;
                                                root.open-item-location(entry.id);
                                            }
                                        }

                                        Text {
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            text: "\u{e6d7}";
                                            font-family: "iconfont";
                                            font-size: 12px;
                                            color: open-loc-ta.has-hover ? accent : text-2;
                                        }
                                    }

                                    // 编辑按钮（非图片和文件类型显示）
                                    if entry.content-type != "image" && entry.content-type != "file" : Rectangle {
                                        width: 18px;
                                        height: 18px;

                                        edit-ta := TouchArea {
                                            width: parent.width;
                                            height: parent.height;
                                            pointer-event(event) => {
                                                if event.kind == PointerEventKind.down {
                                                    root.toolbar-action = true;
                                                }
                                            }
                                            clicked => {
                                                search-input.clear-focus();
                                                root.click-pending = false;
                                                root.toolbar-action = false;
                                                root.edit-item(entry.id);
                                            }
                                        }

                                        Text {
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            text: "\u{e648}";
                                            font-family: "iconfont";
                                            font-size: 12px;
                                            color: edit-ta.has-hover ? accent : text-2;
                                        }
                                    }

                                    // 备注按钮
                                    Rectangle {
                                        width: 18px;
                                        height: 18px;

                                        note-ta := TouchArea {
                                            width: parent.width;
                                            height: parent.height;
                                            pointer-event(event) => {
                                                if event.kind == PointerEventKind.down {
                                                    root.toolbar-action = true;
                                                }
                                            }
                                            clicked => {
                                                search-input.clear-focus();
                                                root.click-pending = false;
                                                root.toolbar-action = false;
                                                root.editing-note-text = entry.note;
                                                root.editing-note-id = entry.id;
                                            }
                                        }

                                        Text {
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            text: "\u{e606}";
                                            font-family: "iconfont";
                                            font-size: 12px;
                                            color: note-ta.has-hover ? accent : text-2;
                                        }
                                    }

                                    // 收藏按钮
                                    Rectangle {
                                        width: 18px;
                                        height: 18px;

                                        fav-ta := TouchArea {
                                            width: parent.width;
                                            height: parent.height;
                                            pointer-event(event) => {
                                                if event.kind == PointerEventKind.down {
                                                    root.toolbar-action = true;
                                                }
                                            }
                                            clicked => {
                                                search-input.clear-focus();
                                                root.click-pending = false;
                                                root.toolbar-action = false;
                                                root.toggle-favorite(entry.id);
                                            }
                                        }

                                        Text {
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            text: entry.is-favorite ? "\u{e630}" : "\u{e68d}";
                                            font-family: "iconfont";
                                            font-size: 11px;
                                            color: entry.is-favorite ? fav-color : (fav-ta.has-hover ? fav-color : text-2);
                                        }
                                    }

                                    // 删除按钮
                                    Rectangle {
                                        width: 18px;
                                        height: 18px;

                                        del-ta := TouchArea {
                                            width: parent.width;
                                            height: parent.height;
                                            pointer-event(event) => {
                                                if event.kind == PointerEventKind.down {
                                                    root.toolbar-action = true;
                                                }
                                            }
                                            clicked => {
                                                search-input.clear-focus();
                                                root.click-pending = false;
                                                root.toolbar-action = false;
                                                root.delete-item(entry.id);
                                            }
                                        }

                                        Text {
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            text: "\u{e8b6}";
                                            font-family: "iconfont";
                                            font-size: 12px;
                                            color: del-ta.has-hover ? danger : text-2;
                                        }
                                    }
                                }
                            }

                            // ── 批量操作悬浮工具栏（选中数 > 1 且有选中项被悬停时显示） ──
                            if item-ta.has-hover && root.editing-note-id != entry.id && root.selected-count > 1 && entry.selected : Rectangle {
                                x: parent.width - self.width - 4px;
                                y: 3px;
                                height: 22px;
                                width: bb-inner.preferred-width + 10px;
                                border-radius: 6px;
                                background: dark-mode ? #232425e8 : #ffffffe8;
                                border-width: 1px;
                                border-color: dark-mode ? #ffffff20 : #0000000c;

                                bb-inner := HorizontalLayout {
                                    x: 5px;
                                    y: (parent.height - self.height) / 2;
                                    spacing: 2px;

                                    // 批量粘贴
                                    Rectangle {
                                        width: 18px;
                                        height: 18px;

                                        bb-paste-ta := TouchArea {
                                            width: parent.width;
                                            height: parent.height;
                                            pointer-event(event) => {
                                                if event.kind == PointerEventKind.down {
                                                    root.toolbar-action = true;
                                                }
                                            }
                                            clicked => {
                                                search-input.clear-focus();
                                                root.click-pending = false;
                                                root.toolbar-action = false;
                                                root.batch-paste();
                                            }
                                        }

                                        Text {
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            text: "\u{e600}";
                                            font-family: "iconfont";
                                            font-size: 12px;
                                            color: bb-paste-ta.has-hover ? accent : text-2;
                                        }
                                    }

                                    // 批量收藏
                                    Rectangle {
                                        width: 18px;
                                        height: 18px;

                                        bb-fav-ta := TouchArea {
                                            width: parent.width;
                                            height: parent.height;
                                            pointer-event(event) => {
                                                if event.kind == PointerEventKind.down {
                                                    root.toolbar-action = true;
                                                }
                                            }
                                            clicked => {
                                                search-input.clear-focus();
                                                root.click-pending = false;
                                                root.toolbar-action = false;
                                                root.batch-favorite();
                                            }
                                        }

                                        Text {
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            text: "\u{e630}";
                                            font-family: "iconfont";
                                            font-size: 11px;
                                            color: bb-fav-ta.has-hover ? fav-color : text-2;
                                        }
                                    }

                                    // 批量删除
                                    Rectangle {
                                        width: 18px;
                                        height: 18px;

                                        bb-del-ta := TouchArea {
                                            width: parent.width;
                                            height: parent.height;
                                            pointer-event(event) => {
                                                if event.kind == PointerEventKind.down {
                                                    root.toolbar-action = true;
                                                }
                                            }
                                            clicked => {
                                                search-input.clear-focus();
                                                root.click-pending = false;
                                                root.toolbar-action = false;
                                                root.batch-delete();
                                            }
                                        }

                                        Text {
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            text: "\u{e8b6}";
                                            font-family: "iconfont";
                                            font-size: 12px;
                                            color: bb-del-ta.has-hover ? danger : text-2;
                                        }
                                    }
                                }
                            }

                            // 收藏标记：左侧强调色竖条（始终可见）
                            if entry.is-favorite : Rectangle {
                                x: 0px;
                                y: 4px;
                                width: 3px;
                                height: parent.height - 8px;
                                border-radius: 2px;
                                background: fav-color;
                            }

                            // 选中序号徽章（置于顶层，缩小尺寸）
                            if entry.selected && root.selected-count > 1 : Rectangle {
                                x: 2px;
                                y: 2px;
                                width: 12px;
                                height: 12px;
                                border-radius: 3px;
                                background: accent;

                                Text {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    text: entry.selection-order + 1;
                                    font-size: 7px;
                                    font-weight: 700;
                                    color: #ffffff;
                                }
                            }

                            // 标签色块 + 悬浮时间标签
                            if root.editing-note-id != entry.id : HorizontalLayout {
                                x: parent.width - self.preferred-width - 10px;
                                y: parent.height - self.height - 6px;
                                height: 18px;
                                spacing: 4px;

                                // 标签名药丸（边框+文字为标签颜色，底板同时间标签）
                                if entry.has-tags && entry.tag-name-0 != "" : Rectangle {
                                    height: 18px;
                                    width: tag0-text.preferred-width + 10px;
                                    border-radius: 9px;
                                    background: dark-mode ? #232425e8 : #ffffffe8;
                                    border-width: 0.5px;
                                    border-color: dark-mode ? #ffffff20 : #0000001a;

                                    tag0-text := Text {
                                        x: 5px;
                                        y: (parent.height - self.height) / 2;
                                        text: entry.tag-name-0;
                                        font-size: 9px;
                                        color: entry.tag-dot-0;
                                        vertical-alignment: center;
                                    }
                                }

                                if entry.tag-name-1 != "" : Rectangle {
                                    height: 18px;
                                    width: tag1-text.preferred-width + 10px;
                                    border-radius: 9px;
                                    background: dark-mode ? #232425e8 : #ffffffe8;
                                    border-width: 0.5px;
                                    border-color: dark-mode ? #ffffff20 : #0000001a;

                                    tag1-text := Text {
                                        x: 5px;
                                        y: (parent.height - self.height) / 2;
                                        text: entry.tag-name-1;
                                        font-size: 9px;
                                        color: entry.tag-dot-1;
                                        vertical-alignment: center;
                                    }
                                }

                                if entry.tag-name-2 != "" : Rectangle {
                                    height: 18px;
                                    width: tag2-text.preferred-width + 10px;
                                    border-radius: 9px;
                                    background: dark-mode ? #232425e8 : #ffffffe8;
                                    border-width: 0.5px;
                                    border-color: dark-mode ? #ffffff20 : #0000001a;

                                    tag2-text := Text {
                                        x: 5px;
                                        y: (parent.height - self.height) / 2;
                                        text: entry.tag-name-2;
                                        font-size: 9px;
                                        color: entry.tag-dot-2;
                                        vertical-alignment: center;
                                    }
                                }

                                if entry.tags-overflow > 0 : Rectangle {
                                    height: 18px;
                                    width: overflow-text.preferred-width + 10px;
                                    border-radius: 9px;
                                    background: dark-mode ? #232425e8 : #ffffffe8;
                                    border-width: 1px;
                                    border-color: dark-mode ? #ffffff20 : #0000000c;

                                    overflow-text := Text {
                                        x: 5px;
                                        y: (parent.height - self.height) / 2;
                                        text: "+" + entry.tags-overflow;
                                        font-size: 9px;
                                        color: text-2;
                                        vertical-alignment: center;
                                    }
                                }

                                // 图片尺寸标签
                                if entry.content-type == "image" && entry.image-width > 0 : Rectangle {
                                    height: 18px;
                                    width: dims-text.preferred-width + 10px;
                                    border-radius: 9px;
                                    background: dark-mode ? #232425e8 : #ffffffe8;
                                    border-width: 1px;
                                    border-color: dark-mode ? #ffffff20 : #0000000c;

                                    dims-text := Text {
                                        text: entry.image-width + "×" + entry.image-height;
                                        font-size: 9px;
                                        color: text-2;
                                        x: 5px;
                                        vertical-alignment: center;
                                    }
                                }

                                // 悬浮时间标签
                                time-rect := Rectangle {
                                    height: 18px;
                                    width: time-text.preferred-width + 14px;
                                    border-radius: 9px;
                                    background: dark-mode ? #232425e8 : #ffffffe8;
                                    border-width: 1px;
                                    border-color: dark-mode ? #ffffff20 : #0000000c;

                                    time-text := Text {
                                        text: entry.time-label;
                                        font-size: 9px;
                                        color: text-2;
                                        x: 7px;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                        }
                    }
                }
        }
    }
}

