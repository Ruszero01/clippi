import { ListView } from "std-widgets.slint";
import { ClipboardEntry } from "types.slint";

export component ClipboardList inherits Rectangle {
    // ========== 输入属性 ==========
    in property <bool> dark-mode: false;
    in property <[ClipboardEntry]> items: [];
    in property <int> item-count: 0;

    // ========== 搜索 ==========
    in-out property <string> search-text: "";

    // ========== 筛选 ==========
    in-out property <bool> filter-plain-text: false;
    in-out property <bool> filter-rich-text: false;
    in-out property <bool> filter-image: false;
    in-out property <bool> filter-link: false;
    in property <string> card-height-mode: "medium";

    // ========== 双击检测 ==========
    in-out property <int> last-clicked-id: -1;
    in-out property <bool> click-pending: false;

    // ========== 回调 ==========
    callback copy-item(int);
    callback paste-item(int);
    callback toggle-filter(string);
    callback clear-filters();
    callback search-keyword(string);

    // ========== 主题色板 ==========
    property <color> surface:       dark-mode ? #181a26 : #ffffff;
    property <color> surface-hover: dark-mode ? #22243a : #f4f5fb;
    property <color> surface-press: dark-mode ? #2c2e4a : #ebedf5;
    property <color> text-1:        dark-mode ? #e6e9f2 : #1a1c2e;
    property <color> text-2:        dark-mode ? #8a8ea8 : #7c809a;
    property <color> text-3:        dark-mode ? #555874 : #b4b9ca;
    property <color> accent:        dark-mode ? #7ecba3 : #6ab890;
    property <color> accent-soft:   dark-mode ? #1a2e24 : #e8f5ee;
    property <color> divider:       dark-mode ? #262840 : #e6e8f0;
    property <color> btn-hover:     dark-mode ? #262840 : #f0f1f8;

    background: transparent;

    VerticalLayout {
        padding-top: 4px;
        padding-left: 8px;
        padding-right: 8px;
        padding-bottom: 8px;
        spacing: 4px;

        // ========== 搜索框 ==========
        Rectangle {
            height: 28px;
            border-radius: 10px;
            background: surface;
            border-width: 1px;
            border-color: divider;

            search-icon := Text {
                x: 10px;
                y: (parent.height - self.height) / 2;
                text: "\u{e688}";
                font-family: "iconfont";
                font-size: 14px;
                color: text-3;
            }

            search-input := TextInput {
                x: 32px;
                width: parent.width - 44px;
                y: (parent.height - self.preferred-height) / 2;
                font-size: 12px;
                color: text-1;
                single-line: true;
                text <=> root.search-text;
                edited => {
                    root.search-keyword(root.search-text);
                }
            }

            if root.search-text == "" : Text {
                x: 32px;
                y: (parent.height - self.height) / 2;
                text: "搜索剪贴板内容...";
                font-size: 12px;
                color: text-3;
            }
        }

        // ========== 筛选按钮栏 + 列表 ==========
        VerticalLayout {
                // ========== 筛选按钮栏 ==========
                HorizontalLayout {
                    spacing: 6px;
                    height: 22px;

                    // 文本
                    Rectangle {
                        width: ft-inner.preferred-width + 14px;
                        height: 22px;
                        border-radius: 5px;
                        background: root.filter-plain-text ? (dark-mode ? #7ecba322 : #6ab89022) : (ft-ta.has-hover ? btn-hover : transparent);

                        ft-ta := TouchArea {
                            width: parent.width;
                            height: parent.height;
                            clicked => { search-input.clear-focus(); root.toggle-filter("plain_text"); }
                        }

                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            spacing: 3px;
                            alignment: center;

                            Text {
                                text: "\u{e60e}";
                                font-family: "iconfont";
                                font-size: 11px;
                                color: root.filter-plain-text ? accent : text-2;
                                vertical-alignment: center;
                            }

                            ft-inner := Text {
                                text: "文本";
                                font-size: 11px;
                                font-weight: root.filter-plain-text ? 600 : 400;
                                color: root.filter-plain-text ? accent : text-2;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // 格式
                    Rectangle {
                        width: fr-inner.preferred-width + 14px;
                        height: 22px;
                        border-radius: 5px;
                        background: root.filter-rich-text ? (dark-mode ? #7ecba322 : #6ab89022) : (fr-ta.has-hover ? btn-hover : transparent);

                        fr-ta := TouchArea {
                            width: parent.width;
                            height: parent.height;
                            clicked => { search-input.clear-focus(); root.toggle-filter("rich_text"); }
                        }

                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            spacing: 3px;
                            alignment: center;

                            Text {
                                text: "\u{e6ae}";
                                font-family: "iconfont";
                                font-size: 12px;
                                color: root.filter-rich-text ? accent : text-2;
                                vertical-alignment: center;
                            }

                            fr-inner := Text {
                                text: "格式";
                                font-size: 11px;
                                font-weight: root.filter-rich-text ? 600 : 400;
                                color: root.filter-rich-text ? accent : text-2;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // 图片
                    Rectangle {
                        width: fi-inner.preferred-width + 14px;
                        height: 22px;
                        border-radius: 5px;
                        background: root.filter-image ? (dark-mode ? #7ecba322 : #6ab89022) : (fi-ta.has-hover ? btn-hover : transparent);

                        fi-ta := TouchArea {
                            width: parent.width;
                            height: parent.height;
                            clicked => { search-input.clear-focus(); root.toggle-filter("image"); }
                        }

                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            spacing: 3px;
                            alignment: center;

                            Text {
                                text: "\u{e626}";
                                font-family: "iconfont";
                                font-size: 11px;
                                color: root.filter-image ? accent : text-2;
                                vertical-alignment: center;
                            }

                            fi-inner := Text {
                                text: "图片";
                                font-size: 11px;
                                font-weight: root.filter-image ? 600 : 400;
                                color: root.filter-image ? accent : text-2;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // 链接
                    Rectangle {
                        width: fl-inner.preferred-width + 14px;
                        height: 22px;
                        border-radius: 5px;
                        background: root.filter-link ? (dark-mode ? #7ecba322 : #6ab89022) : (fl-ta.has-hover ? btn-hover : transparent);

                        fl-ta := TouchArea {
                            width: parent.width;
                            height: parent.height;
                            clicked => { search-input.clear-focus(); root.toggle-filter("link"); }
                        }

                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            spacing: 3px;
                            alignment: center;

                            Text {
                                text: "\u{e6d7}";
                                font-family: "iconfont";
                                font-size: 11px;
                                color: root.filter-link ? accent : text-2;
                                vertical-alignment: center;
                            }

                            fl-inner := Text {
                                text: "链接";
                                font-size: 11px;
                                font-weight: root.filter-link ? 600 : 400;
                                color: root.filter-link ? accent : text-2;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // 空状态
                if root.item-count == 0: VerticalLayout {
                    alignment: center;
                    height: 200px;
                    spacing: 6px;

                    Text {
                        text: "暂无剪贴板内容";
                        font-size: 13px;
                        color: text-2;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: "复制文本后将自动显示在这里";
                        font-size: 11px;
                        color: text-3;
                        horizontal-alignment: center;
                    }
                }

                // 剪贴板列表
                ListView {
                    for entry in root.items: VerticalLayout {
                        padding: 2px;

                        Rectangle {
                            height: 68px;
                            border-radius: 10px;
                            background: item-ta.pressed ? surface-press : item-ta.has-hover ? surface-hover : surface;
                            border-width: 1px;
                            border-color: divider;
                            clip: true;

                            drop-shadow-blur: 4px;
                            drop-shadow-color: dark-mode ? #00000040 : #00000012;
                            drop-shadow-offset-y: 1px;

                        item-ta := TouchArea {
                            width: parent.width - 32px;
                            height: parent.height;
                            clicked => {
                                search-input.clear-focus();
                                if (root.click-pending && root.last-clicked-id == entry.id) {
                                    root.click-pending = false;
                                    root.last-clicked-id = -1;
                                    root.paste-item(entry.id);
                                } else {
                                    root.last-clicked-id = entry.id;
                                    root.click-pending = true;
                                }
                            }
                        }

                        HorizontalLayout {
                            padding: 10px;
                            spacing: 10px;

                            // 纯文本图标
                            if entry.content-type == "plain_text": Rectangle {
                                width: 34px;
                                height: 34px;
                                border-radius: 9px;
                                background: accent-soft;

                                Text {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    text: "\u{e60e}";
                                    font-family: "iconfont";
                                    font-size: 18px;
                                    color: accent;
                                }
                            }

                            // 格式文本图标
                            if entry.content-type == "rich_text": Rectangle {
                                width: 34px;
                                height: 34px;
                                border-radius: 9px;
                                background: accent-soft;

                                Text {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    text: "\u{e6ae}";
                                    font-family: "iconfont";
                                    font-size: 18px;
                                    color: accent;
                                }
                            }

                            // 图片缩略图
                            if entry.content-type == "image" && entry.image-path != "": Rectangle {
                                width: 34px;
                                height: 34px;
                                border-radius: 9px;
                                clip: true;
                                background: accent-soft;

                                Image {
                                    width: parent.width;
                                    height: parent.height;
                                    source: entry.thumbnail;
                                    image-fit: contain;
                                }
                            }

                            // 图片图标 (无路径回退)
                            if entry.content-type == "image" && entry.image-path == "": Rectangle {
                                width: 34px;
                                height: 34px;
                                border-radius: 9px;
                                background: accent-soft;

                                Text {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    text: "\u{e626}";
                                    font-family: "iconfont";
                                    font-size: 18px;
                                    color: accent;
                                }
                            }

                            // 链接图标
                            if entry.content-type == "link": Rectangle {
                                width: 34px;
                                height: 34px;
                                border-radius: 9px;
                                background: accent-soft;

                                Text {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    text: "\u{e6d7}";
                                    font-family: "iconfont";
                                    font-size: 18px;
                                    color: accent;
                                }
                            }

                            // 内容预览
                            Text {
                                text: entry.preview;
                                font-size: 12px;
                                color: text-1;
                                overflow: elide;
                                wrap: word-wrap;
                                vertical-alignment: top;
                            }

                            // 复制按钮
                            Rectangle {
                                width: 28px;
                                height: 28px;

                                copy-ta := TouchArea {
                                    width: parent.width;
                                    height: parent.height;
                                    clicked => {
                                        search-input.clear-focus();
                                        root.click-pending = false;
                                        root.last-clicked-id = -1;
                                        root.copy-item(entry.id);
                                    }
                                }

                                Text {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    text: "\u{e6c5}";
                                    font-family: "iconfont";
                                    font-size: 14px;
                                    color: copy-ta.has-hover ? accent : text-3;
                                }
                            }
                            }

                            // 悬浮时间标签
                            Rectangle {
                                x: parent.width - self.width - 10px;
                                y: parent.height - self.height - 6px;
                                height: 18px;
                                width: time-text.preferred-width + 14px;
                                border-radius: 9px;
                                background: dark-mode ? #ffffff18 : #0000000d;

                                time-text := Text {
                                    text: entry.time-label;
                                    font-size: 9px;
                                    color: text-3;
                                    x: 7px;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
        }
    }
}

