import { TagPanelTheme } from "theme.slint";

export component AddBackendPanel inherits Rectangle {
    // 定位
    in property <length> container-w: 0px;
    in property <length> container-h: 0px;
    // 主题
    in property <bool> dark-mode: false;
    // 预设
    in property <string> preset-onedrive-path: "";
    in property <string> preset-icloud-path: "";
    // 编辑模式
    in property <bool> edit-mode: false;
    in property <string> edit-id: "";
    in-out property <string> edit-name: "";
    in-out property <string> edit-folder: "";
    in-out property <string> backend-type: "";
    in-out property <string> edit-webdav-url: "";
    in-out property <string> edit-webdav-username: "";
    in-out property <string> edit-webdav-password: "";

    // 回调
    callback hide-panel();
    callback add-backend(string, string);
    callback save-backend(string, string, string);
    callback pick-folder();
    callback add-webdav-backend(string, string, string, string);
    callback save-webdav-backend(string, string, string, string, string);
    callback test-webdav-connection(string, string, string);

    // 主题色板
    property <color> accent: TagPanelTheme.accent;
    property <color> text-1: TagPanelTheme.text-1;
    property <color> text-2: TagPanelTheme.text-2;
    property <color> text-3: TagPanelTheme.text-3;
    property <color> btn-hover: TagPanelTheme.btn-hover;
    property <color> surface: TagPanelTheme.surface;
    property <color> input-bg: TagPanelTheme.input-bg;
    property <color> sep-line: TagPanelTheme.sep-line;

    // 内部状态: 编辑模式直接进入表单
    property <int> _step: root.edit-mode
        ? (root.backend-type == "webdav" ? 2 : 1)
        : (root._selected-type == ""
            ? 0
            : (root._selected-type == "webdav" ? 2 : 1));
    property <string> _selected-type: root.backend-type;
    in-out property <bool> test-ok: false;
    in-out property <string> test-error: "";

    width: 304px;
    height: panel-content.preferred-height;
    x: clamp((container-w - self.width) / 2, 4px, container-w - self.width - 4px);
    y: clamp((container-h - self.height) / 2, 4px, container-h - self.height - 4px);
    border-radius: 8px;
    background: surface;
    opacity: 0.96;
    border-width: 1px;
    border-color: dark-mode ? #ffffff14 : #00000012;
    drop-shadow-blur: 16px;
    drop-shadow-color: #00000060;
    drop-shadow-offset-y: 4px;

    event-blocker := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { }
        scroll-event => { accept }
    }

    panel-content := VerticalLayout {
        padding: 12px;
        spacing: 8px;

        // ══════════════════════════════════════════
        // 标题行
        HorizontalLayout {
            height: 24px;
            alignment: space-between;

            HorizontalLayout {
                spacing: 6px;
                alignment: start;

                // 返回按钮（仅在非编辑模式的表单步骤显示）
                if root._step == 1 && !root.edit-mode : back-btn := Rectangle {
                    width: 22px;
                    height: 22px;
                    border-radius: 5px;
                    background: back-ta.has-hover ? btn-hover : transparent;

                    back-ta := TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => {
                            root._selected-type = "";
                        }
                    }

                    Text {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        text: "\u{e62b}";
                        font-family: "iconfont";
                        font-size: 12px;
                        color: back-ta.has-hover ? accent : text-2;
                    }
                }

                title-text := Text {
                    text: root.edit-mode ? @tr("Edit backend") :
                          (root._step == 0 ? @tr("Add backend") :
                           root._selected-type == "webdav" ? @tr("WebDAV") : @tr("Local Folder"));
                    font-size: 13px;
                    font-weight: 600;
                    color: text-1;
                    vertical-alignment: center;
                }
            }

            close-btn := Rectangle {
                width: 22px;
                height: 22px;
                border-radius: 5px;
                background: close-ta.has-hover ? (dark-mode ? #3e3f42 : btn-hover) : transparent;

                close-ta := TouchArea {
                    width: 100%;
                    height: 100%;
                    clicked => { root.hide-panel(); }
                }

                Text {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    text: "\u{e7b7}";
                    font-family: "iconfont";
                    font-size: 11px;
                    color: text-2;
                }
            }
        }

        // 分割线
        Rectangle {
            width: 100%;
            height: 1px;
            background: sep-line;
        }

        // ══════════════════════════════════════════
        // Step 0: 选择后端类型
        if root._step == 0 : VerticalLayout {
            padding: 4px;
            spacing: 8px;

            Text {
                text: @tr("Select backend type");
                font-size: 11px;
                font-weight: 600;
                color: text-2;
            }

            HorizontalLayout {
                spacing: 10px;

                // ── Local Folder 卡片 ──
                local-card := Rectangle {
                    width: parent.width / 2 - 5px;
                    height: 68px;
                    border-radius: 8px;
                    background: lc-ta.has-hover ? accent : btn-hover;
                    border-width: 1px;
                    border-color: lc-ta.has-hover ? accent : transparent;

                    lc-ta := TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => {
                            root._selected-type = "local_folder";
                        }
                    }

                    VerticalLayout {
                        padding: 10px;
                        spacing: 4px;

                        Text {
                            text: "\u{e60a}";
                            font-family: "iconfont";
                            font-size: 16px;
                            color: lc-ta.has-hover ? #ffffff : accent;
                        }
                        Text {
                            text: @tr("Local Folder");
                            font-size: 12px;
                            font-weight: 600;
                            color: lc-ta.has-hover ? #ffffff : text-1;
                        }
                        Text {
                            text: @tr("OneDrive, iCloud, etc.");
                            font-size: 10px;
                            color: lc-ta.has-hover ? #ffffffcc : text-3;
                        }
                    }
                }

                // ── WebDAV 卡片 ──
                wd-card := Rectangle {
                    width: parent.width / 2 - 5px;
                    height: 68px;
                    border-radius: 8px;
                    background: wd-ta.has-hover ? accent : btn-hover;
                    border-width: 1px;
                    border-color: wd-ta.has-hover ? accent : transparent;

                    wd-ta := TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => {
                            root._selected-type = "webdav";
                            if root.edit-name == "" {
                                root.edit-name = "WebDAV";
                            }
                        }
                    }

                    VerticalLayout {
                        padding: 10px;
                        spacing: 4px;

                        Text {
                            text: "\u{e7b1}";
                            font-family: "iconfont";
                            font-size: 16px;
                            color: wd-ta.has-hover ? #ffffff : accent;
                        }
                        Text {
                            text: @tr("WebDAV");
                            font-size: 12px;
                            font-weight: 600;
                            color: wd-ta.has-hover ? #ffffff : text-1;
                        }
                        Text {
                            text: @tr("NAS, Nextcloud, etc.");
                            font-size: 10px;
                            color: wd-ta.has-hover ? #ffffffcc : text-3;
                        }
                    }
                }
            }
        }

        // ══════════════════════════════════════════
        // Step 1: Local Folder 表单
        if root._step == 1 : VerticalLayout {
            spacing: 8px;

            // 预设按钮（仅添加模式）
            if !root.edit-mode : Text {
                text: @tr("Quick add");
                font-size: 11px;
                font-weight: 600;
                color: text-2;
            }

            if !root.edit-mode : HorizontalLayout {
                spacing: 8px;

                // OneDrive 预设
                if root.preset-onedrive-path != "" : Rectangle {
                    height: 34px;
                    border-radius: 7px;
                    background: od-ta.has-hover ? accent : btn-hover;
                    border-width: 1px;
                    border-color: od-selected ? accent : transparent;

                    property <bool> od-selected: panel-folder-input.text == root.preset-onedrive-path;

                    od-ta := TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => {
                            if panel-name-input.text == "" {
                                panel-name-input.text = "OneDrive";
                            }
                            panel-folder-input.text = root.preset-onedrive-path;
                        }
                    }

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 6px;
                        height: 34px;

                        Text {
                            text: "\u{e60a}";
                            font-family: "iconfont";
                            font-size: 14px;
                            color: od-ta.has-hover ? #ffffff : accent;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "OneDrive";
                            font-size: 12px;
                            font-weight: 600;
                            color: od-ta.has-hover ? #ffffff : text-1;
                            vertical-alignment: center;
                        }
                    }
                }

                // iCloud 预设
                if root.preset-icloud-path != "" : Rectangle {
                    height: 34px;
                    border-radius: 7px;
                    background: ic-ta.has-hover ? accent : btn-hover;
                    border-width: 1px;
                    border-color: ic-selected ? accent : transparent;

                    property <bool> ic-selected: panel-folder-input.text == root.preset-icloud-path;

                    ic-ta := TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => {
                            if panel-name-input.text == "" {
                                panel-name-input.text = "iCloud";
                            }
                            panel-folder-input.text = root.preset-icloud-path;
                        }
                    }

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 6px;
                        height: 34px;

                        Text {
                            text: "\u{e60a}";
                            font-family: "iconfont";
                            font-size: 14px;
                            color: ic-ta.has-hover ? #ffffff : accent;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "iCloud";
                            font-size: 12px;
                            font-weight: 600;
                            color: ic-ta.has-hover ? #ffffff : text-1;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // 预设下方分割线（仅添加模式）
            if !root.edit-mode : Rectangle {
                width: 100%;
                height: 1px;
                background: sep-line;
            }

            // 名称输入
            Text {
                text: @tr("Name");
                font-size: 11px;
                font-weight: 600;
                color: text-2;
            }

            Rectangle {
                height: 30px;
                border-radius: 6px;
                background: input-bg;

                panel-name-input := TextInput {
                    x: 8px;
                    y: (parent.height - self.preferred-height) / 2;
                    width: parent.width - 16px;
                    height: 16px;
                    color: text-1;
                    font-size: 11px;
                    vertical-alignment: center;
                    text <=> root.edit-name;
                }
            }

            // 目录路径
            Text {
                text: @tr("Folder");
                font-size: 11px;
                font-weight: 600;
                color: text-2;
            }

            HorizontalLayout {
                spacing: 6px;

                Rectangle {
                    height: 30px;
                    horizontal-stretch: 1;
                    border-radius: 6px;
                    background: input-bg;

                    panel-folder-input := TextInput {
                        x: 8px;
                        y: (parent.height - self.preferred-height) / 2;
                        width: parent.width - 16px;
                        height: 16px;
                        color: text-1;
                        font-size: 11px;
                        vertical-alignment: center;
                        text <=> root.edit-folder;
                    }
                }

                Rectangle {
                    height: 30px;
                    width: 52px;
                    border-radius: 6px;
                    background: pick-ta.has-hover ? accent : btn-hover;

                    pick-ta := TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => { root.pick-folder(); }
                    }

                    Text {
                        text: @tr("Browse");
                        font-size: 11px;
                        font-weight: 600;
                        color: pick-ta.has-hover ? #ffffff : accent;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            property <color> accent-soft: dark-mode ? #1a2e24 : #e8f5ee;

            // 添加按钮（添加模式）
            if !root.edit-mode : Rectangle {
                height: 34px;
                border-radius: 7px;
                background: add-ta.has-hover ? accent-soft : accent;

                add-ta := TouchArea {
                    width: 100%;
                    height: 100%;
                    clicked => {
                        if panel-name-input.text != "" && panel-folder-input.text != "" {
                            root.add-backend(panel-name-input.text, panel-folder-input.text);
                            root.edit-name = "";
                            root.edit-folder = "";
                            root.hide-panel();
                        }
                    }
                }

                Text {
                    text: @tr("Add backend");
                    font-size: 12px;
                    font-weight: 600;
                    color: add-ta.has-hover ? accent : #ffffff;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // 保存按钮（编辑模式）
            if root.edit-mode : Rectangle {
                height: 34px;
                border-radius: 7px;
                background: save-ta.has-hover ? accent-soft : accent;

                save-ta := TouchArea {
                    width: 100%;
                    height: 100%;
                    clicked => {
                        if panel-name-input.text != "" && panel-folder-input.text != "" {
                            root.save-backend(root.edit-id, panel-name-input.text, panel-folder-input.text);
                            root.edit-name = "";
                            root.edit-folder = "";
                            root.hide-panel();
                        }
                    }
                }

                Text {
                    text: @tr("Save");
                    font-size: 12px;
                    font-weight: 600;
                    color: save-ta.has-hover ? accent : #ffffff;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // ══════════════════════════════════════════
        // Step 2: WebDAV 表单
        if root._step == 2 : VerticalLayout {
            spacing: 8px;

            // URL 输入
            Text {
                text: @tr("Server URL");
                font-size: 11px;
                font-weight: 600;
                color: text-2;
            }

            Rectangle {
                height: 30px;
                border-radius: 6px;
                background: input-bg;

                wd-url-input := TextInput {
                    x: 8px;
                    y: (parent.height - self.preferred-height) / 2;
                    width: parent.width - 16px;
                    height: 16px;
                    color: text-1;
                    font-size: 11px;
                    vertical-alignment: center;
                    text <=> root.edit-webdav-url;
                }
            }

            // 名称输入
            Text {
                text: @tr("Name");
                font-size: 11px;
                font-weight: 600;
                color: text-2;
            }

            Rectangle {
                height: 30px;
                border-radius: 6px;
                background: input-bg;

                wd-name-input := TextInput {
                    x: 8px;
                    y: (parent.height - self.preferred-height) / 2;
                    width: parent.width - 16px;
                    height: 16px;
                    color: text-1;
                    font-size: 11px;
                    vertical-alignment: center;
                    text <=> root.edit-name;
                }
            }

            // 用户名
            Text {
                text: @tr("Username");
                font-size: 11px;
                font-weight: 600;
                color: text-2;
            }

            Rectangle {
                height: 30px;
                border-radius: 6px;
                background: input-bg;

                wd-user-input := TextInput {
                    x: 8px;
                    y: (parent.height - self.preferred-height) / 2;
                    width: parent.width - 16px;
                    height: 16px;
                    color: text-1;
                    font-size: 11px;
                    vertical-alignment: center;
                    text <=> root.edit-webdav-username;
                }
            }

            // 密码
            Text {
                text: @tr("Password");
                font-size: 11px;
                font-weight: 600;
                color: text-2;
            }

            Rectangle {
                height: 30px;
                border-radius: 6px;
                background: input-bg;

                wd-pass-input := TextInput {
                    x: 8px;
                    y: (parent.height - self.preferred-height) / 2;
                    width: parent.width - 16px;
                    height: 16px;
                    color: text-1;
                    font-size: 11px;
                    vertical-alignment: center;
                    input-type: password;
                    text <=> root.edit-webdav-password;
                }
            }

            // 错误提示
            if root.test-error != "" : Text {
                text: root.test-error;
                font-size: 11px;
                font-weight: 600;
                color: #FF5252;
            }

            property <color> accent-soft: dark-mode ? #1a2e24 : #e8f5ee;

            // 测试连接 / 添加保存 按钮
            if !root.test-ok : Rectangle {
                height: 34px;
                border-radius: 7px;
                background: wd-test-ta.has-hover ? accent-soft : accent;

                wd-test-ta := TouchArea {
                    width: 100%;
                    height: 100%;
                    clicked => {
                        if wd-url-input.text != "" {
                            root.test-ok = false;
                            root.test-error = "";
                            root.test-webdav-connection(wd-url-input.text, wd-user-input.text, wd-pass-input.text);
                        }
                    }
                }

                Text {
                    text: @tr("Test connection");
                    font-size: 12px;
                    font-weight: 600;
                    color: wd-test-ta.has-hover ? accent : #ffffff;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // 连接成功 — 添加按钮
            if root.test-ok && !root.edit-mode : Rectangle {
                height: 34px;
                border-radius: 7px;
                background: wd-add-ta.has-hover ? accent-soft : #4CAF50;

                wd-add-ta := TouchArea {
                    width: 100%;
                    height: 100%;
                    clicked => {
                        if wd-name-input.text != "" && wd-url-input.text != "" {
                            root.add-webdav-backend(wd-name-input.text, wd-url-input.text, wd-user-input.text, wd-pass-input.text);
                            root.test-ok = false;
                            root.test-error = "";
                            root.edit-name = "";
                            root.edit-webdav-url = "";
                            root.edit-webdav-username = "";
                            root.edit-webdav-password = "";
                            root.hide-panel();
                        }
                    }
                }

                Text {
                    text: @tr("Add backend");
                    font-size: 12px;
                    font-weight: 600;
                    color: wd-add-ta.has-hover ? accent : #ffffff;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // 连接成功 — 保存按钮
            if root.test-ok && root.edit-mode : Rectangle {
                height: 34px;
                border-radius: 7px;
                background: wd-save-ta.has-hover ? accent-soft : #4CAF50;

                wd-save-ta := TouchArea {
                    width: 100%;
                    height: 100%;
                    clicked => {
                        if wd-name-input.text != "" && wd-url-input.text != "" {
                            root.save-webdav-backend(root.edit-id, wd-name-input.text, wd-url-input.text, wd-user-input.text, wd-pass-input.text);
                            root.test-ok = false;
                            root.test-error = "";
                            root.edit-name = "";
                            root.edit-webdav-url = "";
                            root.edit-webdav-username = "";
                            root.edit-webdav-password = "";
                            root.hide-panel();
                        }
                    }
                }

                Text {
                    text: @tr("Save");
                    font-size: 12px;
                    font-weight: 600;
                    color: wd-save-ta.has-hover ? accent : #ffffff;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}
