// Shared theme colors for floating panels (TagFilterPanel, TagPickerPanel)
export global TagPanelTheme {
    in property <bool> dark-mode: false;
    out property <color> accent: dark-mode ? #7ecba3 : #6ab890;
    out property <color> text-1: dark-mode ? #eaebec : #1a1c2e;
    out property <color> text-2: dark-mode ? #919496 : #7c809a;
    out property <color> text-3: dark-mode ? #5f6163 : #a0a3c0;
    out property <color> btn-hover: dark-mode ? #2b2c2d : #f0f1f8;
    out property <color> surface: dark-mode ? #2c2d2e : #ffffff;
    out property <color> input-bg: dark-mode ? #1e1f20 : #f5f6fc;
    out property <color> sep-line: dark-mode ? #ffffff0d : #00000010;
    out property <color> danger: #ff5f57;
}
