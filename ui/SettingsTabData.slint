export component SettingsTabData inherits Rectangle {
    in property <bool> dark-mode: false;
    in property <string> db-path: "";
    in property <string> settings-error: "";
    in property <int> max-items: 0;

    callback pick-db-path();
    callback reset-db-path();
    callback set-max-items(int);
    in-out property <string> max-items-text: root.max-items == 0 ? "" : root.max-items;

    property <color> surface:       dark-mode ? #232425 : #ffffff;
    property <color> text-1:       dark-mode ? #eaebec : #1a1c2e;
    property <color> text-2:       dark-mode ? #919496 : #7c809a;
    property <color> text-3:       dark-mode ? #5f6264 : #b4b9ca;
    property <color> accent:       dark-mode ? #7ecba3 : #6ab890;
    property <color> accent-soft:  dark-mode ? #1a2e24 : #e8f5ee;
    property <color> divider:      dark-mode ? #2b2c2d : #e6e8f0;

    background: transparent;

    VerticalLayout {
        spacing: 12px;
        padding-top: 8px;

        // 数据库路径
        Rectangle {
            height: 76px;
            border-radius: 10px;
            background: surface;
            border-width: 1px;
            border-color: divider;

            VerticalLayout {
                width: parent.width;
                height: parent.height;
                padding: 14px;
                spacing: 6px;

                Text {
                    text: @tr("Database path");
                    font-size: 12px;
                    font-weight: 600;
                    color: text-1;
                }

                HorizontalLayout {
                    spacing: 6px;

                    Rectangle {
                        height: 28px;
                        border-radius: 7px;
                        background: dark-mode ? #191a1b : #f2f3f8;

                        Text {
                            text: root.db-path;
                            font-size: 10px;
                            color: text-2;
                            vertical-alignment: center;
                            x: 10px;
                            overflow: elide;
                            width: parent.width - 20px;
                        }
                    }

                    Rectangle {
                        height: 28px;
                        width: 52px;
                        border-radius: 7px;
                        background: change-ta.has-hover ? accent-soft : accent;

                        change-ta := TouchArea {
                            width: parent.width;
                            height: parent.height;
                            clicked => { root.pick-db-path(); }
                        }

                        Text {
                            text: @tr("Change");
                            font-size: 11px;
                            font-weight: 600;
                            color: change-ta.has-hover ? accent : #ffffff;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        height: 28px;
                        width: 52px;
                        border-radius: 7px;
                        background: reset-ta.has-hover ? surface : transparent;
                        border-width: 1px;
                        border-color: text-3;

                        reset-ta := TouchArea {
                            width: parent.width;
                            height: parent.height;
                            clicked => { root.reset-db-path(); }
                        }

                        Text {
                            text: @tr("Reset");
                            font-size: 11px;
                            font-weight: 600;
                            color: reset-ta.has-hover ? text-1 : text-3;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // 最大保存条目数
        Rectangle {
            height: 66px;
            border-radius: 10px;
            background: surface;
            border-width: 1px;
            border-color: divider;

            HorizontalLayout {
                width: parent.width;
                height: parent.height;
                padding: 14px;
                alignment: space-between;

                VerticalLayout {
                    spacing: 2px;
                    alignment: center;

                    Text {
                        text: @tr("Max items");
                        font-size: 12px;
                        font-weight: 600;
                        color: text-1;
                    }

                    Text {
                        text: @tr("Set to 0 for unlimited items");
                        font-size: 10px;
                        color: text-3;
                    }
                }

                Rectangle {
                    height: 28px;
                    width: 80px;
                    border-radius: 7px;
                    background: dark-mode ? #191a1b : #f2f3f8;
                    border-width: 1px;
                    border-color: input-focus.has-focus ? accent : divider;
                    y: (parent.height - self.height) / 2;

                    input-focus := FocusScope {
                        width: 100%;

                        max-items-input := TextInput {
                            text <=> root.max-items-text;
                            font-size: 12px;
                            color: text-1;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                            input-type: number;
                            width: parent.width - 16px;
                            accepted => {
                                root.set-max-items(root.max-items-text.to-float());
                                self.clear-focus();
                            }
                            changed has-focus => {
                                if !self.has-focus {
                                    root.set-max-items(root.max-items-text.to-float());
                                }
                            }
                        }
                    }

                    Text {
                        text: @tr("Unlimited");
                        font-size: 12px;
                        color: text-3;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                        width: 100%;
                        height: 100%;
                        visible: root.max-items-text == "" && !max-items-input.has-focus;
                    }
                }
            }
        }
    }
}
