export component SettingsTabGeneral inherits Rectangle {
    in property <bool> dark-mode: false;
    in property <int> theme-mode: 0;
    in property <bool> auto-start: false;
    in property <bool> auto-hide: false;
    in property <int> position-mode: 0;

    callback toggle-auto-start();
    callback toggle-auto-hide();
    callback set-theme(int);
    callback set-position-mode(int);

    property <color> surface:       dark-mode ? #232425 : #ffffff;
    property <color> text-1:       dark-mode ? #eaebec : #1a1c2e;
    property <color> text-2:       dark-mode ? #919496 : #7c809a;
    property <color> text-3:       dark-mode ? #5f6264 : #b4b9ca;
    property <color> accent:       dark-mode ? #7ecba3 : #6ab890;
    property <color> accent-soft:  dark-mode ? #1a2e24 : #e8f5ee;
    property <color> divider:      dark-mode ? #2b2c2d : #e6e8f0;

    background: transparent;

    VerticalLayout {
        spacing: 12px;
        padding-top: 8px;

        // 开机自启动
        Rectangle {
            height: 66px;
            border-radius: 10px;
            background: surface;
            border-width: 1px;
            border-color: divider;

            HorizontalLayout {
                width: parent.width;
                height: parent.height;
                padding: 14px;
                alignment: space-between;

                VerticalLayout {
                    spacing: 2px;
                    alignment: center;

                    Text {
                        text: "开机自启动";
                        font-size: 12px;
                        font-weight: 600;
                        color: text-1;
                    }

                    Text {
                        text: "系统启动时自动运行 Clippi";
                        font-size: 10px;
                        color: text-3;
                    }
                }

                Rectangle {
                    width: 40px;
                    height: 22px;
                    border-radius: 11px;
                    background: root.auto-start ? accent : divider;
                    animate background { duration: 200ms; easing: ease-out; }
                    y: (parent.height - self.height) / 2;

                    Rectangle {
                        width: 18px;
                        height: 18px;
                        border-radius: 9px;
                        background: #ffffff;
                        x: root.auto-start ? parent.width - self.width - 2px : 2px;
                        animate x { duration: 200ms; easing: ease-out; }
                        y: (parent.height - self.height) / 2;
                    }

                    toggle-ta := TouchArea {
                        width: parent.width;
                        height: parent.height;
                        clicked => { root.toggle-auto-start(); }
                    }
                }
            }
        }

        // 失焦自动隐藏
        Rectangle {
            height: 66px;
            border-radius: 10px;
            background: surface;
            border-width: 1px;
            border-color: divider;

            HorizontalLayout {
                width: parent.width;
                height: parent.height;
                padding: 14px;
                alignment: space-between;

                VerticalLayout {
                    spacing: 2px;
                    alignment: center;

                    Text {
                        text: "失焦自动隐藏";
                        font-size: 12px;
                        font-weight: 600;
                        color: text-1;
                    }

                    Text {
                        text: "点击窗口外部时自动隐藏";
                        font-size: 10px;
                        color: text-3;
                    }
                }

                Rectangle {
                    width: 40px;
                    height: 22px;
                    border-radius: 11px;
                    background: root.auto-hide ? accent : divider;
                    animate background { duration: 200ms; easing: ease-out; }
                    y: (parent.height - self.height) / 2;

                    Rectangle {
                        width: 18px;
                        height: 18px;
                        border-radius: 9px;
                        background: #ffffff;
                        x: root.auto-hide ? parent.width - self.width - 2px : 2px;
                        animate x { duration: 200ms; easing: ease-out; }
                        y: (parent.height - self.height) / 2;
                    }

                    autohide-ta := TouchArea {
                        width: parent.width;
                        height: parent.height;
                        clicked => { root.toggle-auto-hide(); }
                    }
                }
            }
        }

        // 主题设置
        Rectangle {
            height: 66px;
            border-radius: 10px;
            background: surface;
            border-width: 1px;
            border-color: divider;

            HorizontalLayout {
                width: parent.width;
                height: parent.height;
                padding: 14px;
                alignment: space-between;

                VerticalLayout {
                    spacing: 2px;
                    alignment: center;

                    Text {
                        text: "外观";
                        font-size: 12px;
                        font-weight: 600;
                        color: text-1;
                    }

                    Text {
                        text: "选择应用的主题模式";
                        font-size: 10px;
                        color: text-3;
                    }
                }

                HorizontalLayout {
                    spacing: 4px;
                    alignment: center;
                    y: (parent.height - self.height) / 2;

                    Rectangle {
                        width: 56px;
                        height: 26px;
                        border-radius: 7px;
                        background: root.theme-mode == 0 ? accent-soft : transparent;
                        border-width: 1px;
                        border-color: root.theme-mode == 0 ? accent : divider;

                        sys-ta := TouchArea {
                            width: parent.width;
                            height: parent.height;
                            clicked => { root.set-theme(0); }
                        }

                        Text {
                            text: "跟随系统";
                            font-size: 9px;
                            font-weight: 600;
                            color: root.theme-mode == 0 ? accent : text-3;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        width: 40px;
                        height: 26px;
                        border-radius: 7px;
                        background: root.theme-mode == 2 ? accent-soft : transparent;
                        border-width: 1px;
                        border-color: root.theme-mode == 2 ? accent : divider;

                        light-ta := TouchArea {
                            width: parent.width;
                            height: parent.height;
                            clicked => { root.set-theme(2); }
                        }

                        Text {
                            text: "亮色";
                            font-size: 9px;
                            font-weight: 600;
                            color: root.theme-mode == 2 ? accent : text-3;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        width: 40px;
                        height: 26px;
                        border-radius: 7px;
                        background: root.theme-mode == 1 ? accent-soft : transparent;
                        border-width: 1px;
                        border-color: root.theme-mode == 1 ? accent : divider;

                        dark-ta := TouchArea {
                            width: parent.width;
                            height: parent.height;
                            clicked => { root.set-theme(1); }
                        }

                        Text {
                            text: "暗色";
                            font-size: 9px;
                            font-weight: 600;
                            color: root.theme-mode == 1 ? accent : text-3;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // 窗口位置设置
        Rectangle {
            height: 66px;
            border-radius: 10px;
            background: surface;
            border-width: 1px;
            border-color: divider;

            HorizontalLayout {
                width: parent.width;
                height: parent.height;
                padding: 14px;
                alignment: space-between;

                VerticalLayout {
                    spacing: 2px;
                    alignment: center;

                    Text {
                        text: "窗口位置";
                        font-size: 12px;
                        font-weight: 600;
                        color: text-1;
                    }

                    Text {
                        text: "选择窗口呼出时的位置";
                        font-size: 10px;
                        color: text-3;
                    }
                }

                HorizontalLayout {
                    spacing: 4px;
                    alignment: center;
                    y: (parent.height - self.height) / 2;

                    Rectangle {
                        width: 40px;
                        height: 26px;
                        border-radius: 7px;
                        background: root.position-mode == 0 ? accent-soft : transparent;
                        border-width: 1px;
                        border-color: root.position-mode == 0 ? accent : divider;

                        center-ta := TouchArea {
                            width: parent.width;
                            height: parent.height;
                            clicked => { root.set-position-mode(0); }
                        }

                        Text {
                            text: "居中";
                            font-size: 9px;
                            font-weight: 600;
                            color: root.position-mode == 0 ? accent : text-3;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        width: 56px;
                        height: 26px;
                        border-radius: 7px;
                        background: root.position-mode == 1 ? accent-soft : transparent;
                        border-width: 1px;
                        border-color: root.position-mode == 1 ? accent : divider;

                        follow-ta := TouchArea {
                            width: parent.width;
                            height: parent.height;
                            clicked => { root.set-position-mode(1); }
                        }

                        Text {
                            text: "跟随鼠标";
                            font-size: 9px;
                            font-weight: 600;
                            color: root.position-mode == 1 ? accent : text-3;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        width: 56px;
                        height: 26px;
                        border-radius: 7px;
                        background: root.position-mode == 2 ? accent-soft : transparent;
                        border-width: 1px;
                        border-color: root.position-mode == 2 ? accent : divider;

                        remember-ta := TouchArea {
                            width: parent.width;
                            height: parent.height;
                            clicked => { root.set-position-mode(2); }
                        }

                        Text {
                            text: "记住位置";
                            font-size: 9px;
                            font-weight: 600;
                            color: root.position-mode == 2 ? accent : text-3;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
