import { TagItem } from "types.slint";
import { ScrollView } from "std-widgets.slint";
import { TagPanelTheme } from "theme.slint";
import { TagEditPanel } from "TagEditPanel.slint";

export component TagPickerPanel inherits Rectangle {
    // 定位
    in property <length> panel-x: 0px;
    in property <length> panel-y: 0px;
    in property <length> container-w: 0px;
    in property <length> container-h: 0px;
    // 主题
    in property <bool> dark-mode: false;
    // 数据
    in-out property <[TagItem]> all-tags: [];
    in property <bool> is-batch: false;

    // 回调
    callback hide-picker();
    callback create-and-add-tag(string);
    callback toggle-item-tag(int);
    callback batch-add-tag(int);
    callback batch-remove-tag(int);
    callback clear-all-tags();
    callback delete-tag(int);
    callback update-tag(int, string, color);

    // 编辑状态
    in-out property <int> editing-tag-id: -1;
    in-out property <string> editing-tag-name: "";
    in-out property <color> editing-tag-color: #3B82F6;

    // 主题色板 (delegated to shared global)
    property <color> accent: TagPanelTheme.accent;
    property <color> text-1: TagPanelTheme.text-1;
    property <color> text-2: TagPanelTheme.text-2;
    property <color> text-3: TagPanelTheme.text-3;
    property <color> btn-hover: TagPanelTheme.btn-hover;
    property <color> surface: TagPanelTheme.surface;
    property <color> input-bg: TagPanelTheme.input-bg;
    property <color> danger: TagPanelTheme.danger;
    property <color> sep-line: TagPanelTheme.sep-line;

    width: 304px;
    height: panel-content.preferred-height;
    x: (container-w - self.width) / 2;
    y: clamp(panel-y, 4px, container-h - self.height - 4px);
    border-radius: 8px;
    background: surface;
    opacity: 0.96;
    border-width: 1px;
    border-color: dark-mode ? #ffffff14 : #00000012;
    drop-shadow-blur: 16px;
    drop-shadow-color: #00000060;
    drop-shadow-offset-y: 4px;

    // 阻断鼠标事件穿透到下层 UI
    event-blocker := TouchArea {
        width: 100%;
        height: 100%;
        scroll-event => { accept }
    }

    panel-content := VerticalLayout {
        padding: 8px;
        spacing: 4px;

        // 标题行
        HorizontalLayout {
            height: 24px;
            alignment: space-between;

            Text {
                text: root.is-batch ? @tr("Batch tag") : @tr("Tag");
                font-size: 13px;
                font-weight: 600;
                color: text-1;
                vertical-alignment: center;
            }

            HorizontalLayout {
                spacing: 2px;

                // 清除所有标签
                clear-btn := Rectangle {
                    width: 22px;
                    height: 22px;
                    border-radius: 5px;
                    background: clear-ta.has-hover ? (dark-mode ? #3e3f42 : btn-hover) : transparent;

                    clear-ta := TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => { root.clear-all-tags(); }
                    }

                    Text {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        text: "\u{e607}";
                        font-family: "iconfont";
                        font-size: 11px;
                        color: text-2;
                    }
                }

                close-btn := Rectangle {
                    width: 22px;
                    height: 22px;
                    border-radius: 5px;
                    background: close-ta.has-hover ? (dark-mode ? #3e3f42 : btn-hover) : transparent;

                    close-ta := TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => { root.hide-picker(); }
                    }

                    Text {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        text: "\u{e7b7}";
                        font-family: "iconfont";
                        font-size: 11px;
                        color: text-2;
                    }
                }
            }
        }

        // 分割线
        Rectangle {
            width: 100%;
            height: 1px;
            background: sep-line;
        }

        // 快速新建标签
        HorizontalLayout {
            height: 26px;
            spacing: 4px;

            Rectangle {
                width: parent.width - 30px;
                height: 26px;
                border-radius: 5px;
                background: input-bg;

                picker-input := TextInput {
                    x: 6px;
                    y: (parent.height - self.preferred-height) / 2;
                    width: parent.width - 12px;
                    height: 16px;
                    color: text-1;
                    font-size: 11px;
                    letter-spacing: 0.5px;
                    horizontal-alignment: left;
                    vertical-alignment: center;
                    accepted => {
                        if picker-input.text != "" {
                            root.create-and-add-tag(picker-input.text);
                            picker-input.text = "";
                        }
                    }
                }
            }

            Rectangle {
                width: 26px;
                height: 26px;
                border-radius: 5px;
                background: create-btn-ta.has-hover ? accent : btn-hover;

                create-btn-ta := TouchArea {
                    width: 100%;
                    height: 100%;
                    clicked => {
                        if picker-input.text != "" {
                            root.create-and-add-tag(picker-input.text);
                            picker-input.text = "";
                        }
                    }
                }

                Text {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    text: "+";
                    font-size: 14px;
                    font-weight: 600;
                    color: create-btn-ta.has-hover ? #ffffff : accent;
                }
            }
        }

        // 分割线
        Rectangle {
            width: 100%;
            height: 1px;
            background: sep-line;
        }

        // 已有标签列表（固定高度 + 滚动，双列网格布局）
        ScrollView {
            height: 166px;
            viewport-width: 288px;
            viewport-height: tag-list-container.preferred-height;

            tag-list-container := VerticalLayout {
                if root.all-tags.length > 0 : GridLayout {
                    spacing: 4px;

                    for tag[idx] in root.all-tags: Rectangle {
                        col: Math.mod(idx, 2);
                        row: idx / 2;
                        width: 140px;
                        height: 30px;
                        border-radius: 5px;
                        background: tag.checked ? (dark-mode ? #7ecba318 : #6ab89018) : (row-ta.has-hover ? (dark-mode ? #3e3f42 : btn-hover) : transparent);

                        row-ta := TouchArea {
                            width: parent.width - 40px;
                            height: 100%;
                            clicked => {
                                if root.is-batch {
                                    if tag.checked {
                                        root.batch-remove-tag(tag.id);
                                    } else {
                                        root.batch-add-tag(tag.id);
                                    }
                                } else {
                                    root.toggle-item-tag(tag.id);
                                }
                            }
                        }

                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 4px;
                            spacing: 4px;
                            height: 30px;
                            alignment: start;

                            Rectangle {
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                y: 11px;
                                background: tag.color;
                            }

                            Text {
                                text: tag.name;
                                font-size: 11px;
                                color: tag.checked ? accent : text-1;
                                font-weight: tag.checked ? 600 : 400;
                                vertical-alignment: center;
                                overflow: elide;
                                y: 0px;
                            }
                        }

                        edit-btn := Rectangle {
                            x: parent.width - 40px;
                            width: 18px;
                            height: 18px;
                            y: 6px;
                            border-radius: 4px;
                            background: edit-ta.has-hover ? (dark-mode ? #3e3f42 : btn-hover) : transparent;

                            edit-ta := TouchArea {
                                width: 100%;
                                height: 100%;
                                clicked => {
                                    root.editing-tag-id = tag.id;
                                    root.editing-tag-name = tag.name;
                                    root.editing-tag-color = tag.color;
                                }
                            }

                            Text {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                text: "\u{e648}";
                                font-family: "iconfont";
                                font-size: 11px;
                                color: edit-ta.has-hover ? text-1 : text-3;
                            }
                        }

                        del-btn := Rectangle {
                            x: parent.width - 22px;
                            width: 18px;
                            height: 18px;
                            y: 6px;
                            border-radius: 4px;
                            background: del-ta.has-hover ? (dark-mode ? #ff5f5720 : #ff5f5710) : transparent;

                            del-ta := TouchArea {
                                width: 100%;
                                height: 100%;
                                clicked => { root.delete-tag(tag.id); }
                            }

                            Text {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                text: "\u{e8b6}";
                                font-family: "iconfont";
                                font-size: 12px;
                                color: del-ta.has-hover ? danger : text-3;
                            }
                        }
                    }
                }

                // 空状态
                if root.all-tags.length == 0 : VerticalLayout {
                    padding-left: 6px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    Text {
                        text: @tr("No tags. Create one above");
                        font-size: 11px;
                        color: text-3;
                    }
                }
            }
        }
    }

    // 编辑标签覆盖层
    if root.editing-tag-id >= 0 : TagEditPanel {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        dark-mode: root.dark-mode;
        tag-name <=> root.editing-tag-name;
        tag-color <=> root.editing-tag-color;

        cancel => {
            root.editing-tag-id = -1;
            root.editing-tag-name = "";
        }

        save(name, color) => {
            root.update-tag(root.editing-tag-id, name, color);
            root.editing-tag-id = -1;
            root.editing-tag-name = "";
        }
    }
}
