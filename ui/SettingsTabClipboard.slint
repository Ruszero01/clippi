export component SettingsTabClipboard inherits Rectangle {
    in property <bool> dark-mode: false;
    in property <bool> sort-by-created: false;
    in property <string> card-height-mode: "medium";
    in property <bool> show-source-app: false;
    in property <bool> auto-scroll-to-top: false;
    in property <bool> copy-as-plain-text: false;
    in property <bool> show-original-on-hover: false;

    callback toggle-sort-by-created();
    callback set-card-height-mode(string);
    callback toggle-show-source-app();
    callback toggle-auto-scroll-to-top();
    callback toggle-copy-as-plain-text();
    callback toggle-show-original-on-hover();

    property <color> surface:       dark-mode ? #232425 : #ffffff;
    property <color> text-1:       dark-mode ? #eaebec : #1a1c2e;
    property <color> text-2:       dark-mode ? #919496 : #7c809a;
    property <color> text-3:       dark-mode ? #5f6264 : #b4b9ca;
    property <color> accent:       dark-mode ? #7ecba3 : #6ab890;
    property <color> divider:      dark-mode ? #2b2c2d : #e6e8f0;

    background: transparent;

    VerticalLayout {
        spacing: 12px;
        padding-top: 8px;

        // 按创建时间排序
        Rectangle {
            height: 66px;
            border-radius: 10px;
            background: surface;
            border-width: 1px;
            border-color: divider;

            HorizontalLayout {
                width: parent.width;
                height: parent.height;
                padding: 14px;
                alignment: space-between;

                VerticalLayout {
                    spacing: 2px;
                    alignment: center;

                    Text {
                        text: "按创建时间排序";
                        font-size: 12px;
                        font-weight: 600;
                        color: text-1;
                    }

                    Text {
                        text: root.sort-by-created ? "首次创建时间排序" : "最后修改时间排序";
                        font-size: 10px;
                        color: text-3;
                    }
                }

                Rectangle {
                    width: 40px;
                    height: 22px;
                    border-radius: 11px;
                    background: root.sort-by-created ? accent : divider;
                    animate background { duration: 200ms; easing: ease-out; }
                    y: (parent.height - self.height) / 2;

                    Rectangle {
                        width: 18px;
                        height: 18px;
                        border-radius: 9px;
                        background: #ffffff;
                        x: root.sort-by-created ? parent.width - self.width - 2px : 2px;
                        animate x { duration: 200ms; easing: ease-out; }
                        y: (parent.height - self.height) / 2;
                    }

                    sortcreated-ta := TouchArea {
                        width: parent.width;
                        height: parent.height;
                        clicked => { root.toggle-sort-by-created(); }
                    }
                }
            }
        }

        // 卡片高度
        Rectangle {
            height: 66px;
            border-radius: 10px;
            background: surface;
            border-width: 1px;
            border-color: divider;

            HorizontalLayout {
                width: parent.width;
                height: parent.height;
                padding: 14px;
                alignment: space-between;

                VerticalLayout {
                    spacing: 2px;

                    Text {
                        text: "卡片高度";
                        font-size: 12px;
                        font-weight: 600;
                        color: text-1;
                    }

                    Text {
                        text: "调整列表卡片的高度";
                        font-size: 10px;
                        color: text-3;
                    }
                }

                HorizontalLayout {
                    spacing: 6px;
                    y: (parent.height - self.preferred-height) / 2;

                    // 高
                    Rectangle {
                        height: 28px;
                        width: ch-text.preferred-width + 16px;
                        border-radius: 5px;
                        background: root.card-height-mode == "high" ? accent : transparent;
                        border-width: root.card-height-mode == "high" ? 0px : 1px;
                        border-color: divider;

                        ch-ta := TouchArea {
                            width: parent.width;
                            height: parent.height;
                            clicked => { root.set-card-height-mode("high"); }
                        }

                        ch-text := Text {
                            text: "高";
                            font-size: 11px;
                            font-weight: root.card-height-mode == "high" ? 600 : 400;
                            color: root.card-height-mode == "high" ? #ffffff : text-2;
                            x: 8px;
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    // 中
                    Rectangle {
                        height: 28px;
                        width: cm-text.preferred-width + 16px;
                        border-radius: 5px;
                        background: root.card-height-mode == "medium" ? accent : transparent;
                        border-width: root.card-height-mode == "medium" ? 0px : 1px;
                        border-color: divider;

                        cm-ta := TouchArea {
                            width: parent.width;
                            height: parent.height;
                            clicked => { root.set-card-height-mode("medium"); }
                        }

                        cm-text := Text {
                            text: "中";
                            font-size: 11px;
                            font-weight: root.card-height-mode == "medium" ? 600 : 400;
                            color: root.card-height-mode == "medium" ? #ffffff : text-2;
                            x: 8px;
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    // 低
                    Rectangle {
                        height: 28px;
                        width: cl-text.preferred-width + 16px;
                        border-radius: 5px;
                        background: root.card-height-mode == "low" ? accent : transparent;
                        border-width: root.card-height-mode == "low" ? 0px : 1px;
                        border-color: divider;

                        cl-ta := TouchArea {
                            width: parent.width;
                            height: parent.height;
                            clicked => { root.set-card-height-mode("low"); }
                        }

                        cl-text := Text {
                            text: "低";
                            font-size: 11px;
                            font-weight: root.card-height-mode == "low" ? 600 : 400;
                            color: root.card-height-mode == "low" ? #ffffff : text-2;
                            x: 8px;
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    // 自动
                    Rectangle {
                        height: 28px;
                        width: ca-text.preferred-width + 16px;
                        border-radius: 5px;
                        background: root.card-height-mode == "auto" ? accent : transparent;
                        border-width: root.card-height-mode == "auto" ? 0px : 1px;
                        border-color: divider;

                        ca-ta := TouchArea {
                            width: parent.width;
                            height: parent.height;
                            clicked => { root.set-card-height-mode("auto"); }
                        }

                        ca-text := Text {
                            text: "自动";
                            font-size: 11px;
                            font-weight: root.card-height-mode == "auto" ? 600 : 400;
                            color: root.card-height-mode == "auto" ? #ffffff : text-2;
                            x: 8px;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }
            }
        }

        // 显示来源应用
        Rectangle {
            height: 66px;
            border-radius: 10px;
            background: surface;
            border-width: 1px;
            border-color: divider;

            HorizontalLayout {
                width: parent.width;
                height: parent.height;
                padding: 14px;
                alignment: space-between;

                VerticalLayout {
                    spacing: 2px;
                    alignment: center;

                    Text {
                        text: "显示来源应用";
                        font-size: 12px;
                        font-weight: 600;
                        color: text-1;
                    }

                    Text {
                        text: root.show-source-app ? "显示复制来源的应用图标" : "只显示内容类型图标";
                        font-size: 10px;
                        color: text-3;
                    }
                }

                Rectangle {
                    width: 40px;
                    height: 22px;
                    border-radius: 11px;
                    background: root.show-source-app ? accent : divider;
                    animate background { duration: 200ms; easing: ease-out; }
                    y: (parent.height - self.height) / 2;

                    Rectangle {
                        width: 18px;
                        height: 18px;
                        border-radius: 9px;
                        background: #ffffff;
                        x: root.show-source-app ? parent.width - self.width - 2px : 2px;
                        animate x { duration: 200ms; easing: ease-out; }
                        y: (parent.height - self.height) / 2;
                    }

                    showsource-ta := TouchArea {
                        width: parent.width;
                        height: parent.height;
                        clicked => { root.toggle-show-source-app(); }
                    }
                }
            }
        }

        // 自动回到顶部
        Rectangle {
            height: 66px;
            border-radius: 10px;
            background: surface;
            border-width: 1px;
            border-color: divider;

            HorizontalLayout {
                width: parent.width;
                height: parent.height;
                padding: 14px;
                alignment: space-between;

                VerticalLayout {
                    spacing: 2px;
                    alignment: center;

                    Text {
                        text: "自动回到顶部";
                        font-size: 12px;
                        font-weight: 600;
                        color: text-1;
                    }

                    Text {
                        text: root.auto-scroll-to-top ? "每次打开窗口回到列表顶部" : "保持上次关闭时的列表位置";
                        font-size: 10px;
                        color: text-3;
                    }
                }

                Rectangle {
                    width: 40px;
                    height: 22px;
                    border-radius: 11px;
                    background: root.auto-scroll-to-top ? accent : divider;
                    animate background { duration: 200ms; easing: ease-out; }
                    y: (parent.height - self.height) / 2;

                    Rectangle {
                        width: 18px;
                        height: 18px;
                        border-radius: 9px;
                        background: #ffffff;
                        x: root.auto-scroll-to-top ? parent.width - self.width - 2px : 2px;
                        animate x { duration: 200ms; easing: ease-out; }
                        y: (parent.height - self.height) / 2;
                    }

                    autoscroll-ta := TouchArea {
                        width: parent.width;
                        height: parent.height;
                        clicked => { root.toggle-auto-scroll-to-top(); }
                    }
                }
            }
        }

        // 复制为纯文本
        Rectangle {
            height: 66px;
            border-radius: 10px;
            background: surface;
            border-width: 1px;
            border-color: divider;

            HorizontalLayout {
                width: parent.width;
                height: parent.height;
                padding: 14px;
                alignment: space-between;

                VerticalLayout {
                    spacing: 2px;
                    alignment: center;

                    Text {
                        text: "复制为纯文本";
                        font-size: 12px;
                        font-weight: 600;
                        color: text-1;
                    }

                    Text {
                        text: root.copy-as-plain-text ? "丢弃格式，只保存纯文本内容" : "保留格式标签，粘贴时恢复样式";
                        font-size: 10px;
                        color: text-3;
                    }
                }

                Rectangle {
                    width: 40px;
                    height: 22px;
                    border-radius: 11px;
                    background: root.copy-as-plain-text ? accent : divider;
                    animate background { duration: 200ms; easing: ease-out; }
                    y: (parent.height - self.height) / 2;

                    Rectangle {
                        width: 18px;
                        height: 18px;
                        border-radius: 9px;
                        background: #ffffff;
                        x: root.copy-as-plain-text ? parent.width - self.width - 2px : 2px;
                        animate x { duration: 200ms; easing: ease-out; }
                        y: (parent.height - self.height) / 2;
                    }

                    copyplain-ta := TouchArea {
                        width: parent.width;
                        height: parent.height;
                        clicked => { root.toggle-copy-as-plain-text(); }
                    }
                }
            }
        }

        // 悬停时显示原内容
        Rectangle {
            height: 66px;
            border-radius: 10px;
            background: surface;
            border-width: 1px;
            border-color: divider;

            HorizontalLayout {
                width: parent.width;
                height: parent.height;
                padding: 14px;
                alignment: space-between;

                VerticalLayout {
                    spacing: 2px;
                    alignment: center;

                    Text {
                        text: "悬停时显示原内容";
                        font-size: 12px;
                        font-weight: 600;
                        color: text-1;
                    }

                    Text {
                        text: root.show-original-on-hover ? "鼠标悬停时显示原始内容" : "有备注的卡片始终显示备注";
                        font-size: 10px;
                        color: text-3;
                    }
                }

                Rectangle {
                    width: 40px;
                    height: 22px;
                    border-radius: 11px;
                    background: root.show-original-on-hover ? accent : divider;
                    animate background { duration: 200ms; easing: ease-out; }
                    y: (parent.height - self.height) / 2;

                    Rectangle {
                        width: 18px;
                        height: 18px;
                        border-radius: 9px;
                        background: #ffffff;
                        x: root.show-original-on-hover ? parent.width - self.width - 2px : 2px;
                        animate x { duration: 200ms; easing: ease-out; }
                        y: (parent.height - self.height) / 2;
                    }

                    showoriginal-ta := TouchArea {
                        width: parent.width;
                        height: parent.height;
                        clicked => { root.toggle-show-original-on-hover(); }
                    }
                }
            }
        }
    }
}
