export struct ClipboardEntry {
    id: int,
    preview: string,
    content-type: string,
    time-label: string,
    image-path: string,
    thumbnail: image,
    preview-length: int,
    image-width: int,
    image-height: int,
    is-favorite: bool,
    note: string,
    source-app-name: string,
    source-app-icon-path: string,
    source-app-icon-image: image,
    color-swatch: color,
    selected: bool,
    selection-order: int,
    // File type fields
    file-count: int,
    file-icon-text: string,
    file-name-1: string,
    file-name-2: string,
    file-name-3: string,
    file-overflow: int,
    file-icon-path: string,
    file-icon-image: image,
    // Link/URL preview fields
    link-domain: string,
    link-path: string,
    favicon-path: string,
    favicon-image: image,
    folder-icon-path: string,
    folder-icon-image: image,
}
