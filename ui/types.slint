export struct SyncBackendInfo {
    id: string,
    name: string,
    backend-type: string,
    status: string,           // "online" | "offline" | "error" | "syncing"
    status-message: string,
    enabled: bool,
    folder-path: string,
    last-sync-at: string,
    item-count: int,
    tag-count: int,
    service-label: string,
}

export struct ForegroundAppInfo {
    app-name: string,
    window-title: string,
    icon-base64: string,
}

export struct BlacklistEntry {
    name: string,
    icon: image,
}

export struct TagItem {
    id: int,
    name: string,
    color: color,
    checked: bool,
}

export struct ClipboardEntry {
    id: int,
    preview: string,
    content-type: string,
    time-label: string,
    image-path: string,
    thumbnail: image,
    preview-length: int,
    image-width: int,
    image-height: int,
    is-favorite: bool,
    note: string,
    source-app-name: string,
    source-app-icon-path: string,
    source-app-icon-image: image,
    color-swatch: color,
    selected: bool,
    selection-order: int,
    // File type fields
    file-count: int,
    file-icon-text: string,
    file-name-1: string,
    file-name-2: string,
    file-name-3: string,
    file-name-1-raw: string,
    file-name-2-raw: string,
    file-name-3-raw: string,
    file-ext-1: string,
    file-ext-2: string,
    file-ext-3: string,
    file-overflow: int,
    file-icon-path: string,
    file-icon-image: image,
    file-icon-path-2: string,
    file-icon-image-2: image,
    file-icon-path-3: string,
    file-icon-image-3: image,
    // Link/URL preview fields
    link-domain: string,
    link-path: string,
    favicon-path: string,
    favicon-image: image,
    folder-icon-path: string,
    folder-icon-image: image,
    // Tag fields
    has-tags: bool,
    tag-dot-0: color,
    tag-dot-1: color,
    tag-dot-2: color,
    tag-name-0: string,
    tag-name-1: string,
    tag-name-2: string,
    tags-overflow: int,
    // Size/length label (file size for file type, char count for text type)
    size-label: string,
}
