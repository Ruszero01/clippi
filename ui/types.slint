export struct ClipboardEntry {
    id: int,
    preview: string,
    content-type: string,
    time-label: string,
    image-path: string,
    thumbnail: image,
    preview-length: int,
    image-width: int,
    image-height: int,
    is-favorite: bool,
    source-app-name: string,
    source-app-icon-path: string,
    source-app-icon-image: image,
}
