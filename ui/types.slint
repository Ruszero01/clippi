export struct ClipboardEntry {
    id: int,
    preview: string,
    content-type: string,
    time-label: string,
    image-path: string,
    thumbnail: image,
    preview-length: int,
    image-width: int,
    image-height: int,
    is-favorite: bool,
    note: string,
    source-app-name: string,
    source-app-icon-path: string,
    source-app-icon-image: image,
    color-swatch: color,
    selected: bool,
    selection-order: int,
}
