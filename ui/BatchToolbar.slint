export component BatchToolbar inherits Rectangle {
    // 定位
    in property <length> bar-x: 0px;
    in property <length> bar-y: 0px;
    in property <length> container-width: 0px;
    in property <length> container-height: 0px;
    // 主题
    in property <bool> dark-mode: false;
    // 选中计数
    in property <int> selected-count: 0;

    // 回调
    callback batch-paste();
    callback batch-favorite();
    callback batch-delete();

    // 主题色板
    property <color> accent:     dark-mode ? #7ecba3 : #6ab890;
    property <color> text-1:     dark-mode ? #eaebec : #1a1c2e;
    property <color> text-2:     dark-mode ? #919496 : #7c809a;
    property <color> danger:     #ff5f57;
    property <color> btn-hover:  dark-mode ? #2b2c2d : #f0f1f8;
    property <color> surface:    dark-mode ? #2c2d2e : #ffffff;

    width: 200px;
    height: tb-content.preferred-height;
    x: clamp(bar-x - self.width / 2, 4px, container-width - self.width - 4px);
    y: clamp(bar-y - self.height - 8px, 4px, container-height - self.height - 4px);
    border-radius: 8px;
    background: surface;
    opacity: 0.95;
    border-width: 1px;
    border-color: dark-mode ? #ffffff14 : #00000012;
    drop-shadow-blur: 12px;
    drop-shadow-color: #00000040;
    drop-shadow-offset-y: 2px;

    tb-content := HorizontalLayout {
        padding: 4px;
        spacing: 2px;
        alignment: center;

        // 计数标签
        Rectangle {
            width: count-text.preferred-width;
            height: 30px;

            count-text := Text {
                text: "已选中 " + selected-count + " 项";
                font-size: 11px;
                color: text-2;
                vertical-alignment: center;
            }
        }

        // 分隔点
        Rectangle {
            width: 4px;
        }

        // 批量粘贴
        Rectangle {
            width: 30px;
            height: 30px;
            border-radius: 5px;
            background: paste-ta.has-hover ? btn-hover : transparent;

            paste-ta := TouchArea {
                width: 100%;
                height: 100%;
                clicked => { batch-paste(); }
            }

            Text {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                text: "\u{e600}";
                font-family: "iconfont";
                font-size: 14px;
                color: paste-ta.has-hover ? accent : text-2;
            }
        }

        // 批量收藏
        Rectangle {
            width: 30px;
            height: 30px;
            border-radius: 5px;
            background: fav-ta.has-hover ? btn-hover : transparent;

            fav-ta := TouchArea {
                width: 100%;
                height: 100%;
                clicked => { batch-favorite(); }
            }

            Text {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                text: "\u{e630}";
                font-family: "iconfont";
                font-size: 13px;
                color: fav-ta.has-hover ? accent : text-2;
            }
        }

        // 批量删除
        Rectangle {
            width: 30px;
            height: 30px;
            border-radius: 5px;
            background: del-ta.has-hover ? btn-hover : transparent;

            del-ta := TouchArea {
                width: 100%;
                height: 100%;
                clicked => { batch-delete(); }
            }

            Text {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                text: "\u{e8b6}";
                font-family: "iconfont";
                font-size: 14px;
                color: del-ta.has-hover ? danger : text-2;
            }
        }
    }
}
