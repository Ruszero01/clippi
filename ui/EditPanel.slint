export component EditPanel inherits Rectangle {
    // ========== 输入属性 ==========
    in property <bool> dark-mode: false;
    in property <string> editing-content: "";
    in property <string> content-type: "";
    in property <int> editing-item-id: -1;

    // ========== 内部状态 ==========
    in-out property <string> editor-text: "";
    in-out property <string> selected-type: "plain_text";
    in-out property <bool> type-menu-open: false;
    property <bool> type-manually-set: false;

    // 当外部传入新内容时，同步到编辑器并设置初始类型
    changed editing-content => {
        root.editor-text = root.editing-content;
    }
    changed editing-item-id => {
        root.type-manually-set = false;
    }
    // 仅在用户未手动选择时，根据自动检测结果设置初始类型
    changed content-type => {
        if root.type-manually-set {
            return;
        }
        // rich_text 暂不支持手动编辑，归为 plain_text
        if root.content-type == "rich_text" {
            root.selected-type = "plain_text";
            return;
        }
        root.selected-type = root.content-type;
    }

    // ========== 回调 ==========
    callback cancel();
    callback save-content(int, string, string);

    // ========== 主题色板 ==========
    property <color> text-1:   dark-mode ? #eaebec : #1a1c2e;
    property <color> text-2:   dark-mode ? #919496 : #7c809a;
    property <color> accent:   dark-mode ? #7ecba3 : #6ab890;
    property <color> surface:  dark-mode ? #232425 : #ffffff;
    property <color> divider:  dark-mode ? #2b2c2d : #e6e8f0;

    background: transparent;

    VerticalLayout {
        padding: 8px;
        spacing: 8px;

        // ========== 顶部导航栏 ==========
        HorizontalLayout {
            height: 36px;
            spacing: 8px;
            alignment: start;

            Rectangle {
                width: 28px;
                height: 28px;
                y: (parent.height - self.height) / 2;

                back-ta := TouchArea {
                    width: parent.width;
                    height: parent.height;
                    clicked => { root.cancel(); }
                }

                Text {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    text: "\u{e62b}";
                    font-family: "iconfont";
                    font-size: 16px;
                    color: back-ta.has-hover ? accent : text-2;
                }
            }

            Text {
                text: @tr("Edit");
                font-size: 14px;
                font-weight: 700;
                color: text-1;
                vertical-alignment: center;
            }
        }

        // ========== 类型选择下拉 ==========
        HorizontalLayout {
            height: 24px;

            type-btn := Rectangle {
                height: 22px;
                width: type-text.preferred-width + 14px;
                border-radius: 4px;
                border-width: 1px;
                border-color: type-ta.has-hover ? accent : divider;
                background: type-ta.has-hover ? (dark-mode ? #2a2b2c : #f0f1f5) : surface;

                type-ta := TouchArea {
                    width: parent.width;
                    height: parent.height;
                    clicked => { root.type-menu-open = !root.type-menu-open; }
                }

                type-text := Text {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    text: root.selected-type == "link" ? @tr("URL") :
                          root.selected-type == "path" ? @tr("Path") :
                          root.selected-type == "color" ? @tr("Color") : @tr("Text");
                    font-size: 10px;
                    color: accent;
                    horizontal-alignment: center;
                }
            }
        }

        // ========== 编辑区域 ==========
        Rectangle {
            border-radius: 8px;
            background: surface;
            border-width: 1px;
            border-color: divider;

            edit-area := TextInput {
                x: 8px;
                y: 8px;
                width: parent.width - 16px;
                height: parent.height - 16px;
                text <=> root.editor-text;
                font-size: 12px;
                color: text-1;
                single-line: false;
            }
        }

        // ========== 底部按钮 ==========
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            height: 32px;

            // 取消按钮
            Rectangle {
                width: 60px;
                height: 28px;
                border-radius: 6px;
                background: cancel-ta.has-hover ? divider : transparent;
                border-width: 1px;
                border-color: divider;

                cancel-ta := TouchArea {
                    width: parent.width;
                    height: parent.height;
                    clicked => { root.cancel(); }
                }

                Text {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    text: @tr("Cancel");
                    font-size: 11px;
                    color: text-2;
                    horizontal-alignment: center;
                }
            }

            // 保存按钮
            Rectangle {
                width: 60px;
                height: 28px;
                border-radius: 6px;
                background: save-ta.has-hover ? (dark-mode ? #5da87a : #5da87a) : accent;

                save-ta := TouchArea {
                    width: parent.width;
                    height: parent.height;
                    clicked => {
                        root.save-content(root.editing-item-id, root.editor-text, root.selected-type);
                    }
                }

                Text {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    text: @tr("Save");
                    font-size: 11px;
                    font-weight: 600;
                    color: #ffffff;
                    horizontal-alignment: center;
                }
            }
        }
    }

    // ========== 类型下拉菜单（覆盖层） ==========
    if root.type-menu-open : Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: transparent;

        // 点击外部关闭
        backdrop-ta := TouchArea {
            width: 100%;
            height: 100%;
            clicked => { root.type-menu-open = false; }
        }

        Rectangle {
            x: 8px;
            y: 80px;
            width: 90px;
            height: 118px;
            border-radius: 6px;
            background: surface;
            border-width: 1px;
            border-color: divider;
            drop-shadow-blur: 8px;
            drop-shadow-color: #00000030;
            drop-shadow-offset-y: 2px;

            VerticalLayout {
                padding: 4px;
                spacing: 2px;

                for opt[idx] in [@tr("Text"), @tr("URL"), @tr("Path"), @tr("Color")]: Rectangle {
                    height: 26px;
                    border-radius: 4px;
                    background: item-ta.has-hover ? divider : transparent;

                    item-ta := TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => {
                            if idx == 0 { root.selected-type = "plain_text"; }
                            else if idx == 1 { root.selected-type = "link"; }
                            else if idx == 2 { root.selected-type = "path"; }
                            else { root.selected-type = "color"; }
                            root.type-manually-set = true;
                            root.type-menu-open = false;
                        }
                    }

                    Text {
                        x: 8px;
                        y: (parent.height - self.height) / 2;
                        text: opt;
                        font-size: 11px;
                        color: root.selected-type == "plain_text" && idx == 0 ? accent :
                               root.selected-type == "link" && idx == 1 ? accent :
                               root.selected-type == "path" && idx == 2 ? accent :
                               root.selected-type == "color" && idx == 3 ? accent : text-1;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
